{
    "name": "condominio360-v2",
    "version": "2.0.0",
    "description": "Monolito Modular SaaS para gestión de condominios",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "dev": "nodemon src/app.js",
        "init-db": "node src/utils/init-db.js",
        "migrate": "node scripts/migrate.js",
        "migrate:status": "node scripts/migrate.js status",
        "migrate:rollback": "node scripts/migrate.js rollback",
        "seed": "node scripts/seed.js",
        "reset-db": "node scripts/reset_db.js",
        "verify": "node scripts/verify-system.js",
        "cleanup-db": "node scripts/cleanup-database.js",
        "delete-orphan-owners": "node scripts/delete-orphan-owners.js",
        "send-test-email": "node scripts/send-test-email.js",
        "requeue-communique-batches": "node scripts/requeue-communique-batches.js",
        "build:css": "tailwindcss -i ./src/public/css/styles.css -o ./src/public/css/output.css --watch"
    },
    "keywords": [
        "condominio",
        "saas",
        "multitenant"
    ],
    "author": "Condominio360 Team",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.6.7",
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "cron": "^4.4.0",
        "dotenv": "^16.4.1",
        "ejs": "^3.1.9",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "express-ejs-layouts": "^2.5.1",
        "form-data": "^4.0.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mailgun.js": "^12.7.1",
        "mammoth": "^1.12.0",
        "morgan": "^1.10.0",
        "mssql": "^10.0.2",
        "multer": "^2.1.1",
        "node-cron": "^3.0.3",
        "uuid": "^13.0.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "nodemon": "^3.0.3",
        "tailwindcss": "^3.4.1"
    }
}
