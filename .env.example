# Server Configuration
PORT=3000
NODE_ENV=development

# Detrás de Nginx Proxy Manager / reverse proxy (SSL en el proxy). req.ip y logs HTTP usan X-Forwarded-For.
# true = confiar en la cadena de proxies; 1 = un solo salto (por defecto si no defines nada).
# TRUST_PROXY=true
# Formato de línea de morgan (opcional). Por defecto incluye :remote-addr al inicio.
# MORGAN_FORMAT=:remote-addr :method :url :status :response-time ms - :res[content-length]

# Base URL (FQDN) - Para assets, correos y enlaces de confirmación
# QA: https://qa.condominio-360.com | Producción: https://condominio-360.com
APP_URL=https://qa.condominio-360.com
# Opcional: URLs extra (separadas por coma) para la página /privacy (p. ej. Mailgun). Si no se define, solo se usa APP_URL.
# PUBLIC_PRIVACY_URLS=https://condominio-360.com, https://qa.condominio-360.com

# Database Configuration (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASS=YourStrongPassword123
DB_NAME=Condominio360
DB_ENCRYPT=false # Set to true for Azure/Production

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Google reCAPTCHA v3 (para login) - si no se configuran, se omite verificación
RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
# RECAPTCHA_MIN_SCORE=0.5  # Opcional, por defecto 0.5

# Email — Mailgun API (sin SMTP). Un solo dominio de envío para toda la app (sin subdominios por tenant).
# MAILGUN_DEFAULT_DOMAIN: dominio verificado en Mailgun para la API (messages.create).
# Remitente: MAILGUN_FROM_LOCAL @ MAILGUN_FROM_DOMAIN (por defecto noreply@condominio-360.com).
# Si en Mailgun el envío está bajo mg.condominio-360.com pero el From debe ser @condominio-360.com, define ambos.
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_BASE_DOMAIN=condominio-360.com
MAILGUN_DEFAULT_DOMAIN=condominio-360.com
# MAILGUN_FROM_DOMAIN=condominio-360.com
MAILGUN_FROM_LOCAL=noreply
# us | eu — API de Mailgun
MAILGUN_REGION=us
# Opcional: Reply-To global
# MAILGUN_REPLY_TO=soporte@condominio-360.com
# Firma HMAC de webhooks: clave "HTTP webhook signing key" del dominio en Mailgun (no es la API key privada).
MAILGUN_WEBHOOK_SIGNING_KEY=
# Retención de filas en email_logs (días); purga diaria
EMAIL_LOG_RETENTION_DAYS=30
# Cola bulk + reintentos
EMAIL_BATCH_SIZE=100
MAX_CONCURRENT_JOBS=50
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_DELAY_MS=2000
# Worker: cada N minutos procesa pendientes bulk
EMAIL_BULK_WORKER_CRON_MINUTES=1
# Carga masiva CSV — bienvenidas: tamaño de lote y pausa entre lotes (ms)
BULK_WELCOME_EMAIL_CHUNK=30
BULK_WELCOME_EMAIL_CHUNK_DELAY_MS=30000

# Comunicados (subida DOCX/PDF). PDFs grandes (p. ej. exportados de PPTX); si usas Nginx, sube también client_max_body_size.
COMMUNIQUE_MAX_UPLOAD_MB=50

# WhatsApp — OpenWA (gateway self-hosted, una instancia / N sesiones por condominio)
# URL base del API OpenWA (sin barra final). Ej: http://10.200.1.174:2785/api
OPENWA_BASE_URL=
OPENWA_API_KEY=
# Opcional. El dashboard OpenWA (URL + eventos) NO incluye secret ni firma HMAC.
# Déjalo vacío en producción salvo que tu build de OpenWA envíe X-OpenWA-Signature.
# OPENWA_WEBHOOK_SECRET=
# Webhook URL en OpenWA: {APP_URL}/api/webhooks/openwa  (método POST; GET solo verifica que existe)
# Límite body webhook (QR/imágenes base64 en session.qr o message.received). Por defecto 10mb.
# OPENWA_WEBHOOK_BODY_LIMIT=10mb
# URL pública de la app (APP_URL) — webhooks y enlaces a propietarios.
# APP_URL debe ser la URL pública (https://condominio-360.com). OpenWA descarga adjuntos desde:
# {APP_URL}/uploads/in-app-notifications/...
# Override opcional si usa otra URL alcanzable por OpenWA:
# OPENWA_MEDIA_BASE_URL=https://condominio-360.com
# Multimedia WhatsApp: URL pública por defecto (OpenWA descarga desde APP_URL).
# Base64 desactivado salvo OPENWA_MEDIA_USE_BASE64=true (fallback si URL falla con 400/413).
# OPENWA_MEDIA_USE_BASE64=false
# OPENWA_MEDIA_BASE64_MAX_BYTES=75000
# OPENWA_MEDIA_MAX_URL_BYTES=1500000
# Lista negra: tras N fallos HTTP 500 consecutivos al mismo chatId, no reintentar (protección anti-ban).
# WHATSAPP_BLACKLIST_FAILURE_THRESHOLD=3
# Eventos sugeridos: message.sent, message.ack, session.connected, session.disconnected, session.qr

# Tasas BCV: el backend consulta https://ve.dolarapi.com (oficial, sin API key). No requiere variables de entorno.
