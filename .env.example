# Server Configuration
PORT=3000
NODE_ENV=development

# Base URL (FQDN) - Para assets, correos y enlaces de confirmación
# QA: https://qa.condominio-360.com | Producción: https://condominio-360.com
APP_URL=https://qa.condominio-360.com

# Database Configuration (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASS=YourStrongPassword123
DB_NAME=Condominio360
DB_ENCRYPT=false # Set to true for Azure/Production

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Google reCAPTCHA v3 (para login) - si no se configuran, se omite verificación
RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
# RECAPTCHA_MIN_SCORE=0.5  # Opcional, por defecto 0.5

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Formato completo recomendado (no duplicar comillas en código) o solo el correo: noreply@dominio.com
SMTP_FROM=Condominio360 <noreply@condominio360.com>
# Mailgun (y similares) suelen imponer ~100 envíos/hora por dominio/cuenta; excederlo puede bloquear SMTP.
# Un solo contador por instancia del servidor: comunicados de junta, bienvenidas masivas, avisos, etc.
# en todos los condominios comparten este techo; no subas sin confirmar el plan del proveedor.
SMTP_MAX_EMAILS_PER_HOUR=100
# Carga masiva CSV — bienvenidas: tamaño de lote y pausa entre lotes (ms)
BULK_WELCOME_EMAIL_CHUNK=30
BULK_WELCOME_EMAIL_CHUNK_DELAY_MS=30000

# WhatsApp Service
# session files storage or other config

# BCV / DolarVzla — opcional: respaldo si no hay clave en BD (Super Admin → Dashboard)
# La clave recomendada se guarda en base de datos desde el panel (sin reiniciar servidor).
# Los tokens suelen caducar ~48h; renueva en https://www.dolarvzla.com
# BCV_API_KEY=
