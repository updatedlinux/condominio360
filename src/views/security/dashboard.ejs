        async function startNFCScan() {
            if (!nfcPendingType) {
                showToast('Seleccione Ingreso o Salida primero', 'error');
                return;
            }
            if (!('NDEFReader' in window)) {
                document.getElementById('nfc-status-text').textContent = 'Web NFC no disponible. Use un Android con Chrome y NFC, o el UID manual.';
                showToast('Use Chrome en Android con NFC o ingrese el UID manualmente.', 'error');
                return;
            }
            try {
                nfcAbortController = new AbortController();
                document.getElementById('nfc-status-text').textContent = 'Escaneando... Acercar tarjeta NFC';
                const ndef = new NDEFReader();
                await ndef.scan({ signal: nfcAbortController.signal });
                ndef.addEventListener('reading', async (event) => {
                    const rawUid = event.serialNumber || readUidFromMessage(event.message);
                    if (rawUid) {
                        const uid = typeof rawUid === 'string' ? rawUid.replace(/[^A-Fa-f0-9]/g, '').toUpperCase() : String(rawUid).toUpperCase();
                        if (uid.length > 0) {
                            document.getElementById('nfc-status-text').textContent = 'Tarjeta detectada: ' + uid;
                            if (nfcAbortController) nfcAbortController.abort();
                            await submitNFCWithUid(uid);
                        }
                    }
                });
                ndef.addEventListener('readingerror', () => {
                    document.getElementById('nfc-status-text').textContent = 'Error de lectura. Intente de nuevo.';
                });
            } catch (err) {
                if (err.name === 'NotAllowedError') {
                    document.getElementById('nfc-status-text').textContent = 'Permiso denegado. Use UID manual.';
                } else {
                    document.getElementById('nfc-status-text').textContent = err.message || 'Error. Use UID manual.';
                }
                console.error('NFC scan error:', err);
            }
        }

        function readUidFromMessage(message) {
            try {
                for (const record of message.records) {
                    if (record.data) {
                        const decoder = new TextDecoder();
                        return decoder.decode(record.data);
                    }
                }
            } catch (e) {}
            return null;
        }

        function submitManualNfcUid() {
            const raw = (document.getElementById('nfc-manual-uid-input')?.value || '').trim();
            const uid = raw.replace(/[^A-Fa-f0-9]/g, '').toUpperCase();
            if (!nfcPendingType) {
                showToast('Seleccione Ingreso o Salida primero', 'error');
                return;
            }
            if (uid.length < 4) {
                showToast('Ingrese un UID hexadecimal válido (p. ej. el impreso en la tarjeta)', 'error');
                return;
            }
            submitNFCWithUid(uid);
        }

        async function submitNFCWithUid(uid) {
            const accessType = nfcPendingType === 'ENTRY' ? 'ingreso' : 'salida';
            try {
                document.getElementById('nfc-status-text').textContent = 'Registrando...';
                const res = await fetchWithAuth('/api/security/nfc/log', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ card_uid: uid, access_type: accessType })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message + ': ' + (data.data?.owner_name || uid));
                    closeNFCVehicleModal();
                    nfcCurrentPage = 1;
                    loadTabData('nfc');
                } else {
                    showToast(data.error || 'Error al registrar', 'error');
                    document.getElementById('nfc-status-text').textContent = data.error || 'Error';
                }
            } catch (err) {
                console.error(err);
                showToast('Error de conexión', 'error');
                document.getElementById('nfc-status-text').textContent = 'Error';
            }
        }

