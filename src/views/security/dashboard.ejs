        // Search functionality
        function handleSearch(event) {
            if (event.key === 'Enter') {
                performSearch();
            }
        }

        async function performSearch() {
            const query = document.getElementById('searchInput').value.trim();
            if (query.length < 2) {
                showToast('Ingrese al menos 2 caracteres', 'error');
                return;
            }

            try {
                // Buscar en todas las categorías incluyendo visitas frecuentes
                const [visitsUnique, visitsFrequent, deliveries, moves] = await Promise.all([
                    fetchWithAuth(`/api/security/visits/search?q=${encodeURIComponent(query)}&type=unique`).then(r => r.json()),
                    fetchWithAuth(`/api/security/visits/search?q=${encodeURIComponent(query)}&type=frequent`).then(r => r.json()),
                    fetchWithAuth(`/api/security/deliveries/search?q=${encodeURIComponent(query)}`).then(r => r.json()),
                    fetchWithAuth(`/api/security/moves/search?q=${encodeURIComponent(query)}`).then(r => r.json())
                ]);

                const results = [
                    ...(visitsUnique.data || []).map(v => ({ ...v, type: 'visit-unique' })),
                    ...(visitsFrequent.data || []).map(v => ({ ...v, type: 'visit-frequent' })),
                    ...(deliveries.data || []).map(d => ({ ...d, type: 'delivery' })),
                    ...(moves.data || []).map(m => ({ ...m, type: 'move' }))
                ];

                displaySearchResults(results, query);
            } catch (error) {
                console.error('Search error:', error);
                showToast('Error al buscar', 'error');
            }
        }

        function displaySearchResults(results, query) {
            const container = document.getElementById('searchResults');
            const content = document.getElementById('searchResultsContent');
            
            container.classList.remove('hidden');
            
            if (results.length === 0) {
                content.innerHTML = `
                    <div class="text-center py-8">
                        <span class="material-icons-round text-4xl text-[#E5E5E5] mb-2">search_off</span>
                        <p class="text-[#5F6368]">No se encontraron resultados para "${query}"</p>
                    </div>
                `;
                return;
            }

            lastSearchResults = {};
            results.forEach((r, index) => {
                lastSearchResults[`item_${index}`] = r;
            });

            content.innerHTML = results.map((r, index) => {
                const isVisit = r.type.includes('visit');
                const isFrequent = r.type === 'visit-frequent';
                const isDelivery = r.type === 'delivery';
                const isMove = r.type === 'move';
                
                const data = r.data || {};
                const moveDate = data.move_date || data.fecha_mudanza;
                const timeSlot = data.time_slot || data.hora;
                const isInside = isVisit 
                    ? ((r.entry_time && !r.exit_time) || !!r.current_entry) 
                    : (isDelivery && r.status === 'ARRIVED');
                
                return `
                    <div class="card p-4 border-l-4 ${isVisit ? isInside ? 'border-green-500' : isFrequent ? 'border-amber-500' : 'border-blue-500' : isDelivery ? 'border-purple-500' : r.status === 'APPROVED' ? 'border-green-500' : 'border-red-500'}">
                        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="material-icons-round text-[#5F6368]">
                                        ${isVisit ? isInside ? 'sensors' : isFrequent ? 'star' : 'person' : isDelivery ? 'local_shipping' : 'moving'}
                                    </span>
                                    <h4 class="font-medium text-[#3C4043]">
                                        ${isVisit ? (r.first_name || r.visitor_name) + ' ' + (r.last_name || '') : isDelivery ? r.name : (r.request_type_name || 'Mudanza')}
                                    </h4>
                                    ${isFrequent ? '<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">Frecuente</span>' : ''}
                                    ${isInside ? '<span class="px-1.5 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Dentro</span>' : ''}
                                </div>
                                <p class="text-sm text-[#5F6368] mt-1">
                                    ${isVisit ? `DNI: ${r.dni || r.visitor_dni}` : isDelivery ? `Empresa: ${r.company}` : `Propietario: ${r.owner_name}`}
                                </p>
                                <p class="text-sm text-[#5F6368]">
                                    ${isMove ? `Unidad: ${r.property_name}${moveDate ? ' • Fecha: ' + formatDate(moveDate) : ''}` : `Unidad: ${r.property_name} • Prop: ${r.owner_name}`}
                                </p>
                            </div>
                            <div class="text-right">
                                <span class="px-2 py-1 rounded text-xs font-medium ${isVisit ? isInside ? 'bg-green-100 text-green-800' : isFrequent ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800' : isDelivery ? 'bg-purple-100 text-purple-800' : r.status === 'APPROVED' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                    ${isVisit ? isFrequent ? 'Visita Frecuente' : 'Visita' : isDelivery ? 'Delivery' : r.status === 'APPROVED' ? 'Mudanza Aprobada' : 'Rechazada'}
                                </span>
                                ${isVisit && isFrequent && !isInside ? `
                                    <button onclick="openEntryModal('${r.id}', 'frequent', '${r.first_name || r.visitor_name} ${r.last_name || ''}', true)" 
                                        class="touch-target block mt-2 text-sm text-green-700 hover:underline font-medium py-2">
                                        Registrar Entrada
                                    </button>
                                ` : ''}
                                ${isVisit && !isFrequent && !isInside && !r.exit_time ? `
                                    <button onclick="openEntryModal('${r.id}', 'unique', '${r.first_name || r.visitor_name} ${r.last_name || ''}')" 
                                        class="touch-target block mt-2 text-sm text-green-700 hover:underline font-medium py-2">
                                        Registrar Entrada
                                    </button>
                                ` : ''}
                                ${isVisit && isInside ? `
                                    <button onclick="registerExit('${r.active_log_id || r.log_id || r.id}')" 
                                        class="touch-target block mt-2 text-sm text-red-700 hover:underline font-medium py-2">
                                        Registrar Salida
                                    </button>
                                ` : ''}
                                ${isDelivery && !isInside ? `
                                    <button onclick="registerDeliveryArrival('${r.id}')" 
                                        class="touch-target block mt-2 text-sm text-purple-700 hover:underline font-medium py-2">
                                        Registrar Llegada
                                    </button>
                                ` : ''}
                                ${isDelivery && isInside ? `
                                    <button onclick="registerDeliveryDelivered('${r.id}')" 
                                        class="touch-target block mt-2 text-sm text-red-700 hover:underline font-medium py-2">
                                        Registrar Entrega
                                    </button>
                                ` : ''}
                                ${isMove ? `
                                    <button onclick="showMoveDetailFromSearch(${index})"
                                        class="touch-target block mt-2 text-sm ${r.status === 'APPROVED' ? 'text-green-700' : 'text-red-700'} hover:underline font-medium cursor-pointer py-2">
                                        Ver detalles
                                    </button>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function showMoveDetailFromSearch(index) {
            const move = lastSearchResults[`item_${index}`];
            if (move) {
                showMoveDetails(move);
            }
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchResults').classList.add('hidden');
        }

        function showMoveDetails(move) {
            const data = move.data || {};
            const isApproved = move.status === 'APPROVED';
            
            let detailsHtml = '';
            const schema = move.form_schema || {};
            const fields = schema.fields || [];
            
            for (const field of fields) {
                const value = data[field.name];
                if (value !== undefined && value !== null && value !== '') {
                    const icon = getFieldIcon(field.type, field.name);
                    let displayValue = value;
                    if (field.type === 'date' && value) displayValue = formatDate(value);
                    else if (field.type === 'checkbox') displayValue = value ? 'Sí' : 'No';
                    
                    detailsHtml += `
                        <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                            <span class="material-icons-round text-[#f97316]">${icon}</span>
                            <div>
                                <span class="text-xs text-[#9AA0A6]">${field.label}</span>
                                <p class="font-medium text-[#3C4043]">${displayValue}</p>
                            </div>
                        </div>
                    `;
                }
            }
            
            const statusBanner = isApproved ? `
                <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 rounded-r-xl flex items-center gap-3">
                    <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                        <span class="material-icons-round text-green-600">check_circle</span>
                    </div>
                    <div>
                        <h3 class="font-medium text-green-800">Mudanza APROBADA</h3>
                        <p class="text-sm text-green-600">Autorizada por la Junta</p>
                    </div>
                </div>
            ` : `
                <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-xl flex items-center gap-3">
                    <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                        <span class="material-icons-round text-red-600">cancel</span>
                    </div>
                    <div>
                        <h3 class="font-medium text-red-800">Mudanza RECHAZADA</h3>
                        <p class="text-sm text-red-600">No autorizada</p>
                    </div>
                </div>
            `;

            const modalHtml = `
                <div id="moveDetailsModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" onclick="closeMoveModal(event)">
                    <div class="bg-white rounded-2xl max-w-lg w-full max-h-[90vh] overflow-hidden" onclick="event.stopPropagation()">
                        <div class="p-6 border-b border-[#E5E5E5] flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 ${isApproved ? 'bg-green-100' : 'bg-red-100'} rounded-xl flex items-center justify-center">
                                    <span class="material-icons-round ${isApproved ? 'text-green-600' : 'text-red-600'}">moving</span>
                                </div>
                                <div>
                                    <h2 class="text-xl font-bold text-[#3C4043]">${move.request_type_name || 'Mudanza'}</h2>
                                    <p class="text-sm text-[#5F6368]">${move.property_name}</p>
                                </div>
                            </div>
                            <button onclick="closeMoveModal()" class="p-2 hover:bg-gray-100 rounded-lg">
                                <span class="material-icons-round text-[#5F6368]">close</span>
                            </button>
                        </div>
                        <div class="p-6 overflow-y-auto max-h-[60vh]">
                            ${statusBanner}
                            <div class="mb-6 p-4 bg-blue-50 rounded-xl">
                                <h4 class="text-sm font-medium text-blue-800 mb-3">Propietario</h4>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <span class="text-xs text-[#9AA0A6]">Nombre</span>
                                        <p class="font-medium text-[#3C4043]">${move.owner_name}</p>
                                    </div>
                                    <div>
                                        <span class="text-xs text-[#9AA0A6]">DNI</span>
                                        <p class="font-medium text-[#3C4043]">${move.owner_dni || 'N/A'}</p>
                                    </div>
                                </div>
                            </div>
                            <h4 class="text-sm font-medium text-[#3C4043] mb-3">Detalles</h4>
                            <div class="space-y-2">${detailsHtml || '<p class="text-[#5F6368] text-sm">Sin detalles adicionales</p>'}</div>
                        </div>
                        <div class="p-6 border-t border-[#E5E5E5] bg-gray-50">
                            <button onclick="closeMoveModal()" class="w-full px-4 py-3 bg-gradient-to-r from-[#f97316] to-[#ea580c] text-white rounded-xl font-medium hover:shadow-lg">
                                Cerrar
                            </button>
                        </div>
                    </div>
                </div>
            `;
            
            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }

        function closeMoveModal(event) {
            const modal = document.getElementById('moveDetailsModal');
            if (!event || event.target === modal || event.target.closest('button')) {
                if (modal) modal.remove();
            }
        }

        function getFieldIcon(type, name) {
            const nameLower = name.toLowerCase();
            if (nameLower.includes('date') || nameLower.includes('fecha')) return 'event';
            if (nameLower.includes('time') || nameLower.includes('hora')) return 'schedule';
            if (nameLower.includes('plate') || nameLower.includes('placa')) return 'directions_car';
            if (nameLower.includes('company') || nameLower.includes('empresa')) return 'business';
            if (nameLower.includes('phone') || nameLower.includes('telefono')) return 'phone';
            if (nameLower.includes('elevator') || nameLower.includes('elevador')) return 'elevator';
            if (nameLower.includes('insurance') || nameLower.includes('seguro')) return 'verified';
            if (nameLower.includes('note')) return 'notes';
            if (type === 'checkbox') return 'check_box';
            return 'label';
        }

        function getTodayVenezuela() {
            return new Date().toLocaleDateString('en-CA', { timeZone: 'America/Caracas' });
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            const str = String(dateStr);
            const match = str.match(/(\d{4})-(\d{2})-(\d{2})/);
            if (match) {
                const [, y, m, d] = match;
                const months = ['ene.', 'feb.', 'mar.', 'abr.', 'may.', 'jun.', 'jul.', 'ago.', 'sep.', 'oct.', 'nov.', 'dic.'];
                return `${parseInt(d)} ${months[parseInt(m) - 1]} ${y}`;
            }
            return new Date(dateStr).toLocaleDateString('es-VE', { 
                day: '2-digit', month: 'short', year: 'numeric', timeZone: 'America/Caracas'
            });
        }

        function formatDateOnly(dateStr) {
            if (!dateStr) return '-';
            const str = String(dateStr);
            const match = str.match(/(\d{4})-(\d{2})-(\d{2})/);
            const months = ['ene.', 'feb.', 'mar.', 'abr.', 'may.', 'jun.', 'jul.', 'ago.', 'sep.', 'oct.', 'nov.', 'dic.'];
            if (match) {
                const [, y, m, day] = match;
                const isDateOnly = /^\d{4}-\d{2}-\d{2}$/.test(str.trim()) || str.includes('T00:00:00');
                if (isDateOnly) {
                    return `${parseInt(day)} ${months[parseInt(m) - 1]} ${y}`;
                }
            }
            const d = new Date(dateStr);
            if (isNaN(d.getTime())) return '-';
            return d.toLocaleDateString('es-VE', { 
                day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Caracas'
            });
        }

        function formatTime(dateStr) {
            if (!dateStr) return '-';
            return new Date(dateStr).toLocaleTimeString('es-VE', { 
                hour: '2-digit', 
                minute: '2-digit',
                timeZone: 'America/Caracas'
            });
        }
    </script>
</body>
</html>
