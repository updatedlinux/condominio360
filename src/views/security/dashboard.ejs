        async function submitManualVisit() {
            const ownerDniRaw = document.getElementById('mv-owner-dni').value.trim();
            const visitorDniRaw = document.getElementById('mv-visitor-dni').value.trim();
            const ownerDni = validateDni(ownerDniRaw, 'DNI del propietario');
            const visitorDni = validateDni(visitorDniRaw, 'DNI del visitante');
            if (ownerDni === null || visitorDni === null) return;

            const phoneRaw = document.getElementById('mv-visitor-phone').value.trim();
            const visitorPhone = phoneRaw ? phoneRaw.replace(/\D/g, '') : null;
            if (visitorPhone && visitorPhone.length > 15) {
                showToast('El teléfono debe contener solo números (máx. 15 dígitos)', 'error');
                return;
            }

            const formData = {
                owner_dni: ownerDni,
                visitor_first_name: document.getElementById('mv-visitor-firstname').value.trim(),
                visitor_last_name: document.getElementById('mv-visitor-lastname').value.trim(),
                visitor_dni: visitorDni,
                visitor_phone: visitorPhone || null,
                visit_date: document.getElementById('mv-visit-date').value,
                visit_time: document.getElementById('mv-visit-time').value,
                vehicle_plate: document.getElementById('mv-vehicle-plate').value.trim(),
                notes: document.getElementById('mv-notes').value.trim()
            };
            if (selectedOwnerVisit && selectedOwnerVisit.properties.length > 1) {
                const propId = document.getElementById('mv-property-select')?.value;
                if (!propId) {
                    showToast('Seleccione el inmueble del propietario', 'error');
                    return;
                }
                formData.property_id = propId;
            }

            if (!formData.owner_dni || !formData.visitor_first_name || !formData.visitor_last_name || 
                !formData.visitor_dni || !formData.visit_date) {
                showToast('Complete todos los campos requeridos', 'error');
                return;
            }

            try {
                const response = await fetchWithAuth('/api/security/visits/manual', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (data.success) {
                    showToast('Visita registrada exitosamente');
                    closeManualVisitModal();
                    currentDataHash = null;
                    loadTabData('visits');
                } else {
                    showToast(data.error || 'Error al registrar visita', 'error');
                }
            } catch (error) {
                showToast('Error al registrar visita', 'error');
            }
        }

        async function submitManualDelivery() {
            const ownerDniRaw = document.getElementById('md-owner-dni').value.trim();
            // Ahora puede ser DNI o búsqueda por inmueble; si no es numérico, se exige seleccionar inmueble.
            const isNumeric = /^\d+$/.test(ownerDniRaw.trim());
            const ownerDni = isNumeric ? validateDni(ownerDniRaw, 'DNI del propietario') : null;
            if (isNumeric && ownerDni === null) return;

            const formData = {
                ...(ownerDni ? { owner_dni: ownerDni } : {}),
                name: document.getElementById('md-name').value.trim(),
                company: document.getElementById('md-company').value.trim(),
                expected_date: document.getElementById('md-expected-date').value,
                notes: document.getElementById('md-notes').value.trim()
            };
            if (selectedOwnerDelivery && selectedOwnerDelivery.properties.length > 1) {
                const propId = document.getElementById('md-property-select')?.value;
                if (!propId) {
                    showToast('Seleccione el inmueble del propietario', 'error');
                    return;
                }
                formData.property_id = propId;
            }

            // Si no hay DNI, se debe seleccionar inmueble para asociar el delivery.
            if (!formData.owner_dni) {
                const propId = document.getElementById('md-property-select')?.value;
                if (!propId) {
                    showToast('Seleccione el inmueble del propietario', 'error');
                    return;
                }
                formData.property_id = propId;
            }

            if (!formData.company || !formData.expected_date) {
                showToast('Complete todos los campos requeridos', 'error');
                return;
            }

            try {
                const response = await fetchWithAuth('/api/security/deliveries/manual', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (data.success) {
                    showToast('Delivery registrado exitosamente');
                    closeManualDeliveryModal();
                    loadTabData('deliveries');
                } else {
                    showToast(data.error || 'Error al registrar delivery', 'error');
                }
            } catch (error) {
                showToast('Error al registrar delivery', 'error');
            }
        }

