        // Form submissions
        function validateDni(value, fieldName) {
            const cleaned = (value || '').trim().replace(/\D/g, '');
            if (!cleaned || cleaned.length > 15) {
                showToast(`El ${fieldName} debe contener solo números (máx. 15 dígitos)`, 'error');
                return null;
            }
            return cleaned;
        }

        function debounce(fn, waitMs) {
            let t = null;
            return function (...args) {
                if (t) clearTimeout(t);
                t = setTimeout(() => fn.apply(this, args), waitMs);
            };
        }

        function escapeHtml(t) {
            const d = document.createElement('div');
            d.textContent = t == null ? '' : String(t);
            return d.innerHTML;
        }

        function showOwnerSuggestions(containerId, records, onPick) {
            const el = document.getElementById(containerId);
            if (!el) return;
            if (!records || records.length === 0) {
                el.classList.add('hidden');
                el.innerHTML = '';
                return;
            }
            el.classList.remove('hidden');
            el.innerHTML = records.map((r) => {
