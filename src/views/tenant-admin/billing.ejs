        // Recibo extraordinario por edificio - Modal
        let extraordinaryItems = [];

        async function createExtraordinaryInvoice() {
            const modeEl = document.getElementById('extra-rate-freeze-mode');
            if (modeEl) modeEl.value = 'NONE';
            onPrelRateFreezeModeChange('extra');
            const hasRate = await loadBcvRateNotice('extra-bcv-notice');
            if (!hasRate && !(await ensureExchangeRate())) {
                showToast('No se pudo obtener la tasa de cambio BCV. Intente más tarde.', 'error');
                return;
            }

            // Llenar select de edificios
            const select = document.getElementById('extra-building');
            select.innerHTML = '<option value="">Seleccionar edificio/calle...</option>';
            
            if (window.tenantBuildings) {
                window.tenantBuildings.forEach(b => {
                    select.innerHTML += `<option value="${b.id}">${b.name}</option>`;
                });
            }
            
            // Reset form
            extraordinaryItems = [];
            renderExtraordinaryItems();
            document.getElementById('extra-name').value = '';
            document.getElementById('extra-building').value = '';
            
            showModal('extraordinary-modal');
        }

        function addExtraordinaryItemToModal() {
            extraordinaryItems.push({
                description: '',
                amount: 0,
                currency: 'USD'
            });
            renderExtraordinaryItems();
        }

        function removeExtraordinaryItem(index) {
            extraordinaryItems.splice(index, 1);
            renderExtraordinaryItems();
        }

        function renderExtraordinaryItems() {
            const container = document.getElementById('extra-items-list');
            
            if (extraordinaryItems.length === 0) {
                container.innerHTML = '<p class="text-sm text-[#9AA0A6] text-center py-4">No hay items agregados</p>';
            } else {
                container.innerHTML = extraordinaryItems.map((item, idx) => {
                    // Calcular conversión según la moneda del item
                    let convertedAmount;
                    if (item.currency === 'USD') {
                        // USD -> VES (multiplicar por tasa)
                        convertedAmount = item.amount * currentRate;
                    } else {
                        // VES -> USD (dividir por tasa)
                        convertedAmount = currentRate > 0 ? item.amount / currentRate : 0;
                    }

                    const convertedText = item.currency === 'USD' 
                        ? `= Bs. ${formatNumber(convertedAmount)}` 
                        : `= $ ${formatNumber(convertedAmount)}`;

                    return `
                        <div class="flex gap-2 items-start bg-[#FAFAFA] p-3 rounded-lg">
                            <div class="flex-1">
                                <input type="text" placeholder="Descripción" value="${item.description}" 
                                    onchange="updateExtraordinaryItem(${idx}, 'description', this.value)"
                                    class="w-full px-2 py-1 text-sm border border-[#E5E5E5] rounded mb-2">
                                <div class="flex gap-2 items-center">
                                    <input type="number" step="0.01" placeholder="Monto" value="${item.amount || ''}"
                                        onchange="updateExtraordinaryItem(${idx}, 'amount', parseFloat(this.value) || 0)"
                                        class="w-28 px-2 py-1 text-sm border border-[#E5E5E5] rounded">
                                    <select onchange="updateExtraordinaryItem(${idx}, 'currency', this.value)"
                                        class="px-2 py-1 text-sm border border-[#E5E5E5] rounded">
                                        <option value="VES" ${item.currency === 'VES' ? 'selected' : ''}>VES</option>
                                        <option value="USD" ${item.currency === 'USD' ? 'selected' : ''}>USD</option>
                                    </select>
                                    <span class="text-xs text-[#5F6368] flex-1">${convertedText} <span class="text-[#9AA0A6]">(tasa: ${currentRate})</span></span>
                                </div>
                                <div class="flex flex-wrap items-center gap-2 mt-2">
                                    <span class="text-xs text-[#5F6368] whitespace-nowrap">Factura (opcional)</span>
                                    <input type="file" accept="image/jpeg,image/png,image/gif,image/webp,application/pdf,.pdf" class="hidden" id="extra-attach-${idx}" onchange="onExtraordinaryAttachmentChange(${idx}, this)">
                                    <label for="extra-attach-${idx}" class="inline-flex items-center gap-1 px-2 py-1 text-xs border border-[#E5E5E5] rounded-lg cursor-pointer hover:bg-white text-[#f97316]">
                                        <span class="material-icons-round text-sm">attach_file</span>
                                        Adjuntar
                                    </label>
                                    <span class="text-xs text-[#9AA0A6] truncate max-w-[200px]">${item._attachmentName ? escapeHtml(item._attachmentName) : 'Sin archivo'}</span>
                                </div>
                            </div>
                            <button type="button" onclick="removeExtraordinaryItem(${idx})" class="text-red-500 hover:text-red-700">
                                <span class="material-icons-round">delete</span>
                            </button>
                        </div>
                    `;
                }).join('');
            }
            
            updateExtraordinaryTotals();
        }

        function updateExtraordinaryItem(index, field, value) {
            extraordinaryItems[index][field] = value;
            // Recalcular todo si cambia monto o moneda
            if (field === 'amount' || field === 'currency') {
                renderExtraordinaryItems();
            }
        }

        function updateExtraordinaryTotals() {
            let totalUsd = 0;
            let totalVes = 0;
            
            extraordinaryItems.forEach(item => {
                if (item.currency === 'USD') {
                    totalUsd += item.amount;
                    totalVes += item.amount * currentRate;
                } else {
                    totalVes += item.amount;
                    totalUsd += currentRate > 0 ? item.amount / currentRate : 0;
                }
            });
            
            document.getElementById('extra-total-usd').textContent = `$ ${totalUsd.toFixed(2)}`;
            document.getElementById('extra-total-ves').textContent = `Bs. ${totalVes.toFixed(2)}`;
        }

        // Submit del form de extraordinario
        document.getElementById('extraordinary-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const building = document.getElementById('extra-building').value;
            const name = document.getElementById('extra-name').value;
            const month = parseInt(document.getElementById('extra-month').value);
            const year = parseInt(document.getElementById('extra-year').value);
            
            if (!building) {
                showToast('Debe seleccionar un edificio/calle', 'error');
                return;
            }
            
            if (extraordinaryItems.length === 0) {
                showToast('Debe agregar al menos un item', 'error');
                return;
            }
            
            // Validar items
            for (const item of extraordinaryItems) {
                if (!item.description || !item.amount) {
                    showToast('Todos los items deben tener descripción y monto', 'error');
                    return;
                }
            }
            
            // Usar el billing_type del tenant (FIXED o ALICUOTA)
            const tenantBillingType = billingConfig?.billing_type || 'FIXED';

            const itemsPayload = extraordinaryItems.map(i => ({
                item_type: 'EXTRAORDINARY',
                description: i.description,
                amount: i.amount,
                amount_type: tenantBillingType,
                currency: i.currency || 'USD'
            }));

            const missingLabels = extraordinaryItems
                .map((it, i) => (!it._attachmentFile ? (it.description || `Ítem ${i + 1}`) : null))
                .filter(Boolean);

            const runCreateExtra = async () => {
                try {
                    const result = await postPreliminaryMultipart({
                        billing_month: month,
                        billing_year: year,
                        name: name,
                        items: itemsPayload,
                        ...getRateFreezeFields('extra'),
                        target_building: building,
                        is_extraordinary: true,
                        attachments: extraordinaryItems.map(i => i._attachmentFile || null)
                    });
                    if (result.success) {
                        showToast('Recibo extraordinario creado. Generando recibos para el edificio/calle...');
                        closeModal('extraordinary-modal');
                        await generateInvoicesForBuilding(result.data.id, building);
                        loadPreliminaries();
                    } else {
                        showToast(result.error || result.message || 'Error al crear recibo', 'error');
                    }
                } catch (e) {
                    console.error(e);
                    showToast('Error al crear recibo extraordinario', 'error');
                }
            };

            if (missingLabels.length > 0) {
                const ul = document.getElementById('missing-attachments-list');
                ul.innerHTML = missingLabels.map((t) => `<li>${escapeHtml(t)}</li>`).join('');
                pendingMissingAttachmentsCallback = runCreateExtra;
                showModal('missing-attachments-modal');
                return;
            }

            await runCreateExtra();
        });

        async function generateInvoicesForBuilding(preliminaryId, buildingName) {
            try {
                const res = await fetch(`/api/tenant-admin/billing/preliminaries/${preliminaryId}/generate?building=${encodeURIComponent(buildingName)}`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                const data = await res.json();
                if (data.success) {
                    showToast(`${data.data.invoices_count} recibos generados para el edificio/calle`);
                    loadPreliminaries();
                    loadStats();
                } else {
                    showToast(data.error || 'Error al generar recibos', 'error');
                }
            } catch (e) {
                showToast('Error al generar recibos', 'error');
            }
        }

