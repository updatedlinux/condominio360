                end_date: document.getElementById('contract-end').value || null
            };
            if (editId) body.status = document.getElementById('contract-status').value;
            try {
                const res = await fetch(editId ? `/api/tenant-admin/billing/contracts/${editId}` : '/api/tenant-admin/billing/contracts', {
