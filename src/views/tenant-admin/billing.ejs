        async function exportInvoicesMonth(year, month) {
            try {
                showToast('Generando Excel…', 'info');
                const url = `/api/tenant-admin/billing/invoices/export-by-month?year=${encodeURIComponent(year)}&month=${encodeURIComponent(month)}`;
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.error || 'Error al exportar', 'error');
                    return;
                }
                const blob = await res.blob();
                const cd = res.headers.get('Content-Disposition');
                let filename = `recibos-${year}-${String(month).padStart(2, '0')}.xlsx`;
                if (cd && cd.includes('filename=')) {
                    const m = cd.match(/filename="?([^";]+)"?/);
                    if (m) filename = decodeURIComponent(m[1]);
                }
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = filename;
                a.click();
                URL.revokeObjectURL(a.href);
                showToast('Excel descargado', 'success');
            } catch (e) {
                console.error(e);
                showToast('Error al descargar Excel', 'error');
            }
        }

