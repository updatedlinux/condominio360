                document.getElementById('prop-search-results').classList.add('hidden');
                return;
            }
            
            propertySearchTimeout = setTimeout(() => searchProperties(query), 300);
        });

        async function searchProperties(query) {
            try {
                const res = await fetch(`/api/tenant-admin/properties?search=${encodeURIComponent(query)}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                
                if (data.success && data.properties && data.properties.length > 0) {
                    renderPropertySearchResults(data.properties);
                } else {
                    document.getElementById('prop-search-results').innerHTML = `
                        <div class="p-3 text-sm text-[#9AA0A6] text-center">No se encontraron inmuebles</div>
