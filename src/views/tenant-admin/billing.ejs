                const months = document.getElementById('invoices-months')?.value || '5';
                let url = months ? `/api/tenant-admin/billing/invoices?months_back=${months}` : '/api/tenant-admin/billing/invoices';
                if (status) url += (url.includes('?') ? '&' : '?') + `status=${encodeURIComponent(status)}`;
                
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
