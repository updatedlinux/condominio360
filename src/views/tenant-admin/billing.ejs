        // Cargar inmuebles para calcular distribución estimada
        async function loadPropertiesForDistribution() {
            try {
                const res = await fetch('/api/tenant-admin/properties?limit=1000', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                
                if (data.success && data.properties) {
                    return data.properties;
                }
                if (data.success && data.data && data.data.properties) {
                    return data.data.properties;
                }
                return [];
            } catch (e) {
                console.error('Error loading properties:', e);
                return [];
            }
        }

        async function showPreliminaryDetail(preliminaryId) {
            try {
                const res = await fetch(`/api/tenant-admin/billing/preliminaries/${preliminaryId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                
                if (!data.success) {
                    showToast('Error al cargar detalle', 'error');
                    return;
                }
                
                const p = data.data;
                const monthName = getMonthName(p.billing_month);
                const typeBadge = getInvoiceTypeBadge(p.invoice_type);
                
                // Llenar información general
                document.getElementById('detail-title').innerHTML = `
                    ${p.name}
                    <span class="ml-2 px-2 py-0.5 ${typeBadge.class} rounded text-xs flex items-center gap-1 inline-flex">
                        <span class="material-icons-round text-xs">${typeBadge.icon}</span>
                        ${typeBadge.text}
                    </span>
                `;
                document.getElementById('detail-period').textContent = `${monthName} ${p.billing_year}`;
                const rateToday = p.rate_info?.rate_today || billingConfig?.usd_to_ves_rate;
                const totalVesDisplay = p.rate_info?.total_ves_from_invoices != null ? p.rate_info.total_ves_from_invoices : (p.recalculated?.total_ves ?? (rateToday ? p.total_amount_usd * rateToday : p.total_amount_ves));
                const showCurrentRateArrow = !p.rate_info?.all_invoices_paid && rateToday && Number(p.exchange_rate_usd) !== Number(rateToday);
                document.getElementById('detail-rate').innerHTML = `${p.exchange_rate_usd} VES/USD${showCurrentRateArrow ? ` <span class="text-amber-600">→ ${rateToday} (actual)</span>` : ''}`;
                document.getElementById('detail-total-usd').textContent = formatCurrency(p.total_amount_usd, 'USD');
                document.getElementById('detail-total-ves').textContent = formatCurrency(totalVesDisplay, 'VES');
                
                // Items (cuando todos pagaron: usar tasa preliminar; cuando hay pendientes: tasa actual)
                const itemsContainer = document.getElementById('detail-items');
                const useFrozenRate = p.rate_info?.all_invoices_paid;
                const itemsRate = useFrozenRate ? p.exchange_rate_usd : (p.rate_info?.rate_today || p.exchange_rate_usd);
                const displayItems = (p.recalculated?.items || p.items || []).map(it => {
                    const base = parseFloat(it.base_amount) || 0;
                    const convVes = it.currency === 'USD' ? base * itemsRate : base;
                    return { ...it, converted_amount_ves: convVes };
                });
                if (displayItems.length > 0) {
                    itemsContainer.innerHTML = displayItems.map(item => {
                        let originalText, convertedText;
                        if (item.currency === 'USD') {
                            originalText = formatCurrency(item.base_amount, 'USD');
                            convertedText = formatCurrency(item.converted_amount_ves, 'VES');
                        } else {
                            originalText = formatCurrency(item.base_amount, 'VES');
                            const rate = itemsRate;
                            const usdAmount = rate > 0 ? item.base_amount / rate : 0;
                            convertedText = formatCurrency(usdAmount, 'USD');
                        }
                        return `
                        <div class="flex justify-between p-2 bg-[#FAFAFA] rounded text-sm">
                            <span class="text-[#3C4043]">${item.description}</span>
                            <span class="font-medium text-[#5F6368]">
                                ${originalText}
                                <span class="text-xs text-[#9AA0A6]">(= ${convertedText})</span>
                            </span>
                        </div>
                    `}).join('');
                } else {
                    itemsContainer.innerHTML = '<p class="text-sm text-[#9AA0A6]">No hay items</p>';
                }
                
                // Información de tasas y spread (solo para recibos pendientes; si todos pagaron, importes congelados)
                const rateInfoEl = document.getElementById('detail-rate-info');
                if (rateInfoEl && p.rate_info) {
                    const ri = p.rate_info;
                    const fmt = (v) => v != null ? formatCurrency(v, 'VES') : '-';
                    let rateInfoHtml;
                    if (ri.all_invoices_paid) {
                        rateInfoHtml = `
                            <div class="border-t border-[#E5E5E5] pt-3 mt-3 text-sm">
                                <div class="flex items-center gap-2 py-2 px-3 bg-green-50 rounded-lg">
                                    <span class="material-icons-round text-green-600 text-lg">check_circle</span>
                                    <span class="text-green-800 font-medium">Todos los cobros han sido pagados. Importes en VES congelados (sin variación por tasa).</span>
                                </div>
                            </div>
                        `;
                    } else {
                        rateInfoHtml = `
                            <div class="border-t border-[#E5E5E5] pt-3 mt-3 space-y-1 text-sm">
                                ${ri.freeze_label ? `<p class="text-xs text-indigo-800 bg-indigo-50 border border-indigo-100 rounded px-2 py-1 mb-2">${escapeHtml(ri.freeze_label)}</p>` : ''}
                                <div class="flex justify-between"><span class="text-[#5F6368]">Tasa preliminar${ri.rate_preliminary_date ? ` (${ri.rate_preliminary_date})` : ''}</span><span>${Number(ri.rate_preliminary).toLocaleString('es-VE')} VES/USD · ${fmt(ri.contravalue_preliminary_ves)}</span></div>
                                ${ri.show_rate_differential && ri.rate_today ? `<div class="flex justify-between"><span class="text-[#5F6368]">Tasa del día${ri.rate_today_date ? ` (${ri.rate_today_date})` : ''} <span class="text-amber-600">(referencia)</span></span><span>${Number(ri.rate_today).toLocaleString('es-VE')} VES/USD · ${fmt(ri.contravalue_today_ves)}</span></div>` : ''}
                                ${ri.show_rate_differential && ri.spread_pct != null && ri.spread_pct !== 0 ? `
                                <div class="flex justify-between mt-2 py-2 rounded px-2 ${ri.spread_pct > 0 ? 'bg-amber-50' : 'bg-green-50'}">
                                    <span>Diferencial cambiario (recibos pendientes)</span>
                                    <span class="font-semibold ${ri.spread_pct > 0 ? 'text-amber-700' : 'text-green-700'}">${ri.spread_pct > 0 ? '+' : ''}${Number(ri.spread_pct).toFixed(2)}% ${ri.spread_pct > 0 ? '(pérdida)' : '(ganancia)'}</span>
                                </div>` : ''}
                            </div>
                        `;
                    }
                    rateInfoEl.innerHTML = rateInfoHtml;
                    rateInfoEl.classList.remove('hidden');
                } else if (rateInfoEl) {
                    rateInfoEl.classList.add('hidden');
                }
                
                // Distribución por inmueble
                const distributionSection = document.getElementById('detail-distribution-section');
                const distributionContainer = document.getElementById('detail-distribution');
                const distributionType = document.getElementById('detail-distribution-type');
                
                if (p.status === 'FINALIZED') {
                    if (p.invoices && p.invoices.length > 0) {
                        // Mostrar recibos reales generados
                        distributionSection.classList.remove('hidden');
                        distributionType.textContent = `Distribución: ${p.invoices[0].proportion_type === 'ALICUOTA' ? 'Por Alícuota' : 'Partes Iguales'}`;
                        
                        distributionContainer.innerHTML = p.invoices.map(inv => {
                            const isPaid = inv.status === 'PAID';
                            const statusBadge = isPaid ? '<span class="ml-1 px-2 py-0.5 rounded text-xs bg-green-100 text-green-700">Pagado</span>' : '<span class="ml-1 px-2 py-0.5 rounded text-xs bg-amber-100 text-amber-700">Pendiente</span>';
                            const amountNote = isPaid ? ' <span class="text-xs text-green-600">(congelado)</span>' : '';
                            return `
                            <div class="flex justify-between items-center p-3 bg-[#FAFAFA] rounded-lg">
                                <div>
                                    <p class="font-medium text-[#3C4043] text-sm">${inv.property_name} ${statusBadge}</p>
                                    <p class="text-xs text-[#5F6368]">${inv.building || ''} • ${(inv.proportion_value * 100).toFixed(2)}%</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-medium text-[#3C4043] text-sm">${formatCurrency(inv.assigned_amount_ves, 'VES')}${amountNote}</p>
                                    <p class="text-xs text-[#9AA0A6]">${formatCurrency(inv.assigned_amount_usd, 'USD')}</p>
                                </div>
                            </div>
                        `;
                        }).join('');
                    } else {
                        // FINALIZED pero sin recibos (caso antiguo/problemático)
                        distributionSection.classList.remove('hidden');
                        distributionType.textContent = 'No hay recibos generados';
                        distributionContainer.innerHTML = `
                            <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-center">
                                <p class="text-sm text-[#5F6368]">Este preliminar está finalizado pero no tiene recibos asociados.</p>
                                <p class="text-xs text-[#9AA0A6] mt-1">Puede deberse a un error en la generación.</p>
                            </div>
                        `;
                    }
                } else if (p.status === 'DRAFT') {
                    // Mostrar distribución estimada calculada
                    distributionSection.classList.remove('hidden');
                    distributionType.textContent = `Distribución estimada (${billingConfig?.billing_type === 'ALICUOTA' ? 'Por Alícuota' : 'Partes Iguales'})`;
                    
                    // Calcular y mostrar distribución
                    const totalAmountUsd = p.total_amount_usd;
                    const totalAmountVes = p.total_amount_ves;
                    const properties = await loadPropertiesForDistribution();
                    
                    if (properties && properties.length > 0) {
                        let distributionHtml = '';
                        
                        if (billingConfig?.billing_type === 'ALICUOTA') {
                            // Distribución por alícuota
                            const totalAlicuota = properties.reduce((sum, prop) => sum + (prop.alicuota || 0), 0);
                            
                            distributionHtml = properties.map(prop => {
                                const proportion = totalAlicuota > 0 ? (prop.alicuota || 0) / totalAlicuota : 0;
                                const amountVes = totalAmountVes * proportion;
                                const amountUsd = totalAmountUsd * proportion;
                                
                                return `
                                    <div class="flex justify-between items-center p-3 bg-[#FAFAFA] rounded-lg">
                                        <div>
                                            <p class="font-medium text-[#3C4043] text-sm">${prop.name}</p>
                                            <p class="text-xs text-[#5F6368]">${prop.building || ''} • Alícuota: ${(prop.alicuota || 0).toFixed(2)}%</p>
                                        </div>
                                        <div class="text-right">
                                            <p class="font-medium text-[#3C4043] text-sm">${formatCurrency(amountVes, 'VES')}</p>
                                            <p class="text-xs text-[#9AA0A6]">${formatCurrency(amountUsd, 'USD')}</p>
                                        </div>
                                    </div>
                                `;
                            }).join('');
                        } else {
                            // Distribución fija (partes iguales)
                            const count = properties.length;
                            const amountVesPerProperty = totalAmountVes / count;
                            const amountUsdPerProperty = totalAmountUsd / count;
                            
                            distributionHtml = properties.map(prop => `
                                <div class="flex justify-between items-center p-3 bg-[#FAFAFA] rounded-lg">
                                    <div>
                                        <p class="font-medium text-[#3C4043] text-sm">${prop.name}</p>
                                        <p class="text-xs text-[#5F6368]">${prop.building || ''}</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-medium text-[#3C4043] text-sm">${formatCurrency(amountVesPerProperty, 'VES')}</p>
                                        <p class="text-xs text-[#9AA0A6]">${formatCurrency(amountUsdPerProperty, 'USD')}</p>
                                    </div>
                                </div>
                            `).join('');
                        }
                        
                        distributionContainer.innerHTML = distributionHtml;
                    } else {
                        distributionContainer.innerHTML = `
                            <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
                                <p class="text-sm text-[#5F6368]">No se pudieron cargar los inmuebles para calcular la distribución</p>
                            </div>
                        `;
                    }
                } else {
                    distributionSection.classList.add('hidden');
                }
                
                // Botones de acción
                const actionsContainer = document.getElementById('detail-actions');
                let actionsHtml = '';
                
                if (p.status === 'DRAFT') {
                    if (billingConfig?.billing_mode === 'FULL') {
                        actionsHtml += `
                            <button onclick="closeModal('preliminary-detail-modal'); showGenerateConfirmModal('${p.id}')" class="px-4 py-2 bg-[#f97316] text-white rounded-lg hover:bg-[#ea580c]">
                                Generar Recibos
                            </button>
                        `;
                    } else {
                        actionsHtml += `
                            <button onclick="closeModal('preliminary-detail-modal'); exportPreliminary('${p.id}')" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-1">
                                <span class="material-icons-round text-sm">download</span>
                                Exportar
                            </button>
                        `;
                    }
                    actionsHtml += `
                        <button onclick="closeModal('preliminary-detail-modal'); showDeleteConfirmModal('${p.id}')" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                            Eliminar
                        </button>
                    `;
                } else if (p.status === 'FINALIZED' && billingConfig?.billing_mode === 'FULL') {
                    actionsHtml += `
                        <button onclick="closeModal('preliminary-detail-modal'); exportPreliminary('${p.id}')" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-1">
                            <span class="material-icons-round text-sm">download</span>
                            Descargar Excel (inmuebles y cobro)
                        </button>
                    `;
                    if (!p.sent_to_owners) {
                        actionsHtml += `
                            <button onclick="closeModal('preliminary-detail-modal'); showSendConfirmModal('${p.id}')" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                                Enviar a Propietarios
                            </button>
                        `;
                    }
                }
                
                actionsContainer.innerHTML = actionsHtml || '<span class="text-sm text-[#9AA0A6]">No hay acciones disponibles</span>';
                
                showModal('preliminary-detail-modal');
            } catch (e) {
                console.error('Error loading preliminary detail:', e);
                showToast('Error al cargar detalle', 'error');
            }
        }

        let pendingPaymentInvoiceId = null;

        function openPaymentModal(invoiceId) {
            pendingPaymentInvoiceId = invoiceId;
            document.getElementById('payment-amount').value = '';
            document.getElementById('payment-method').value = '';
            document.getElementById('payment-reference').value = '';
            showModal('payment-modal');
        }

        document.getElementById('payment-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!pendingPaymentInvoiceId) return;
            
            const amount = parseFloat(document.getElementById('payment-amount').value);
            const method = document.getElementById('payment-method').value;
            const reference = document.getElementById('payment-reference').value;
            
            if (!amount || isNaN(amount) || amount <= 0) {
                showToast('Monto inválido', 'error');
                return;
            }
            
            try {
                const res = await fetch(`/api/tenant-admin/billing/invoices/${pendingPaymentInvoiceId}/payment`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        paid_amount_ves: amount,
                        payment_method: method,
                        payment_reference: reference
                    })
                });
                
                const data = await res.json();
                if (data.success) {
                    showToast('Pago registrado exitosamente');
                    closeModal('payment-modal');
                    loadInvoices();
                } else {
                    showToast(data.error || 'Error al registrar pago', 'error');
                }
            } catch (e) {
                showToast('Error al registrar pago', 'error');
            }
            
            pendingPaymentInvoiceId = null;
        });

        function registerPayment(invoiceId) {
            openPaymentModal(invoiceId);
        }

        let pendingRejectInvoiceId = null;

        function showRejectModal(invoiceId) {
            pendingRejectInvoiceId = invoiceId;
            document.getElementById('reject-reason').value = '';
            closeModal('invoice-detail-modal');
            showModal('reject-payment-modal');
        }

        document.getElementById('reject-payment-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!pendingRejectInvoiceId) return;
            const reason = document.getElementById('reject-reason').value.trim();
            if (!reason) {
                showToast('Indique el motivo del rechazo', 'error');
                return;
            }
            try {
                const res = await fetch(`/api/tenant-admin/billing/invoices/${pendingRejectInvoiceId}/reject-payment`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ rejection_reason: reason })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Reporte rechazado');
                    closeModal('reject-payment-modal');
                    loadInvoices();
                } else {
                    showToast(data.error || 'Error al rechazar', 'error');
                }
            } catch (err) {
                showToast('Error al rechazar reporte', 'error');
            }
            pendingRejectInvoiceId = null;
        });

