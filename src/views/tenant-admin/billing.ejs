        function onPrelRateFreezeModeChange(prefix = 'prel') {
            const windowWrap = document.getElementById(`${prefix}-rate-freeze-window-wrap`);
            const permanentWrap = document.getElementById(`${prefix}-rate-freeze-permanent-wrap`);
            const mode = document.getElementById(`${prefix}-rate-freeze-mode`)?.value || 'NONE';
            if (windowWrap) windowWrap.classList.toggle('hidden', mode !== 'WINDOW');
            if (permanentWrap) permanentWrap.classList.toggle('hidden', mode !== 'PERMANENT');
            if (mode !== 'PERMANENT') {
                const cb = document.getElementById(`${prefix}-rate-unpaid-migrate`);
                if (cb) cb.checked = false;
            }
        }

        function getRateFreezeFields(prefix = 'prel') {
            const mode = document.getElementById(`${prefix}-rate-freeze-mode`)?.value || 'NONE';
            const out = { rate_freeze_mode: mode };
            if (mode === 'WINDOW') {
                out.rate_freeze_window_days = parseInt(document.getElementById(`${prefix}-rate-freeze-window`)?.value, 10);
            }
            if (mode === 'PERMANENT') {
                out.rate_unpaid_migrate_after_month = document.getElementById(`${prefix}-rate-unpaid-migrate`)?.checked === true;
            }
            return out;
        }

        async function loadBcvRateNotice(noticeId = 'prel-bcv-notice') {
            const el = document.getElementById(noticeId);
            if (!el) return false;
            try {
                const res = await fetch('/api/tenant-admin/billing/bcv-rate-context', {
                    headers: { Authorization: `Bearer ${token}` }
                });
                const j = await res.json();
                if (res.ok && j.data) {
                    el.innerHTML = j.data.notice_html;
                    el.classList.remove('hidden');
                    if (j.data.rate) {
                        currentRate = j.data.rate;
                        currentRateDate = j.data.rate_date;
                    }
                    return true;
                }
                el.innerHTML = escapeHtml(j.error || 'No hay tasa BCV disponible.');
                el.classList.remove('hidden');
                return false;
            } catch (e) {
                el.classList.add('hidden');
                return false;
            }
        }

