        function renderPreliminaryItems() {
            const container = document.getElementById('prel-items-list');
            let totalUsd = 0;
            let totalVes = 0;

            if (preliminaryItems.length === 0) {
                container.innerHTML = '<p class="text-center text-[#9AA0A6] py-4">Agrega items de cobro</p>';
            } else {
                container.innerHTML = preliminaryItems.map((item, idx) => {
                    // Calcular conversión según la moneda del item
                    let convertedAmount;
                    if (item.currency === 'USD') {
                        // USD -> VES (multiplicar por tasa)
                        convertedAmount = item.amount * currentRate;
                        totalUsd += item.amount;
                        totalVes += convertedAmount;
                    } else {
                        // VES -> USD (dividir por tasa)
                        convertedAmount = currentRate > 0 ? item.amount / currentRate : 0;
                        totalVes += item.amount;
                        totalUsd += convertedAmount;
                    }

                    const convertedText = item.currency === 'USD' 
                        ? `= Bs. ${formatNumber(convertedAmount)}` 
                        : `= $ ${formatNumber(convertedAmount)}`;

                    return `
                        <div class="flex gap-2 items-start p-3 bg-[#FAFAFA] rounded-lg">
                            <div class="flex-1">
                                <div class="grid grid-cols-12 gap-2 mb-2">
                                    <select class="col-span-3 px-2 py-1 border border-[#E5E5E5] rounded text-sm" 
                                        onchange="updatePreliminaryItem(${idx}, 'type', this.value)">
                                        <option value="ORDINARY" ${item.type === 'ORDINARY' ? 'selected' : ''}>Ordinario</option>
                                        <option value="EXTRAORDINARY" ${item.type === 'EXTRAORDINARY' ? 'selected' : ''}>Extraordinario</option>
                                        <option value="FUND" ${item.type === 'FUND' ? 'selected' : ''}>Fondo</option>
                                        <option value="ADJUSTMENT" ${item.type === 'ADJUSTMENT' ? 'selected' : ''}>Ajuste</option>
                                    </select>
                                    <input type="text" class="col-span-9 px-2 py-1 border border-[#E5E5E5] rounded text-sm" 
                                        placeholder="Descripción" value="${item.description}" 
                                        onchange="updatePreliminaryItem(${idx}, 'description', this.value)">
                                </div>
                                <div class="grid grid-cols-12 gap-2 items-center">
                                    <input type="number" step="0.01" class="col-span-4 px-2 py-1 border border-[#E5E5E5] rounded text-sm" 
                                        placeholder="Monto" value="${item.amount || ''}" 
                                        onchange="updatePreliminaryItem(${idx}, 'amount', parseFloat(this.value) || 0)">
                                    <select class="col-span-3 px-2 py-1 border border-[#E5E5E5] rounded text-sm"
                                        onchange="updatePreliminaryItem(${idx}, 'currency', this.value)">
                                        <option value="VES" ${item.currency === 'VES' ? 'selected' : ''}>VES</option>
                                        <option value="USD" ${item.currency === 'USD' ? 'selected' : ''}>USD</option>
                                    </select>
                                    <span class="col-span-5 text-xs text-[#5F6368]">${convertedText} <span class="text-[#9AA0A6]">(tasa: ${currentRate})</span></span>
                                </div>
                                <div class="flex flex-wrap items-center gap-2 mt-2">
                                    <span class="text-xs text-[#5F6368] whitespace-nowrap">Factura (opcional)</span>
                                    <input type="file" accept="image/jpeg,image/png,image/gif,image/webp,application/pdf,.pdf" class="hidden" id="prel-attach-${idx}" onchange="onPreliminaryAttachmentChange(${idx}, this)">
                                    <label for="prel-attach-${idx}" class="inline-flex items-center gap-1 px-2 py-1 text-xs border border-[#E5E5E5] rounded-lg cursor-pointer hover:bg-white text-[#f97316]">
                                        <span class="material-icons-round text-sm">attach_file</span>
                                        Adjuntar
                                    </label>
                                    <span class="text-xs text-[#9AA0A6] truncate max-w-[200px]">${item._attachmentName ? escapeHtml(item._attachmentName) : 'Sin archivo'}</span>
                                </div>
                            </div>
                            <button type="button" onclick="removePreliminaryItem(${idx})" class="text-red-500 hover:text-red-700 mt-1">
                                <span class="material-icons-round text-sm">delete</span>
                            </button>
                        </div>
                    `;
                }).join('');
            }

            document.getElementById('prel-total-usd').textContent = formatCurrency(totalUsd, 'USD');
            document.getElementById('prel-total-ves').textContent = formatCurrency(totalVes, 'VES');
        }

        async function postPreliminaryMultipart(meta) {
            const fd = new FormData();
            fd.append('billing_month', String(meta.billing_month));
            fd.append('billing_year', String(meta.billing_year));
            fd.append('name', meta.name);
            fd.append('items', JSON.stringify(meta.items));
            if (meta.target_building) fd.append('target_building', meta.target_building);
            if (meta.target_property) fd.append('target_property', meta.target_property);
            if (meta.is_extraordinary) fd.append('is_extraordinary', 'true');
            if (meta.is_property_invoice) fd.append('is_property_invoice', 'true');
            if (meta.rate_freeze_mode) fd.append('rate_freeze_mode', meta.rate_freeze_mode);
            if (meta.rate_freeze_window_days != null) fd.append('rate_freeze_window_days', String(meta.rate_freeze_window_days));
            if (meta.rate_unpaid_migrate_after_month) fd.append('rate_unpaid_migrate_after_month', 'true');
            (meta.attachments || []).forEach((file, i) => {
                if (file) fd.append(`attachment_${i}`, file, file.name);
            });
            const res = await fetch('/api/tenant-admin/billing/preliminaries', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` },
                body: fd
            });
            return res.json();
        }

