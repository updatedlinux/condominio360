            const runCreate = async () => {
                try {
                    const data = await postPreliminaryMultipart({
                        billing_month: parseInt(document.getElementById('prel-month').value, 10),
                        billing_year: parseInt(document.getElementById('prel-year').value, 10),
                        name: document.getElementById('prel-name').value || `Recibo ${document.getElementById('prel-month').value}/${document.getElementById('prel-year').value}`,
                        items: itemsPayload,
                        attachments: preliminaryItems.map(i => i._attachmentFile || null),
