                        <label class="block text-sm font-medium text-[#5F6368] mb-1">Moneda *</label>
                        <select id="contract-currency" class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg">
                            <option value="VES">VES</option>
                            <option value="USD">USD</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-[#5F6368] mb-1">Frecuencia</label>
                    <select id="contract-frequency" class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg">
                        <option value="MONTHLY">Mensual</option>
                        <option value="QUARTERLY">Trimestral</option>
                        <option value="YEARLY">Anual</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-[#5F6368] mb-1">Inicio *</label>
                        <input type="date" id="contract-start" required class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-[#5F6368] mb-1">Fin (opcional)</label>
                        <input type="date" id="contract-end" class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg">
                    </div>
                </div>
                <div id="contract-status-wrap" class="hidden">
                    <label class="block text-sm font-medium text-[#5F6368] mb-1">Estado</label>
                    <select id="contract-status" class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg">
                        <option value="ACTIVE">Activo</option>
                        <option value="INACTIVE">Inactivo</option>
                        <option value="EXPIRED">Vencido</option>
                    </select>
                </div>
                <div class="flex justify-end gap-3 pt-4">
                    <button type="button" onclick="closeModal('contract-modal')" class="px-4 py-2 border border-[#E5E5E5] rounded-lg text-[#5F6368] hover:bg-[#FAFAFA]">
                        Cancelar
                    </button>
                    <button type="submit" class="px-4 py-2 bg-[#f97316] text-white rounded-lg hover:bg-[#ea580c]">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/reserve-fund-modal') %>

    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2"></div>

    <script src="/js/billing-reserve-funds.js"></script>
    <script>
        const token = sessionStorage.getItem('token') || localStorage.getItem('token');
        let billingConfig = null;
        let currentTab = 'preliminaries';
        let preliminaryItems = [];
        let currentRate = 0;
        let currentRateDate = null;  // Fecha efectiva de la tasa (según API), no la de extracción
        let pendingMissingAttachmentsCallback = null;

        function escapeHtml(s) {
            if (s == null || s === '') return '';
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        function onPreliminaryAttachmentChange(idx, input) {
            const f = input.files && input.files[0];
            if (preliminaryItems[idx]) {
                if (f) {
                    preliminaryItems[idx]._attachmentFile = f;
                    preliminaryItems[idx]._attachmentName = f.name;
                } else {
                    delete preliminaryItems[idx]._attachmentFile;
                    delete preliminaryItems[idx]._attachmentName;
                }
            }
            renderPreliminaryItems();
        }

        function onExtraordinaryAttachmentChange(idx, input) {
            const f = input.files && input.files[0];
            if (extraordinaryItems[idx]) {
                if (f) {
                    extraordinaryItems[idx]._attachmentFile = f;
                    extraordinaryItems[idx]._attachmentName = f.name;
                } else {
                    delete extraordinaryItems[idx]._attachmentFile;
                    delete extraordinaryItems[idx]._attachmentName;
                }
            }
            renderExtraordinaryItems();
        }

        function onPropertyInvoiceAttachmentChange(idx, input) {
            const f = input.files && input.files[0];
            if (propertyInvoiceItems[idx]) {
                if (f) {
                    propertyInvoiceItems[idx]._attachmentFile = f;
                    propertyInvoiceItems[idx]._attachmentName = f.name;
                } else {
                    delete propertyInvoiceItems[idx]._attachmentFile;
                    delete propertyInvoiceItems[idx]._attachmentName;
                }
            }
            renderPropertyInvoiceItems();
        }

        function closeMissingAttachmentsModal() {
            pendingMissingAttachmentsCallback = null;
            closeModal('missing-attachments-modal');
        }

        document.getElementById('missing-attachments-confirm')?.addEventListener('click', () => {
            closeModal('missing-attachments-modal');
            if (pendingMissingAttachmentsCallback) {
                const fn = pendingMissingAttachmentsCallback;
                pendingMissingAttachmentsCallback = null;
                fn();
            }
        });

        // Inicialización
        document.addEventListener('DOMContentLoaded', () => {
            const reconBlock = sessionStorage.getItem('reconciliation_blocked');
            if (reconBlock) {
                sessionStorage.removeItem('reconciliation_blocked');
                if (typeof showPageToast === 'function') showPageToast(reconBlock, 'info');
            }
            const now = new Date();
            document.getElementById('prel-month').value = now.getMonth() + 1;
            document.getElementById('prel-year').value = now.getFullYear();
            document.getElementById('extra-month').value = now.getMonth() + 1;
            document.getElementById('extra-year').value = now.getFullYear();
            
            loadBillingConfig();
            loadTenantInfo();
            loadStats();
            loadPreliminaries();
            loadSaaSSummary();
        });

        async function loadSaaSSummary() {
            try {
                const res = await fetch('/api/tenant-admin/saas-invoices/summary', { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                const pending = data.data?.pending_count || 0;
                const badge = document.getElementById('sidebar-saas-pending');
                if (pending > 0 && badge) {
                    badge.textContent = pending;
                    badge.classList.remove('hidden');
                }
            } catch (_) {}
        }

        // Cargar info del tenant (para verificar si es multiedificio y tipo de facturación)
        async function loadTenantInfo() {
            try {
                const res = await fetch('/api/tenant-admin/buildings', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                
                if (data.success && data.buildings && data.buildings.length > 1) {
                    // Guardar edificios para usar en el modal
                    window.tenantBuildings = data.buildings;
                    
                    // Solo mostrar botón de recibo por edificio si la facturación es FIJA
                    // (no disponible para ALICUOTA para evitar confusiones)
                    const billingType = billingConfig?.billing_type || 'FIXED';
                    if (billingType === 'FIXED') {
                        document.getElementById('btn-extraordinary').classList.remove('hidden');
                    }
                }
            } catch (e) {
                console.log('No se pudo verificar tipo de conjunto');
            }
        }

        // Utilidades
        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
            document.getElementById(modalId).classList.remove('flex');
        }

        function showModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
            document.getElementById(modalId).classList.add('flex');
        }

        function showToast(message, type = 'success') {
            const colors = {
                success: 'bg-green-600',
                error: 'bg-red-600',
                warning: 'bg-yellow-600',
                info: 'bg-blue-600'
            };
            const icons = {
                success: 'check_circle',
                error: 'error',
                warning: 'warning',
                info: 'info'
            };
            
            const toast = document.createElement('div');
            toast.className = `${colors[type]} text-white px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3 transform transition-all duration-300 translate-y-10 opacity-0`;
            toast.innerHTML = `<span class="material-icons-round">${icons[type]}</span><span>${message}</span>`;
            
            const container = document.getElementById('toast-container');
            container.appendChild(toast);
            
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-10', 'opacity-0');
            });
            
            setTimeout(() => {
                toast.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        function formatCurrency(amount, currency = 'VES') {
            if (amount === null || amount === undefined) return '-';
            const symbol = currency === 'USD' ? '$' : 'Bs.';
            return `${symbol} ${Number(amount).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function formatNumber(amount) {
            if (amount === null || amount === undefined || isNaN(amount)) return '0,00';
            return Number(amount).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function getStatusClass(status) {
            const classes = {
                'DRAFT': 'bg-gray-100 text-gray-600',
                'FINALIZED': 'bg-blue-100 text-blue-600',
                'CANCELLED': 'bg-red-100 text-red-600',
                'PENDING': 'bg-amber-100 text-amber-600',
                'PAID': 'bg-green-100 text-green-600'
            };
            return classes[status] || 'bg-gray-100 text-gray-600';
        }

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            localStorage.removeItem('tenant');
            window.location.href = '/login';
        }

        // Tabs
        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab-btn').forEach(btn => {
                if (btn.dataset.tab === tab) {
                    btn.classList.add('text-[#f97316]', 'border-b-2', 'border-[#f97316]');
                    btn.classList.remove('text-[#5F6368]');
                } else {
                    btn.classList.remove('text-[#f97316]', 'border-b-2', 'border-[#f97316]');
                    btn.classList.add('text-[#5F6368]');
                }
            });
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.add('hidden');
            });
            document.getElementById(`tab-${tab}`).classList.remove('hidden');

            if (tab === 'vendors') loadVendors();
            if (tab === 'contracts') loadContracts();
            if (tab === 'invoices') loadInvoices();
            if (tab === 'reserve-funds') loadReserveFunds();
        }

        // Cargar configuración
        async function loadBillingConfig() {
            try {
                const res = await fetch('/api/tenant-admin/billing/config', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    billingConfig = data.data;
                    currentRate = billingConfig.usd_to_ves_rate || 0;
                    currentRateDate = billingConfig.rate_date || null;
                    updateConfigBadge();
                    console.log('[Billing] Config loaded, rate:', currentRate, 'date:', currentRateDate);
                }
            } catch (e) {
                console.error('Error loading config:', e);
            }
        }

        // Asegurar que tenemos tasa de cambio
        async function ensureExchangeRate() {
            if (currentRate && currentRate > 0) {
                return true;
            }
            
            // Intentar recargar la configuración
            await loadBillingConfig();
            
            if (currentRate && currentRate > 0) {
                return true;
            }
            
            // Si sigue sin tasa, intentar obtenerla directamente
            try {
                const res = await fetch('/api/tenant-admin/billing/exchange-rate', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success && data.data && data.data.rate) {
                    currentRate = data.data.rate;
                    currentRateDate = data.data.date || null;
                    console.log('[Billing] Rate loaded from exchange API:', currentRate);
                    return true;
                }
            } catch (e) {
                console.error('Error loading exchange rate:', e);
            }
            
            // Si no hay tasa, intentar forzar actualización
            try {
                showToast('No hay tasa BCV disponible. Intentando actualizar...', 'warning');
                const res = await fetch('/api/tenant-admin/billing/exchange-rate/update', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success && data.data && data.data.rate) {
                    currentRate = data.data.rate;
                    currentRateDate = data.data.date || null;
                    console.log('[Billing] Rate updated from API:', currentRate);
                    return true;
                }
            } catch (e) {
                console.error('Error forcing exchange rate update:', e);
            }
            
            return false;
        }

        function updateConfigBadge() {
            const badge = document.getElementById('billing-mode-badge');
            if (!billingConfig) return;
            const modeText = billingConfig.billing_mode === 'FULL' ? 'Modo Completo' : 'Modo Apoyo';
            const modeColor = billingConfig.billing_mode === 'FULL' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700';
            badge.textContent = modeText;
            badge.className = `px-3 py-1 rounded-full text-sm font-medium ${modeColor}`;
            const rfTab = document.getElementById('tab-btn-reserve-funds');
            if (rfTab) {
                rfTab.classList.toggle('hidden', billingConfig.billing_mode !== 'FULL');
            }
            const btnRf = document.getElementById('btn-apply-reserve-funds');
            if (btnRf) {
                btnRf.classList.toggle('hidden', billingConfig.billing_mode !== 'FULL');
            }
        }

        // Estadísticas
        async function loadStats() {
            try {
                const res = await fetch('/api/tenant-admin/billing/stats', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    const stats = data.data;
                    document.getElementById('stat-pending').textContent = stats.pending_count || 0;
                    document.getElementById('stat-paid').textContent = stats.paid_count || 0;
                    document.getElementById('stat-to-collect').textContent = formatCurrency(stats.total_pending || 0);
                    document.getElementById('stat-collected').textContent = formatCurrency(stats.total_collected || 0);
                }
            } catch (e) {
                console.error('Error loading stats:', e);
            }
        }

        // Preliminares
        async function loadPreliminaries() {
            try {
                const months = document.getElementById('preliminaries-months')?.value || '5';
                const url = months ? `/api/tenant-admin/billing/preliminaries?months_back=${months}` : '/api/tenant-admin/billing/preliminaries';
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    renderPreliminaries(data.data);
                }
            } catch (e) {
                console.error('Error loading preliminaries:', e);
            }
        }

        function getInvoiceTypeBadge(type) {
            switch(type) {
                case 'EXTRAORDINARY_PROPERTY':
                    return { text: 'Por Inmueble', class: 'bg-purple-100 text-purple-800 border-purple-200', icon: 'home' };
                case 'EXTRAORDINARY_BUILDING':
                    return { text: 'Por Edificio/Calle', class: 'bg-amber-100 text-amber-800 border-amber-200', icon: 'apartment' };
                case 'EXTRAORDINARY':
                    return { text: 'Extraordinario', class: 'bg-amber-100 text-amber-800 border-amber-200', icon: 'star' };
                default:
                    return { text: 'Ordinario', class: 'bg-blue-100 text-blue-800 border-blue-200', icon: 'receipt' };
            }
        }

        function renderPreliminaries(preliminaries) {
            const container = document.getElementById('preliminaries-list');
            if (preliminaries.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-[#9AA0A6]">
                        <span class="material-icons-round text-4xl mb-2">receipt_long</span>
                        <p>No hay preliminares de facturación</p>
                        <p class="text-sm mt-1">Crea uno nuevo para empezar</p>
                    </div>
                `;
                return;
            }

            const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
            const byMonth = {};
            preliminaries.forEach(p => {
                const key = `${p.billing_year}-${String(p.billing_month).padStart(2,'0')}`;
                if (!byMonth[key]) byMonth[key] = { year: p.billing_year, month: p.billing_month, label: `${months[p.billing_month-1]} ${p.billing_year}`, items: [] };
                byMonth[key].items.push(p);
            });
            const monthKeys = Object.keys(byMonth).sort((a,b) => b.localeCompare(a));

            container.innerHTML = monthKeys.map((key, idx) => {
                const group = byMonth[key];
                const isExpanded = idx === 0;
                const collapseId = `prelim-month-${key.replace(/[^a-z0-9]/gi,'')}`;
                const itemsHtml = group.items.map(p => {
                    const monthName = getMonthName(p.billing_month);
                    const year = p.billing_year;
                    const typeBadge = getInvoiceTypeBadge(p.invoice_type);
                    const isExtraordinary = p.invoice_type && p.invoice_type.includes('EXTRAORDINARY');
                    return `
                <div class="border rounded-lg p-4 hover:shadow-md transition cursor-pointer ${typeBadge.class.replace('text-', 'border-').replace('100', '200')} ${isExtraordinary ? 'bg-opacity-50' : 'bg-white'}" onclick="showPreliminaryDetail('${p.id}')">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-medium text-[#3C4043]">${p.name}</h3>
                                <span class="px-2 py-0.5 ${typeBadge.class} rounded text-xs flex items-center gap-1">
                                    <span class="material-icons-round text-xs">${typeBadge.icon}</span>
                                    ${typeBadge.text}
                                </span>
                            </div>
                            <p class="text-sm text-[#5F6368] mt-1">
                                <span class="font-medium">${monthName} ${year}</span> • Tasa BCV: ${p.exchange_rate_usd} VES/USD
                                ${billingConfig?.usd_to_ves_rate && Number(p.exchange_rate_usd) !== Number(billingConfig.usd_to_ves_rate) ? 
                                    ` → <span class="text-amber-600">${billingConfig.usd_to_ves_rate} (actual)</span>` : ''}
                            </p>
                            <div class="flex gap-4 mt-2 text-sm flex-wrap">
                                <span class="text-[#5F6368]">Total USD: <b>${formatCurrency(p.total_amount_usd, 'USD')}</b></span>
                                <span class="text-[#5F6368]">Total VES: <b>${formatCurrency(
                                    billingConfig?.usd_to_ves_rate ? p.total_amount_usd * billingConfig.usd_to_ves_rate : p.total_amount_ves, 
                                    'VES'
                                )}</b>${billingConfig?.usd_to_ves_rate && Number(p.exchange_rate_usd) !== Number(billingConfig.usd_to_ves_rate) ? ' <span class="text-xs text-amber-600">(tasa actual)</span>' : ''}</span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-2">
                            <span class="px-2 py-1 rounded text-xs ${getStatusClass(p.status)}">${p.status}</span>
                            ${p.status === 'DRAFT' ? `
                                ${billingConfig?.billing_mode === 'FULL' ? `
                                    <button onclick="event.stopPropagation(); showGenerateConfirmModal('${p.id}')" class="px-3 py-1 bg-[#f97316] text-white rounded text-sm hover:bg-[#ea580c]">
                                        Generar Recibos
                                    </button>
                                ` : `
                                    <button onclick="event.stopPropagation(); exportPreliminary('${p.id}')" class="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 flex items-center gap-1">
                                        <span class="material-icons-round text-sm">download</span>
                                        Exportar
                                    </button>
                                `}
                                <button onclick="event.stopPropagation(); showDeleteConfirmModal('${p.id}')" class="px-3 py-1 bg-red-600 text-white rounded text-sm hover:bg-red-700 flex items-center gap-1">
                                    <span class="material-icons-round text-sm">delete</span>
                                    Eliminar
                                </button>
                            ` : ''}
                            ${p.status === 'FINALIZED' && billingConfig?.billing_mode === 'FULL' ? `
                                <button onclick="event.stopPropagation(); exportPreliminary('${p.id}')" class="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 flex items-center gap-1">
                                    <span class="material-icons-round text-sm">download</span>
                                    Excel
                                </button>
                            ` : ''}
                            ${p.status === 'FINALIZED' && billingConfig?.billing_mode === 'FULL' && !p.sent_to_owners ? `
                                <button onclick="event.stopPropagation(); showSendConfirmModal('${p.id}')" class="px-3 py-1 bg-green-600 text-white rounded text-sm hover:bg-green-700">
                                    Enviar a Propietarios
                                </button>
                            ` : ''}
                        </div>
                    </div>
                </div>
                    `;
                }).join('');
                return `
                <div class="border border-[#E5E5E5] rounded-xl overflow-hidden mb-3">
                    <button type="button" onclick="toggleMonthGroup('${collapseId}')" class="w-full flex items-center justify-between px-4 py-3 bg-white hover:bg-[#FAFAFA] text-left font-medium text-[#3C4043]">
                        <span class="flex items-center gap-2">
                            <span class="material-icons-round transition-transform" id="icon-${collapseId}">${isExpanded ? 'expand_less' : 'expand_more'}</span>
                            ${group.label}
                            <span class="text-sm font-normal text-[#5F6368]">(${group.items.length} preliminar${group.items.length !== 1 ? 'es' : ''})</span>
                        </span>
                    </button>
                    <div id="${collapseId}" class="border-t border-[#E5E5E5] ${isExpanded ? '' : 'hidden'}">
                        <div class="p-4 space-y-3 bg-[#FAFAFA]/50">
                            ${itemsHtml}
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }

        function toggleMonthGroup(collapseId) {
            const el = document.getElementById(collapseId);
            const icon = document.getElementById(`icon-${collapseId}`);
            if (el) {
                el.classList.toggle('hidden');
                if (icon) icon.textContent = el.classList.contains('hidden') ? 'expand_more' : 'expand_less';
            }
        }

        function getMonthName(month) {
            const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
            return months[month - 1];
        }

        // Proveedores
        async function loadVendors() {
            try {
                const res = await fetch('/api/tenant-admin/billing/vendors', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof renderVendorsWithActions === 'function') renderVendorsWithActions(data.data);
                    else renderVendors(data.data);
                }
            } catch (e) {
                console.error('Error loading vendors:', e);
            }
        }

        function renderVendors(vendors) {
            const container = document.getElementById('vendors-list');
            if (vendors.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-[#9AA0A6]">
                        <span class="material-icons-round text-4xl mb-2">business</span>
                        <p>No hay proveedores registrados</p>
                    </div>
                `;
                return;
            }
            container.innerHTML = vendors.map(v => `
                <div class="border border-[#E5E5E5] rounded-lg p-4 flex justify-between items-center">
                    <div>
                        <h3 class="font-medium text-[#3C4043]">${v.name}</h3>
                        <p class="text-sm text-[#5F6368]">${v.service_type || 'Sin tipo'} • ${v.active_contracts} contratos activos</p>
                    </div>
                    <span class="px-2 py-1 rounded text-xs ${getStatusClass(v.status)}">${v.status}</span>
                </div>
            `).join('');
        }

        // Contratos
        async function loadContracts() {
            try {
                const res = await fetch('/api/tenant-admin/billing/contracts', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof renderContractsWithActions === 'function') renderContractsWithActions(data.data);
                    else renderContracts(data.data);
                }
            } catch (e) {
                console.error('Error loading contracts:', e);
            }
        }

        function renderContracts(contracts) {
            const container = document.getElementById('contracts-list');
            if (contracts.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-[#9AA0A6]">
                        <span class="material-icons-round text-4xl mb-2">description</span>
