        // Formulario Contrato
        document.getElementById('contract-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const editId = document.getElementById('contract-edit-id').value;
            const body = {
                vendor_id: document.getElementById('contract-vendor').value,
                description: document.getElementById('contract-description').value,
                amount: parseFloat(document.getElementById('contract-amount').value),
                currency: document.getElementById('contract-currency').value,
                billing_frequency: document.getElementById('contract-frequency').value,
