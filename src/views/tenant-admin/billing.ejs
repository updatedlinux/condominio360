                            </div>
                            <button type="button" onclick="removePropertyInvoiceItem(${idx})" class="text-red-500 hover:text-red-700">
                                <span class="material-icons-round">delete</span>
                            </button>
                        </div>
                    `;
                }).join('');
            }
            
            updatePropertyInvoiceTotals();
        }

        function updatePropertyInvoiceItem(index, field, value) {
            propertyInvoiceItems[index][field] = value;
            if (field === 'amount' || field === 'currency') {
                renderPropertyInvoiceItems();
            }
        }

        function updatePropertyInvoiceTotals() {
            let totalUsd = 0;
            let totalVes = 0;
            
            propertyInvoiceItems.forEach(item => {
                if (item.currency === 'USD') {
                    totalUsd += item.amount;
                    totalVes += item.amount * currentRate;
                } else {
                    totalVes += item.amount;
                    totalUsd += currentRate > 0 ? item.amount / currentRate : 0;
                }
            });
            
            document.getElementById('prop-total-usd').textContent = `$ ${totalUsd.toFixed(2)}`;
            document.getElementById('prop-total-ves').textContent = `Bs. ${totalVes.toFixed(2)}`;
        }

        // Submit del form
        document.getElementById('property-invoice-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const propertyId = document.getElementById('prop-property-id').value;
            const name = document.getElementById('prop-name').value;
            const month = parseInt(document.getElementById('prop-month').value);
            const year = parseInt(document.getElementById('prop-year').value);
            
            if (!propertyId) {
                showToast('Debe seleccionar un inmueble', 'error');
                return;
            }
            
            if (propertyInvoiceItems.length === 0) {
                showToast('Debe agregar al menos un item', 'error');
                return;
            }
            
            // Validar items
            for (const item of propertyInvoiceItems) {
                if (!item.description || !item.amount) {
                    showToast('Todos los items deben tener descripción y monto', 'error');
                    return;
                }
            }
            
            const itemsPayload = propertyInvoiceItems.map(i => ({
                item_type: 'EXTRAORDINARY',
                description: i.description,
                amount: i.amount,
                amount_type: 'FIXED',
                currency: i.currency || 'USD'
            }));

            const missingLabels = propertyInvoiceItems
                .map((it, i) => (!it._attachmentFile ? (it.description || `Ítem ${i + 1}`) : null))
                .filter(Boolean);

            const runCreateProperty = async () => {
                try {
                    const result = await postPreliminaryMultipart({
                        billing_month: month,
                        billing_year: year,
                        name: name,
                        items: itemsPayload,
                        ...getRateFreezeFields('prop'),
                        target_property: propertyId,
                        is_property_invoice: true,
                        attachments: propertyInvoiceItems.map(i => i._attachmentFile || null)
                    });
                    if (result.success) {
                        showToast('Recibo creado. Generando para el inmueble...');
                        closeModal('property-invoice-modal');
                        await generateInvoiceForProperty(result.data.id, propertyId);
                        loadPreliminaries();
                    } else {
                        showToast(result.error || result.message || 'Error al crear recibo', 'error');
                    }
                } catch (e) {
                    console.error(e);
                    showToast('Error al crear recibo', 'error');
                }
            };

            if (missingLabels.length > 0) {
                const ul = document.getElementById('missing-attachments-list');
                ul.innerHTML = missingLabels.map((t) => `<li>${escapeHtml(t)}</li>`).join('');
                pendingMissingAttachmentsCallback = runCreateProperty;
                showModal('missing-attachments-modal');
                return;
            }

            await runCreateProperty();
        });

        async function generateInvoiceForProperty(preliminaryId, propertyId) {
            try {
                const res = await fetch(`/api/tenant-admin/billing/preliminaries/${preliminaryId}/generate-property/${propertyId}`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                const data = await res.json();
                if (data.success) {
                    showToast('Recibo generado exitosamente para el inmueble');
                    loadPreliminaries();
                    loadStats();
                } else {
                    showToast(data.error || 'Error al generar recibo', 'error');
                }
            } catch (e) {
                console.error(e);
                showToast('Error al generar recibo', 'error');
            }
        }

        // Cerrar resultados al hacer click fuera
        document.addEventListener('click', (e) => {
            const searchContainer = document.getElementById('prop-search');
            const resultsContainer = document.getElementById('prop-search-results');
            if (searchContainer && resultsContainer && !searchContainer.contains(e.target) && !resultsContainer.contains(e.target)) {
                resultsContainer.classList.add('hidden');
            }
        });
    </script>
</body>
</html>
