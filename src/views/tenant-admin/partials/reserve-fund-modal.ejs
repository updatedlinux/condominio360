    <!-- Modal Fondo de Reserva -->
    <div id="reserve-fund-modal" class="modal fixed inset-0 z-50 hidden items-center justify-center">
        <div class="bg-white rounded-xl w-full max-w-2xl mx-4 p-6 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-4">
                <h3 id="reserve-fund-modal-title" class="text-lg font-medium text-[#3C4043]">Nuevo fondo de reserva</h3>
                <button type="button" onclick="closeModal('reserve-fund-modal')" class="text-[#5F6368] hover:text-[#3C4043]">
                    <span class="material-icons-round">close</span>
                </button>
            </div>
            <form id="reserve-fund-form" class="space-y-4">
                <input type="hidden" id="reserve-fund-edit-id" value="">
                <div>
                    <label class="block text-sm font-medium text-[#5F6368] mb-1">Nombre del fondo *</label>
                    <input type="text" id="rf-name" required class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-[#5F6368] mb-1">Naturaleza *</label>
                    <select id="rf-nature" class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg">
                        <option value="ORDINARY_RESERVE">Fondo de reserva ordinario (ley)</option>
                        <option value="SAVINGS">Fondo de ahorro</option>
                        <option value="MAINTENANCE">Mantenimiento mayor</option>
                        <option value="OTHER">Otro</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-[#5F6368] mb-1">Porcentaje (%) *</label>
                    <input type="number" step="0.01" min="0.01" max="100" id="rf-percentage" required class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg">
                </div>
                <label class="flex items-center gap-2 text-sm text-[#3C4043]">
                    <input type="checkbox" id="rf-include-extra" class="rounded">
                    Incluir gastos extraordinarios del preliminar en la base de cálculo
                </label>
                <div>
                    <label class="block text-sm font-medium text-[#5F6368] mb-2">Contratos incluidos en la base</label>
                    <p class="text-xs text-[#9AA0A6] mb-2">Montos en USD se convierten con la tasa BCV al generar el preliminar.</p>
                    <div id="rf-contracts-list" class="max-h-48 overflow-y-auto border border-[#E5E5E5] rounded-lg p-3 space-y-2 text-sm"></div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-[#5F6368] mb-1">Notas (opcional)</label>
                    <textarea id="rf-notes" rows="2" class="w-full px-3 py-2 border border-[#E5E5E5] rounded-lg"></textarea>
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeModal('reserve-fund-modal')" class="px-4 py-2 border border-[#E5E5E5] rounded-lg text-[#5F6368]">Cancelar</button>
                    <button type="submit" class="px-4 py-2 bg-[#f97316] text-white rounded-lg hover:bg-[#ea580c]">Guardar fondo</button>
                </div>
            </form>
        </div>
    </div>
