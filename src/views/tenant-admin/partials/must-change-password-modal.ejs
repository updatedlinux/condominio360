<!-- Modal obligatorio: Cambio de contraseña en primer login (no se puede cerrar) -->
<div id="must-change-password-overlay" class="fixed inset-0 bg-black/60 z-[9999] flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center">
                <span class="material-icons-round text-amber-600 text-2xl">lock</span>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-[#3C4043]">Cambio de contraseña requerido</h2>
                <p class="text-sm text-[#5F6368]">Por seguridad, debes cambiar tu contraseña antes de continuar.</p>
            </div>
        </div>
        <form id="must-change-password-form" class="space-y-4">
            <div>
                <label for="mcp-current" class="block text-sm font-medium text-[#3C4043] mb-1">Contraseña actual *</label>
                <input type="password" id="mcp-current" required autocomplete="current-password"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#f97316] focus:border-[#f97316] outline-none">
            </div>
            <div>
                <label for="mcp-new" class="block text-sm font-medium text-[#3C4043] mb-1">Nueva contraseña *</label>
                <input type="password" id="mcp-new" required minlength="8" autocomplete="new-password"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#f97316] focus:border-[#f97316] outline-none"
                    placeholder="Mínimo 8 caracteres">
            </div>
            <div>
                <label for="mcp-confirm" class="block text-sm font-medium text-[#3C4043] mb-1">Confirmar nueva contraseña *</label>
                <input type="password" id="mcp-confirm" required minlength="8" autocomplete="new-password"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#f97316] focus:border-[#f97316] outline-none">
            </div>
            <p id="mcp-error" class="text-sm text-red-600 hidden"></p>
            <button type="submit" id="mcp-submit" class="w-full py-3 bg-[#f97316] hover:bg-[#ea580c] text-white font-medium rounded-lg flex items-center justify-center gap-2 transition disabled:opacity-60 disabled:cursor-not-allowed">
                <span id="mcp-spinner" class="hidden animate-spin rounded-full h-5 w-5 border-2 border-white border-t-transparent"></span>
                <span id="mcp-btn-text">Cambiar contraseña</span>
            </button>
        </form>
    </div>
</div>
<script>
(function() {
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    if (user.type !== 'TENANT_ADMIN' || !user.mustChangePassword) return;

    const overlay = document.getElementById('must-change-password-overlay');
    const form = document.getElementById('must-change-password-form');
    const errEl = document.getElementById('mcp-error');
    const submitBtn = document.getElementById('mcp-submit');
    const spinner = document.getElementById('mcp-spinner');
    const btnText = document.getElementById('mcp-btn-text');

    function showError(msg) {
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
    }
    function hideError() {
        errEl.classList.add('hidden');
    }

    overlay.classList.remove('hidden');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        const current = document.getElementById('mcp-current').value;
        const newPwd = document.getElementById('mcp-new').value;
        const confirm = document.getElementById('mcp-confirm').value;

        if (newPwd.length < 8) {
            showError('La nueva contraseña debe tener al menos 8 caracteres');
            return;
        }
        if (newPwd !== confirm) {
            showError('Las contraseñas no coinciden');
            return;
        }

        submitBtn.disabled = true;
        spinner.classList.remove('hidden');
        btnText.textContent = 'Guardando...';

        try {
            const token = localStorage.getItem('token');

            const res = await fetch('/api/auth/change-password', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({
                    currentPassword: current,
                    newPassword: newPwd
                })
            });

            const data = await res.json();

            if (!res.ok) {
                throw new Error(data.error || 'Error al cambiar contraseña');
            }

            user.mustChangePassword = false;
            localStorage.setItem('user', JSON.stringify(user));
            overlay.classList.add('hidden');
        } catch (err) {
            showError(err.message || 'Error al cambiar contraseña');
            submitBtn.disabled = false;
        } finally {
            spinner.classList.add('hidden');
            btnText.textContent = 'Cambiar contraseña';
        }
    });
})();
</script>
