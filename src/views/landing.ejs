<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Condominio360</title>
    <link href="/css/output.css" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/assets/images/isotipo-naranja.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <% if (typeof recaptchaSiteKey !== 'undefined' && recaptchaSiteKey) { %>
    <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>"></script>
    <% } %>
    <style>
        body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    </style>
</head>
<body class="bg-white text-slate-900 antialiased overflow-x-hidden">

    <!-- ==================== NAVBAR ==================== -->
    <nav class="fixed w-full z-50 transition-all duration-300" id="navbar">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <a href="/" class="flex items-center gap-3 group">
                    <img src="/assets/images/isotipo-naranja.svg" alt="" class="h-12 sm:h-14 w-12 sm:w-14 flex-shrink-0 transition group-hover:opacity-90" style="object-fit: contain;">
                    <span class="text-xl sm:text-2xl text-slate-900 tracking-tight" style="font-weight: 800;">Condominio360</span>
                </a>
                
                <div class="hidden lg:flex items-center gap-10">
                    <a href="#features" class="text-slate-600 hover:text-orange-600 font-medium transition">Funciones</a>
                    <a href="#how-it-works" class="text-slate-600 hover:text-orange-600 font-medium transition">Cómo funciona</a>
                    <a href="#pricing" class="text-slate-600 hover:text-orange-600 font-medium transition">Precios</a>
                    <a href="#faq" class="text-slate-600 hover:text-orange-600 font-medium transition">FAQ</a>
                </div>

                <div class="hidden lg:flex items-center gap-4">
                    <a href="/login" class="text-slate-700 font-semibold hover:text-orange-600 transition">Iniciar Sesión</a>
                    <a href="#demo" class="bg-orange-500 text-white px-6 py-3 rounded-full font-semibold hover:bg-orange-600 transition shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40">
                        Solicitar Demo
                    </a>
                </div>

                <button class="lg:hidden p-3 rounded-lg hover:bg-slate-100 transition" onclick="toggleMobileMenu()" aria-label="Menú">
                    <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>
        </div>

        <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-slate-100 shadow-lg">
            <div class="px-4 py-6 space-y-1">
                <a href="#features" class="block py-3 px-4 rounded-lg text-slate-600 font-medium hover:bg-orange-50 hover:text-orange-600">Funciones</a>
                <a href="#how-it-works" class="block py-3 px-4 rounded-lg text-slate-600 font-medium hover:bg-orange-50 hover:text-orange-600">Cómo funciona</a>
                <a href="#pricing" class="block py-3 px-4 rounded-lg text-slate-600 font-medium hover:bg-orange-50 hover:text-orange-600">Precios</a>
                <a href="#faq" class="block py-3 px-4 rounded-lg text-slate-600 font-medium hover:bg-orange-50 hover:text-orange-600">FAQ</a>
                <hr class="border-slate-100 my-4">
                <a href="/login" class="block py-3 px-4 rounded-lg text-slate-900 font-semibold hover:bg-slate-50">Iniciar Sesión</a>
                <a href="#demo" class="block py-4 px-4 bg-orange-500 text-white text-center rounded-full font-semibold">Solicitar Demo</a>
            </div>
        </div>
    </nav>

    <!-- ==================== HERO ==================== -->
    <section class="relative pt-28 pb-16 lg:pt-40 lg:pb-24 min-h-[90vh] flex items-center">
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute -top-40 -right-40 w-96 h-96 bg-orange-200/40 rounded-full blur-3xl"></div>
            <div class="absolute top-1/2 -left-20 w-72 h-72 bg-blue-200/30 rounded-full blur-3xl"></div>
        </div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                <div>
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-100 text-orange-700 text-sm font-semibold mb-6">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
                        </span>
                        Plataforma v2.0 disponible
                    </div>
                    
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-[1.1] tracking-tight mb-6">
                        Gestión de condominios
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-orange-600">sin esfuerzo</span>
                    </h1>
                    
                    <p class="text-lg lg:text-xl text-slate-600 mb-6 leading-relaxed max-w-xl">
                        Centraliza la administración, automatiza procesos y mejora la comunicación en tu comunidad. Todo en una plataforma moderna y segura.
                    </p>
                    <p class="text-slate-600 mb-8 max-w-xl">
                        <span class="font-semibold text-slate-700">Compatible con conjuntos multiedificios o mono-edificio.</span> Genera facturación completa o, si tu conjunto tiene empresa administradora, apóyala con preliminares y delegando el cobro.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 mb-10">
                        <a href="#demo" class="inline-flex items-center justify-center px-8 py-4 bg-orange-500 text-white rounded-full font-semibold hover:bg-orange-600 transition shadow-xl shadow-orange-500/25 hover:shadow-orange-500/35 hover:-translate-y-0.5">
                            Comenzar gratis
                            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                        <a href="#how-it-works" class="inline-flex items-center justify-center px-8 py-4 bg-white text-slate-900 border-2 border-slate-200 rounded-full font-semibold hover:border-orange-300 hover:text-orange-600 transition">
                            Ver cómo funciona
                        </a>
                    </div>

                    <div class="flex items-center gap-5">
                        <div class="flex -space-x-3">
                            <img class="w-11 h-11 rounded-full border-2 border-white shadow" src="https://i.pravatar.cc/100?img=1" alt="">
                            <img class="w-11 h-11 rounded-full border-2 border-white shadow" src="https://i.pravatar.cc/100?img=2" alt="">
                            <img class="w-11 h-11 rounded-full border-2 border-white shadow" src="https://i.pravatar.cc/100?img=3" alt="">
                            <img class="w-11 h-11 rounded-full border-2 border-white shadow" src="https://i.pravatar.cc/100?img=4" alt="">
                        </div>
                        <div>
                            <p class="text-sm text-slate-600"><span class="font-bold text-slate-900">+100 condominios</span> nos confían</p>
                        </div>
                    </div>
                </div>

                <!-- Mockup / Visual derecho -->
                <div class="relative hidden lg:block">
                    <div class="relative bg-white rounded-2xl shadow-2xl border border-slate-100 overflow-hidden">
                        <div class="bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-4 flex items-center gap-2">
                            <div class="flex gap-1.5">
                                <div class="w-3 h-3 rounded-full bg-white/80"></div>
                                <div class="w-3 h-3 rounded-full bg-white/50"></div>
                                <div class="w-3 h-3 rounded-full bg-white/30"></div>
                            </div>
                            <span class="flex-1 text-center text-white/90 text-sm font-medium">app.condominio360.com</span>
                        </div>
                        <div class="p-6 bg-slate-50/50">
                            <div class="grid grid-cols-3 gap-3 mb-4">
                                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                                    <div class="text-xs text-slate-500 mb-1">Unidades</div>
                                    <div class="text-2xl font-bold text-slate-900">128</div>
                                </div>
                                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                                    <div class="text-xs text-slate-500 mb-1">Al día</div>
                                    <div class="text-2xl font-bold text-emerald-600">94%</div>
                                </div>
                                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                                    <div class="text-xs text-slate-500 mb-1">Visitas hoy</div>
                                    <div class="text-2xl font-bold text-slate-900">24</div>
                                </div>
                            </div>
                            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-4">
                                <div class="flex items-center justify-between mb-3">
                                    <span class="font-semibold text-slate-900">Próximas mudanzas</span>
                                    <span class="text-xs text-orange-600 font-medium">Ver todas</span>
                                </div>
                                <div class="space-y-2">
                                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-lg">
                                        <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center text-orange-600 font-bold text-sm">15</div>
                                        <div>
                                            <div class="font-medium text-slate-900 text-sm">Torre A - 1502</div>
                                            <div class="text-xs text-slate-500">10:00 AM • Entrada</div>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-lg">
                                        <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center text-emerald-600 font-bold text-sm">22</div>
                                        <div>
                                            <div class="font-medium text-slate-900 text-sm">Torre B - 304</div>
                                            <div class="text-xs text-slate-500">02:00 PM • Salida</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== FEATURES - ¿Por qué elegir Condominio360? ==================== -->
    <section id="features" class="py-20 lg:py-28 bg-slate-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-orange-600 font-bold text-sm tracking-wide uppercase">Funciones</span>
                <h2 class="text-3xl lg:text-4xl font-extrabold text-slate-900 mt-3 mb-4">Todo lo que necesitas</h2>
                <p class="text-lg text-slate-600">Herramientas potentes diseñadas para la administración moderna de condominios.</p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-orange-200 hover:shadow-xl hover:shadow-orange-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-orange-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Votaciones Digitales</h3>
                    <p class="text-slate-600 leading-relaxed">Cartas consulta y votaciones en línea con verificación por unidad. Resultados transparentes y auditables.</p>
                </div>

                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-emerald-200 hover:shadow-xl hover:shadow-emerald-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-emerald-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Control de Visitantes</h3>
                    <p class="text-slate-600 leading-relaxed">Gestiona visitas frecuentes y únicas. Autorización en tiempo real desde la app por parte de propietarios.</p>
                </div>

                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-blue-200 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-blue-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Acceso NFC</h3>
                    <p class="text-slate-600 leading-relaxed">Tarjetas NFC por unidad para acceso rápido y seguro. Registro automático de entradas y salidas.</p>
                </div>

                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-amber-200 hover:shadow-xl hover:shadow-amber-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-amber-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Solicitudes Inteligentes</h3>
                    <p class="text-slate-600 leading-relaxed">Mudanzas, sugerencias y reclamos con flujos de aprobación configurables y notificaciones automáticas.</p>
                </div>

                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-rose-200 hover:shadow-xl hover:shadow-rose-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-rose-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Facturación Completa o en Apoyo</h3>
                    <p class="text-slate-600 leading-relaxed">Gestión de cuotas, multas y recibos. Facturación integral o apoyo a empresa administradora con preliminares y delegación del cobro.</p>
                </div>

                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-purple-200 hover:shadow-xl hover:shadow-purple-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-purple-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Analíticas Avanzadas</h3>
                    <p class="text-slate-600 leading-relaxed">Dashboard con métricas clave. Reportes de morosidad, ocupación y actividad exportables.</p>
                </div>

                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-cyan-200 hover:shadow-xl hover:shadow-cyan-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-cyan-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                            <circle cx="12" cy="18" r="1" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Compatibilidad Móvil</h3>
                    <p class="text-slate-600 leading-relaxed">Funciona desde cualquier dispositivo. Interfaz responsive y PWA instalable para acceso rápido desde celular o tablet.</p>
                </div>

                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-green-200 hover:shadow-xl hover:shadow-green-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-green-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Notificaciones In-App y WhatsApp</h3>
                    <p class="text-slate-600 leading-relaxed">Alertas en la plataforma y por WhatsApp. Comunicados, recordatorios de pago y actualizaciones en tiempo real.</p>
                </div>

                <div class="group bg-white p-8 rounded-2xl border border-slate-100 hover:border-indigo-200 hover:shadow-xl hover:shadow-indigo-500/10 transition-all duration-300">
                    <div class="w-14 h-14 bg-indigo-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <path d="M12 2L2 7v6c0 5.5 3.8 10.7 10 12 6.2-1.3 10-6.5 10-12V7L12 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Gestión de Seguridad</h3>
                    <p class="text-slate-600 leading-relaxed">El personal de vigilancia cuenta con un panel en tiempo real para visualizar visitas programadas, deliveries y autorizaciones. Todo al alcance de un vistazo.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== HOW IT WORKS - 4 pasos ==================== -->
    <section id="how-it-works" class="py-20 lg:py-28">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-orange-600 font-bold text-sm tracking-wide uppercase">Implementación</span>
                <h2 class="text-3xl lg:text-4xl font-extrabold text-slate-900 mt-3 mb-4">Operativo en días, no meses</h2>
                <p class="text-lg text-slate-600">Proceso diseñado para minimizar la interrupción de tu operación.</p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="text-center">
                    <div class="w-16 h-16 bg-orange-500 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-6">1</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Configuración inicial</h3>
                    <p class="text-slate-600 text-sm">Creamos tu condominio e importamos tus datos y tipos de solicitud.</p>
                </div>
                <div class="text-center">
                    <div class="w-16 h-16 bg-orange-500 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-6">2</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Onboarding</h3>
                    <p class="text-slate-600 text-sm">Invitamos a propietarios y vigilancia. Capacitación incluida.</p>
                </div>
                <div class="text-center">
                    <div class="w-16 h-16 bg-orange-500 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-6">3</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Operación</h3>
                    <p class="text-slate-600 text-sm">La junta y propietarios comienzan a usar la plataforma.</p>
                </div>
                <div class="text-center">
                    <div class="w-16 h-16 bg-orange-500 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-6">4</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Soporte 24/7</h3>
                    <p class="text-slate-600 text-sm">Estamos contigo en cada paso del camino.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== PRICING ==================== -->
    <section id="pricing" class="py-20 lg:py-28 bg-slate-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-orange-600 font-bold text-sm tracking-wide uppercase">Precios</span>
                <h2 class="text-3xl lg:text-4xl font-extrabold text-slate-900 mt-3 mb-4">Plan único, todo incluido</h2>
                <p class="text-lg text-slate-600">Precio transparente por unidad. Contrato de permanencia aplicable.</p>
            </div>

            <div class="max-w-2xl mx-auto">
                <div class="bg-orange-500 rounded-2xl p-8 lg:p-10 shadow-2xl shadow-orange-500/25">
