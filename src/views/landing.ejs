    <script>window.RECAPTCHA_SITE_KEY = '<%= typeof recaptchaSiteKey !== "undefined" ? (recaptchaSiteKey || "") : "" %>';</script>
    <script>
        /** Misma lógica que login (auth.js): reCAPTCHA v3 con acción distinta para el backend */
        function getRecaptchaTokenDemo() {
            const siteKey = (window.RECAPTCHA_SITE_KEY || '').trim();
            if (!siteKey) return Promise.resolve(null);
            if (typeof grecaptcha === 'undefined') {
                console.warn('[reCAPTCHA] grecaptcha no definido. Verifica que el script cargue.');
                return Promise.resolve(null);
            }
            return new Promise((resolve) => {
                try {
                    grecaptcha.ready(function() {
                        try {
                            grecaptcha.execute(siteKey, { action: 'demo_request' }).then(function(token) {
                                resolve(token || null);
                            }).catch(function(err) {
                                console.warn('[reCAPTCHA] execute error:', err);
                                resolve(null);
                            });
                        } catch (e) {
                            console.warn('[reCAPTCHA] Error:', e.message);
                            resolve(null);
                        }
                    });
                } catch (err) {
                    console.warn('[reCAPTCHA] Error:', err.message || err);
                    resolve(null);
                }
            });
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href === '#') return;
                e.preventDefault();
                const target = document.querySelector(href);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    document.getElementById('mobile-menu').classList.add('hidden');
                }
            });
        });

        document.querySelectorAll('.faq-trigger').forEach(btn => {
            btn.addEventListener('click', function() {
                const targetId = this.getAttribute('data-target');
                const content = document.getElementById(targetId);
                const arrow = this.querySelector('.faq-arrow');
                content.classList.toggle('hidden');
                arrow.classList.toggle('rotate-180');
            });
        });

        function showDemoModal(message, type) {
            type = type || 'success';
            const overlay = document.getElementById('demo-modal-overlay');
            const msgEl = document.getElementById('demo-modal-message');
            const iconBox = document.getElementById('demo-modal-icon');
            const iconCheck = document.getElementById('demo-modal-icon-check');
            const iconError = document.getElementById('demo-modal-icon-error');

            msgEl.textContent = message;
            if (type === 'error') {
                iconBox.classList.remove('bg-orange-500');
                iconBox.classList.add('bg-red-500');
                iconCheck.classList.add('hidden');
                iconError.classList.remove('hidden');
            } else {
                iconBox.classList.remove('bg-red-500');
                iconBox.classList.add('bg-orange-500');
                iconCheck.classList.remove('hidden');
                iconError.classList.add('hidden');
            }
            overlay.classList.remove('hidden');
        }

        function closeDemoModal(e) {
            if (e && e.target !== e.currentTarget && e.type !== 'keydown') return;
            document.getElementById('demo-modal-overlay').classList.add('hidden');
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const overlay = document.getElementById('demo-modal-overlay');
                if (overlay && !overlay.classList.contains('hidden')) closeDemoModal();
            }
        });

        async function handleDemoRequest(e) {
            e.preventDefault();
            const form = e.target;
            const emailInput = form.querySelector('input[name="email"]');
            const email = (emailInput?.value || '').trim();
            const submitBtn = form.querySelector('button[type="submit"]');

            if (!email) {
                showDemoModal('Por favor ingresa tu correo electrónico.', 'error');
                return;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Enviando...';
            }

            try {
                const recaptchaToken = await getRecaptchaTokenDemo();
                const body = { email };
                if (recaptchaToken) body.recaptchaToken = recaptchaToken;

                const res = await fetch('/api/demo-request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const data = await res.json();

                if (res.ok && data.success) {
                    showDemoModal('¡Gracias! Te hemos enviado un correo de confirmación. Serás contactado en breve por Arsys Intela para coordinar tu demo.');
                    form.reset();
                } else {
                    showDemoModal(data.error || 'Error al enviar. Intenta nuevamente.', 'error');
                }
            } catch (err) {
                console.error('Demo request error:', err);
                showDemoModal('Error de conexión. Intenta nuevamente más tarde.', 'error');
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Solicitar Demo';
                }
            }
        }

        document.querySelectorAll('a[href="#demo"]').forEach(el => {
            el.addEventListener('click', function(e) {
                if (this.getAttribute('href') === '#demo') {
                    e.preventDefault();
                    document.getElementById('demo').scrollIntoView({ behavior: 'smooth' });
                }
            });
        });

        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('bg-white/95', 'backdrop-blur-lg', 'shadow-sm');
            } else {
                navbar.classList.remove('bg-white/95', 'backdrop-blur-lg', 'shadow-sm');
            }
        });
    </script>
</body>
