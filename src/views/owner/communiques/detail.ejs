<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/assets/images/isotipo-naranja.svg">
    <title><%= communique.title %> - Comunicado</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <script src="/js/owner-nav.js"></script>
    <style>
        * { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
        .sidebar-item { transition: all 0.2s; }
        .sidebar-item:hover, .sidebar-item.active { 
            background: linear-gradient(90deg, rgba(249,115,22,0.1) 0%, transparent 100%);
            border-right: 3px solid #f97316;
        }
        .sidebar-item.active { background: linear-gradient(90deg, rgba(249,115,22,0.15) 0%, transparent 100%); }
        
        /* Estilos para el contenido del comunicado */
        .communique-content {
            font-size: 16px;
            line-height: 1.8;
            color: #333;
        }
        .communique-content h1 { 
            font-size: 28px; 
            font-weight: 600; 
            color: #1a1a1a; 
            margin: 30px 0 20px;
            border-bottom: 2px solid #f97316;
            padding-bottom: 10px;
        }
        .communique-content h2 { 
            font-size: 24px; 
            font-weight: 600; 
            color: #333; 
            margin: 25px 0 15px;
        }
        .communique-content h3 { 
            font-size: 20px; 
            font-weight: 600; 
            color: #444; 
            margin: 20px 0 10px;
        }
        .communique-content h4 { 
            font-size: 18px; 
            font-weight: 600; 
            color: #555; 
            margin: 15px 0 8px;
        }
        .communique-content p { 
            margin: 15px 0; 
            text-align: justify;
        }
        .communique-content strong { 
            font-weight: 700; 
            color: #1a1a1a; 
        }
        .communique-content em { 
            font-style: italic; 
        }
        .communique-content u { 
            text-decoration: underline; 
        }
        .communique-content ul, .communique-content ol { 
            margin: 15px 0; 
            padding-left: 30px; 
        }
        .communique-content li { 
            margin: 8px 0; 
        }
        .communique-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }
        .communique-content th, .communique-content td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }
        .communique-content th {
            background: #f8f9fa;
            font-weight: 600;
        }
        .communique-content img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 20px auto;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .communique-content blockquote {
            border-left: 4px solid #f97316;
            margin: 20px 0;
            padding: 15px 20px;
            background: #f8f9fa;
            font-style: italic;
        }
        .communique-content a {
            color: #f97316;
            text-decoration: underline;
        }
        .communique-content a:hover {
            color: #ea580c;
        }
        @media print {
            .no-print { display: none; }
            body { background: white; }
            .communique-container { box-shadow: none; }
        }
    </style>
</head>
<body class="bg-[#FAFAFA]">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside id="owner-sidebar" class="owner-sidebar fixed md:static inset-y-0 left-0 z-50 w-64 bg-white border-r border-[#E5E5E5] flex flex-col transform -translate-x-full md:translate-x-0 transition-transform duration-300 no-print">
            <div class="h-16 flex items-center justify-between gap-3 px-4 md:px-6 border-b border-[#E5E5E5] min-w-0">
                <div class="flex items-center gap-3 min-w-0 flex-1">
                    <img src="/assets/images/isotipo-naranja.svg" alt="" class="h-8 w-8 flex-shrink-0" style="object-fit: contain;">
                    <span class="font-bold text-xl text-[#f97316] truncate">Condominio360</span>
                </div>
                <button type="button" onclick="toggleOwnerMobileNav()" class="md:hidden w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-lg hover:bg-[#F5F5F5] text-[#5F6368]">
                    <span class="material-icons-round">close</span>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto py-4">
                <nav class="space-y-1 px-3">
                    <a href="/owner/dashboard" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">dashboard</span>
                        Panel Principal
                    </a>
                    <a href="/owner/requests" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">assignment</span>
                        Mis Solicitudes
                    </a>
                    <a href="/owner/consultations" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">how_to_vote</span>
                        Consultas
                    </a>
                    <a href="/owner/visitors" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">people</span>
                        Visitas
                    </a>
                    <a href="/owner/communiques" class="sidebar-item active flex items-center px-3 py-3 text-sm font-medium text-[#3C4043] rounded-lg">
                        <span class="material-icons-round mr-3 text-[#f97316]">campaign</span>
                        Comunicados
                    </a>
                    <a href="/owner/common-areas" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">sports_tennis</span>
                        Áreas Comunes
                    </a>
                    <a href="/owner/delivery/new" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">local_shipping</span>
                        Anunciar Delivery
                    </a>
                    <a href="/owner/invoices" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">receipt_long</span>
                        Mis Recibos
                    </a>
                    <a href="/owner/vehicle-access" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">nfc</span>
                        Accesos Vehiculares
                    </a>
                    <a href="/owner/profile" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                        <span class="material-icons-round mr-3 text-[#5F6368]">person</span>
                        Mi Perfil
                    </a>
                    <div class="pt-4 mt-4 border-t border-[#E5E5E5]">
                        <p class="px-3 text-xs font-medium text-[#9AA0A6] uppercase mb-2">Acciones Rápidas</p>
                        <a href="/owner/requests/new" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                            <span class="material-icons-round mr-3 text-[#5F6368]">add_circle</span>
                            Nueva Solicitud
                        </a>
                        <a href="/owner/visitors/new" class="sidebar-item flex items-center px-3 py-3 text-sm font-medium text-[#5F6368] rounded-lg hover:text-[#3C4043]">
                            <span class="material-icons-round mr-3 text-[#5F6368]">person_add</span>
                            Anunciar Visita
                        </a>
                    </div>
                </nav>
            </div>
            <div class="p-4 border-t border-[#E5E5E5]">
                <button onclick="logout()" class="flex items-center w-full px-3 py-2 text-sm font-medium text-[#5F6368] hover:text-red-600 rounded-lg hover:bg-red-50">
                    <span class="material-icons-round mr-3">logout</span>
                    Cerrar Sesión
                </button>
            </div>
        </aside>
        <div id="owner-mobile-overlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden no-print" onclick="toggleOwnerMobileNav()"></div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Header -->
            <header class="bg-white shadow-sm sticky top-0 z-40 no-print">
                <div class="px-4 md:px-6 py-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3 min-w-0">
                            <button type="button" onclick="toggleOwnerMobileNav()" class="md:hidden w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-lg hover:bg-[#F5F5F5] text-[#5F6368]">
                                <span class="material-icons-round">menu</span>
                            </button>
                            <a href="/owner/communiques" class="text-[#5F6368] hover:text-[#3C4043] flex-shrink-0">
                                <span class="material-icons-round">arrow_back</span>
                            </a>
                            <div>
                                <h1 class="text-xl font-medium text-[#3C4043]"><%= communique.title %></h1>
                                <p class="text-sm text-[#5F6368]">Comunicado de la Junta</p>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="window.print()" class="flex items-center gap-2 px-4 py-2 border border-[#E5E5E5] text-[#5F6368] rounded-lg hover:bg-[#FAFAFA] no-print">
                                <span class="material-icons-round">print</span>
                                <span class="hidden sm:inline">Imprimir</span>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <main class="flex-1 overflow-y-auto p-6">
                <div class="max-w-4xl mx-auto">
                    <!-- Info Card -->
                    <div class="bg-white rounded-xl shadow-sm p-6 mb-6 no-print">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 bg-[#f97316]/10 rounded-xl flex items-center justify-center">
                                    <span class="material-icons-round text-[#f97316]">
                                        <%= communique.file_type === 'docx' ? 'description' : 'picture_as_pdf' %>
                                    </span>
                                </div>
                                <div>
                                    <p class="text-sm text-[#5F6368]">
                                        Publicado el <%= new Date(communique.created_at).toLocaleDateString('es-VE', { 
                                            weekday: 'long', 
                                            year: 'numeric', 
                                            month: 'long', 
                                            day: 'numeric',
                                            timeZone: 'America/Caracas'
                                        }) %>
                                    </p>
                                    <p class="text-sm text-[#9AA0A6]">
                                        por <%= communique.author_name %>
                                    </p>
                                </div>
                            </div>
                            <% if (communique.file_type === 'pdf') { %>
                            <a href="/uploads/communiques/<%= communique.filename %>" 
                               download 
                               class="flex items-center gap-2 px-4 py-2 bg-[#f97316] text-white rounded-lg hover:bg-[#ea580c]">
                                <span class="material-icons-round">download</span>
                                Descargar PDF
                            </a>
                            <% } %>
                        </div>
                        
                        <% if (communique.description) { %>
                        <div class="mt-4 p-4 bg-blue-50 border-l-4 border-blue-500 rounded-r-lg">
                            <p class="text-[#5F6368] italic"><%= communique.description %></p>
                        </div>
                        <% } %>
                    </div>

                    <!-- Content -->
                    <div class="communique-container bg-white rounded-xl shadow-sm p-8 md:p-12">
                        <% if (communique.file_type === 'pdf') { %>
                            <div class="text-center py-12">
                                <span class="material-icons-round text-6xl text-red-500 mb-4">picture_as_pdf</span>
                                <h3 class="text-xl font-medium text-[#3C4043] mb-2">Documento PDF</h3>
                                <p class="text-[#5F6368] mb-6">Este comunicado está disponible como archivo PDF</p>
                                <a href="/uploads/communiques/<%= communique.filename %>" 
                                   target="_blank"
                                   class="inline-flex items-center gap-2 px-6 py-3 bg-[#f97316] text-white rounded-lg hover:bg-[#ea580c]">
                                    <span class="material-icons-round">visibility</span>
                                    Ver PDF
                                </a>
                            </div>
                        <% } else { %>
                            <div class="communique-content">
                                <%- communique.html_content %>
                            </div>
                        <% } %>
                    </div>

                    <!-- Footer -->
                    <div class="mt-8 text-center text-[#9AA0A6] text-sm no-print">
                        <p>Este comunicado fue emitido por la Junta de Condominio</p>
                        <p class="mt-1">Sistema Condominio360</p>
                    </div>
                </div>
            </main>
            <%- include('../../partials/panels-footer') %>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        
        // Verificar autenticación
        if (!token) {
            window.location.href = '/login';
        }

        function logout() {
            localStorage.clear();
            window.location.href = '/login';
        }
    </script>
</body>
</html>
