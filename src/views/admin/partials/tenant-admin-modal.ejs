    <!-- Administración del condominio — modal unificado -->
    <div id="tenant-admin-modal" class="modal-overlay">
        <div class="modal-content modal-content-lg p-0 flex flex-col">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 flex-shrink-0 sticky top-0 bg-white z-10 rounded-t-2xl">
                <div>
                    <h2 class="text-xl font-bold text-slate-900">Administración del condominio</h2>
                    <p class="text-sm text-slate-500 mt-0.5"><%= tenant.name %></p>
                </div>
                <button type="button" onclick="closeModal('tenant-admin-modal')" class="p-2 hover:bg-slate-100 rounded-full" aria-label="Cerrar">
                    <span class="material-symbols-rounded">close</span>
                </button>
            </div>

            <div class="px-6 py-5 overflow-y-auto flex-1">
                <!-- Logo -->
                <section class="tenant-admin-section">
                    <h3 class="tenant-admin-section-title">
                        <span class="material-symbols-rounded text-orange-500">image</span>
                        Logo del conjunto
                    </h3>
                    <p class="text-sm text-slate-500 mb-4">Aparece en los comprobantes PDF de recibos. JPG o PNG, fondo claro recomendado.</p>
                    <div class="flex flex-col sm:flex-row gap-6">
                        <div id="tenant-logo-preview-wrap" class="tenant-logo-preview-box rounded-xl border border-dashed border-slate-200 flex items-center justify-center">
                            <% if (tenant.logo_path) { %>
                            <img id="tenant-logo-preview" src="/uploads/<%= tenant.logo_path %>" alt="Logo">
                            <% } else { %>
                            <img id="tenant-logo-preview" src="" alt="" class="hidden">
                            <span id="tenant-logo-placeholder" class="material-symbols-rounded text-4xl text-slate-300">image</span>
                            <% } %>
                        </div>
                        <div class="flex-1 flex flex-wrap gap-2 items-start">
                            <input type="file" id="tenant-logo-input" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="hidden">
                            <button type="button" onclick="document.getElementById('tenant-logo-input').click()" class="md-button md-button-tonal">
                                <span class="material-symbols-rounded">upload</span>
                                Elegir imagen
                            </button>
                            <button type="button" id="tenant-logo-upload-btn" onclick="uploadTenantLogo()" class="md-button md-button-filled" disabled>
                                <span class="material-symbols-rounded">save</span>
                                Guardar logo
                            </button>
                            <button type="button" id="tenant-logo-delete-btn" onclick="deleteTenantLogo()" class="md-button bg-red-50 text-red-600 hover:bg-red-100<%= tenant.logo_path ? '' : ' hidden' %>">
                                <span class="material-symbols-rounded">delete</span>
                                Quitar
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Tarifa SaaS -->
                <section class="tenant-admin-section">
                    <h3 class="tenant-admin-section-title">
                        <span class="material-symbols-rounded text-orange-500">payments</span>
                        Tarifa Condominio360 (SaaS)
                    </h3>
                    <p class="text-sm text-slate-500 mb-4">Precio por inmueble al facturar la plataforma. Vacío = $0.50 USD global.</p>
                    <div class="flex flex-col sm:flex-row sm:items-end gap-3 max-w-lg">
                        <div class="flex-1">
                            <label for="saas-unit-price-input" class="block text-sm font-medium text-slate-700 mb-1">USD por inmueble</label>
                            <input type="number" step="0.01" min="0" id="saas-unit-price-input"
                                value="<%= tenant.saas_unit_price_usd != null && tenant.saas_unit_price_usd !== '' ? parseFloat(tenant.saas_unit_price_usd) : '' %>"
                                placeholder="0.50 (predeterminado)"
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg text-slate-900">
                        </div>
                        <button type="button" onclick="saveSaasUnitPrice()" class="md-button md-button-filled whitespace-nowrap">
                            <span class="material-symbols-rounded">save</span>
                            Guardar tarifa
                        </button>
                    </div>
                </section>

                <!-- WhatsApp -->
                <section class="tenant-admin-section">
                    <h3 class="tenant-admin-section-title">
                        <span class="material-symbols-rounded text-teal-600">chat</span>
                        WhatsApp — Mensajes
                    </h3>
                    <p class="text-sm text-slate-600 mb-4">OpenWA: sesión por condominio. URL/API key en <code class="bg-slate-100 px-1 rounded">.env</code> del servidor.</p>
                    <div class="space-y-4 max-w-2xl">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" id="wa-enabled" class="w-5 h-5 rounded border-slate-300 text-orange-500 focus:ring-orange-500">
                            <span class="font-medium text-slate-900">Servicio contratado / habilitado</span>
                        </label>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Session ID OpenWA</label>
                            <input type="text" id="wa-session-id" placeholder="sess_abc123 o c360-demo"
                                class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 text-sm font-mono">
                            <p class="text-xs text-slate-500 mt-1">Sesión con QR escaneado en el dashboard OpenWA.</p>
                        </div>
                        <button type="button" onclick="saveWhatsAppSettings()" class="md-button md-button-filled">
                            <span class="material-symbols-rounded">save</span>
                            Guardar WhatsApp
                        </button>
                    </div>
                </section>

                <!-- Módulos del portal -->
                <section class="tenant-admin-section">
                    <h3 class="tenant-admin-section-title">
                        <span class="material-symbols-rounded text-indigo-600">tune</span>
                        Módulos del portal
                    </h3>
                    <p class="text-sm text-slate-600 mb-4">Active solo los servicios que el condominio utiliza. Los desactivados no aparecerán para propietarios, junta ni vigilancia.</p>
                    <div class="space-y-4 max-w-2xl">
                        <label class="flex items-start gap-3 cursor-pointer p-4 border border-slate-200 rounded-xl hover:bg-slate-50">
                            <input type="checkbox" id="pf-visits-enabled" class="w-5 h-5 mt-0.5 rounded border-slate-300 text-orange-500 focus:ring-orange-500">
                            <span>
                                <span class="font-medium text-slate-900 block">Anuncio de Visitas</span>
                                <span class="text-sm text-slate-500">Panel propietario, vigilancia y reportes.</span>
                            </span>
                        </label>
                        <label class="flex items-start gap-3 cursor-pointer p-4 border border-slate-200 rounded-xl hover:bg-slate-50">
                            <input type="checkbox" id="pf-deliveries-enabled" class="w-5 h-5 mt-0.5 rounded border-slate-300 text-orange-500 focus:ring-orange-500">
                            <span>
                                <span class="font-medium text-slate-900 block">Anuncio de Deliveries</span>
                                <span class="text-sm text-slate-500">Panel propietario, vigilancia y reportes.</span>
                            </span>
                        </label>
                        <label class="flex items-start gap-3 cursor-pointer p-4 border border-slate-200 rounded-xl hover:bg-slate-50">
                            <input type="checkbox" id="pf-vehicle-enabled" class="w-5 h-5 mt-0.5 rounded border-slate-300 text-orange-500 focus:ring-orange-500">
                            <span>
                                <span class="font-medium text-slate-900 block">Acceso Vehicular (NFC)</span>
                                <span class="text-sm text-slate-500">Tarjetas NFC, registro en vigilancia e historial para propietarios.</span>
                            </span>
                        </label>
                        <label class="flex items-start gap-3 cursor-pointer p-4 border border-slate-200 rounded-xl hover:bg-slate-50">
                            <input type="checkbox" id="pf-common-areas-enabled" class="w-5 h-5 mt-0.5 rounded border-slate-300 text-orange-500 focus:ring-orange-500">
                            <span>
                                <span class="font-medium text-slate-900 block">Áreas Comunes</span>
                                <span class="text-sm text-slate-500">Reservas de espacios compartidos para propietarios y gestión en junta.</span>
                            </span>
                        </label>
                        <button type="button" onclick="savePortalFeaturesSettings()" class="md-button md-button-filled">
                            <span class="material-symbols-rounded">save</span>
                            Guardar módulos
                        </button>
                    </div>
                </section>
            </div>

            <div class="px-6 py-4 border-t border-slate-200 flex-shrink-0 bg-slate-50 rounded-b-2xl">
                <button type="button" onclick="closeModal('tenant-admin-modal')" class="w-full px-4 py-3 border border-slate-300 text-slate-700 font-medium hover:bg-white rounded-xl transition-colors">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
