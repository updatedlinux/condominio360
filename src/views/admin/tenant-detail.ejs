            el.innerHTML = '<span class="material-symbols-rounded text-[14px]">image</span> ' + (hasLogo ? 'Logo configurado' : 'Sin logo');
        }

        function updateAdminCardSaasStatus(value) {
            const el = document.getElementById('admin-card-saas-status');
            if (!el) return;
            const raw = value !== undefined && value !== null ? String(value).trim() : '';
            const label = raw !== '' && Number.isFinite(parseFloat(raw))
                ? '$' + parseFloat(raw).toFixed(2) + '/und.'
                : '$0.50/und. (default)';
            el.innerHTML = '<span class="material-symbols-rounded text-[14px]">payments</span> ' + label;
        }

        async function refreshTenantAdminCardSummary() {
            const waEl = document.getElementById('admin-card-whatsapp-status');
            const pfEl = document.getElementById('admin-card-portal-status');
            try {
                const [waRes, pfRes] = await Promise.all([
                    fetch(`/api/admin/tenants/${tenantId}/whatsapp-messaging`, { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch(`/api/admin/tenants/${tenantId}/portal-features`, { headers: { 'Authorization': `Bearer ${token}` } })
                ]);
                const waJ = await waRes.json().catch(() => ({}));
                const pfJ = await pfRes.json().catch(() => ({}));
                if (waEl && waRes.ok && waJ.data) {
                    waEl.textContent = whatsAppSummaryText(waJ.data);
                } else if (waEl) {
                    waEl.textContent = 'WhatsApp N/D';
                }
                if (pfEl && pfRes.ok && pfJ.data) {
                    pfEl.textContent = portalFeaturesSummaryText(pfJ.data);
                } else if (pfEl) {
                    pfEl.textContent = 'Portería N/D';
                }
            } catch (_) {
                if (waEl) waEl.textContent = 'WhatsApp N/D';
                if (pfEl) pfEl.textContent = 'Portería N/D';
            }
        }

