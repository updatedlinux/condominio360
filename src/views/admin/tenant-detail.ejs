            const confirmMsg = selectedNewBuildingType === 'MULTIPLE' 
                ? '¿Cambiar a múltiples edificios/calles? Deberá crear al menos uno y asignar los inmuebles.'
                : '¿Cambiar a edificio/calle único? Todos los inmuebles se asociarán al edificio/calle principal.';

