    <script src="/js/page-notifications.js?v=2"></script>

    <script>
        const token = localStorage.getItem('token');
        const tenantId = '<%= tenant.id %>';
        let currentBuildingType = '<%= tenant.building_type %>';
        let selectedNewBuildingType = null;
        let buildings = [];
        let buildingsListExpanded = true;

        if (!token) {
            window.location.href = '/login';
        }

        function switchToTenantAdmin(tenantId) {
            window.open('/admin/impersonate-tenant/' + tenantId, '_blank', 'noopener,noreferrer');
        }

        let tenantLogoFile = null;
        const tenantLogoInput = document.getElementById('tenant-logo-input');
        if (tenantLogoInput) {
            tenantLogoInput.addEventListener('change', (e) => {
                const file = e.target.files && e.target.files[0];
                tenantLogoFile = file || null;
                const uploadBtn = document.getElementById('tenant-logo-upload-btn');
                if (uploadBtn) uploadBtn.disabled = !tenantLogoFile;
                if (!file) return;
                const reader = new FileReader();
                reader.onload = () => {
                    const img = document.getElementById('tenant-logo-preview');
                    const ph = document.getElementById('tenant-logo-placeholder');
                    if (img) {
                        img.src = reader.result;
                        img.removeAttribute('width');
                        img.removeAttribute('height');
                        img.classList.remove('hidden');
                    }
                    if (ph) ph.classList.add('hidden');
                };
                reader.readAsDataURL(file);
            });
        }

        async function saveSaasUnitPrice() {
            const raw = document.getElementById('saas-unit-price-input').value.trim();
            let saas_unit_price_usd = null;
            if (raw !== '') {
                saas_unit_price_usd = parseFloat(raw);
                if (!Number.isFinite(saas_unit_price_usd) || saas_unit_price_usd < 0) {
                    showPageToast('Ingrese un monto válido (≥ 0)', 'error');
                    return;
                }
            }
            try {
                const res = await fetch(`/api/admin/tenants/${tenantId}`, {
                    method: 'PUT',
