        function updateBuildingTypeSelection() {
            document.querySelectorAll('.building-type-option').forEach(el => {
                const type = el.dataset.type;
                const icon = document.getElementById(`icon-${type}`);
                if (type === selectedNewBuildingType) {
                    el.classList.add('border-orange-500', 'bg-orange-50');
                    el.classList.remove('border-slate-200');
                    icon.textContent = 'radio_button_checked';
                    icon.classList.add('text-orange-600');
                    icon.classList.remove('text-slate-400');
                } else {
                    el.classList.remove('border-orange-500', 'bg-orange-50');
                    el.classList.add('border-slate-200');
                    icon.textContent = 'radio_button_unchecked';
                    icon.classList.remove('text-orange-600');
                    icon.classList.add('text-slate-400');
                }
            });
