<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= tenant.name %> | Condominio360</title>
    <link href="/css/output.css" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/assets/images/isotipo-naranja.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
    <style>
        * { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
        :root {
            --md-sys-color-primary: #f97316;
            --md-sys-color-on-primary: #ffffff;
            --md-sys-color-primary-container: #fff7ed;
            --md-sys-color-on-primary-container: #9a3412;
            --md-sys-color-secondary: #50606e;
            --md-sys-color-on-secondary: #ffffff;
            --md-sys-color-secondary-container: #d3e5f5;
            --md-sys-color-on-secondary-container: #0c1d29;
            --md-sys-color-surface: #fdfcff;
            --md-sys-color-surface-variant: #dfe2eb;
            --md-sys-color-on-surface: #1a1c1e;
            --md-sys-color-on-surface-variant: #43474e;
            --md-sys-color-outline: #73777f;
            --md-sys-color-error: #ba1a1a;
            --md-sys-color-error-container: #ffdad6;
            --md-elevation-1: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.14);
            --md-elevation-2: 0 3px 6px rgba(0,0,0,0.15), 0 2px 4px rgba(0,0,0,0.12);
            --md-elevation-3: 0 10px 20px rgba(0,0,0,0.15), 0 3px 6px rgba(0,0,0,0.10);
            --md-radius-small: 8px;
            --md-radius-medium: 12px;
            --md-radius-large: 16px;
        }
        
        .nav-rail {
            background: var(--md-sys-color-surface);
            border-right: 1px solid var(--md-sys-color-surface-variant);
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .nav-rail.collapsed { width: 80px; }
        .nav-rail.expanded { width: 300px; }
        .nav-rail { transition: width 0.3s ease, transform 0.3s ease; }
        .mobile-hamburger-btn { display: none; }
        @media (max-width: 1023px) {
            .nav-rail { transform: translateX(-100%); width: 280px !important; }
            .nav-rail.mobile-open { transform: translateX(0); }
            #main-content { margin-left: 0 !important; }
            .admin-mobile-overlay { display: none; }
            .admin-mobile-overlay.active { display: block; }
            .mobile-hamburger-btn { display: flex !important; }
        }
        @media (min-width: 1024px) {
            main#main-content { margin-left: 300px; transition: margin-left 0.3s; }
            aside.nav-rail.collapsed ~ main#main-content { margin-left: 80px; }
        }
        
        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 24px;
            margin: 4px 12px;
            border-radius: var(--md-radius-large);
            color: var(--md-sys-color-on-surface-variant);
            transition: all 0.2s;
            cursor: pointer;
            position: relative;
            text-decoration: none;
        }
        
        .nav-item:hover { background: rgba(249, 115, 22, 0.08); }
        .nav-item.active {
            background: var(--md-sys-color-primary-container);
            color: var(--md-sys-color-on-primary-container);
        }

        .nav-item .icon {
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-item .label {
            font-size: 14px;
            font-weight: 500;
            white-space: nowrap;
            opacity: 1;
            transition: opacity 0.2s;
        }

        .nav-rail.collapsed .nav-item .label {
            opacity: 0;
            width: 0;
        }
        
        .md-card {
            background: var(--md-sys-color-surface);
            border-radius: var(--md-radius-large);
            box-shadow: var(--md-elevation-1);
        }

        /* Vista previa logo: evita que imágenes grandes rompan el layout (flex min-height:auto) */
        .tenant-logo-preview-box {
            width: 160px;
            height: 112px;
            min-width: 160px;
            min-height: 0;
            max-width: 160px;
            max-height: 112px;
            overflow: hidden;
            flex-shrink: 0;
            position: relative;
            background: #fff;
        }
        .tenant-logo-preview-box img:not(.hidden) {
            position: absolute;
            inset: 0;
            margin: auto;
            width: auto;
            height: auto;
            max-width: calc(100% - 8px);
            max-height: calc(100% - 8px);
            object-fit: contain;
            object-position: center;
        }
        
        .md-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: 28px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
        }
        
        .md-button-filled {
            background: var(--md-sys-color-primary);
            color: var(--md-sys-color-on-primary);
        }
        
        .md-button-tonal {
            background: var(--md-sys-color-secondary-container);
            color: var(--md-sys-color-on-secondary-container);
        }
        
        .md-button-text {
            background: transparent;
            color: var(--md-sys-color-primary);
            padding: 10px 12px;
        }
        
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
            z-index: 100;
            display: none;
        }
        
        .modal-overlay.active { display: flex; align-items: center; justify-content: center; }
        
        .modal-content {
            background: white;
            border-radius: var(--md-radius-large);
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: var(--md-elevation-3);
        }

        .modal-content.modal-content-lg {
            max-width: 920px;
            max-height: 92vh;
        }

        .modal-content.modal-content-xl {
            max-width: min(1100px, 96vw);
            max-height: 94vh;
        }

        #junta-email-editor .ql-editor { min-height: 200px; font-size: 15px; line-height: 1.65; }
        #junta-email-editor .ql-container.ql-snow { position: relative; }
        #junta-email-editor .ql-editor img { max-width: 100%; height: auto; cursor: pointer; }
        #junta-email-editor .ql-editor img.junta-img-selected {
            outline: 2px solid #f97316;
            outline-offset: 2px;
        }
        .junta-img-resize-toolbar {
            position: absolute;
            z-index: 20;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            background: #0f172a;
            color: #fff;
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.25);
            font-size: 12px;
            max-width: calc(100% - 16px);
        }
        .junta-img-resize-toolbar.hidden { display: none; }
        .junta-img-resize-toolbar input[type="range"] { width: 120px; accent-color: #f97316; cursor: pointer; }
        .junta-img-resize-toolbar button {
            padding: 4px 8px;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            font-size: 11px;
            cursor: pointer;
        }
        .junta-img-resize-toolbar button:hover { background: rgba(255, 255, 255, 0.16); }
        .junta-img-resize-handle {
            position: absolute;
            z-index: 19;
            width: 12px;
            height: 12px;
            background: #f97316;
            border: 2px solid #fff;
            border-radius: 3px;
            cursor: nwse-resize;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
        }
        .junta-img-resize-handle.hidden { display: none; }
        #junta-email-editor .ql-toolbar.ql-snow { border-radius: 12px 12px 0 0; border-color: #e2e8f0; background: #f8fafc; }
        #junta-email-editor .ql-container.ql-snow { border-radius: 0 0 12px 12px; border-color: #e2e8f0; background: #fff; }
        .junta-email-chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 9999px; font-size: 12px; color: #334155; }
        .junta-email-chip button { line-height: 1; padding: 0 2px; color: #94a3b8; background: none; border: none; cursor: pointer; }
        .junta-email-chip button:hover { color: #ef4444; }

        .junta-email-send-overlay {
            position: absolute;
            inset: 0;
            z-index: 40;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.92);
            border-radius: inherit;
            pointer-events: all;
        }
        .junta-email-send-overlay.active { display: flex; }
        .junta-email-send-overlay-text {
            margin: 12px 0 0;
            font-size: 14px;
            font-weight: 600;
            color: #334155;
        }
        .junta-email-send-overlay-subtext {
            margin: 0;
            font-size: 12px;
            color: #64748b;
        }
        .junta-email-send-spinner {
            width: 44px;
            height: 44px;
            border: 4px solid #fed7aa;
            border-top-color: #f97316;
            border-radius: 50%;
            animation: junta-email-spin 0.8s linear infinite;
            flex-shrink: 0;
        }
        #junta-email-send-btn .junta-email-send-spinner {
            width: 18px;
            height: 18px;
            border-width: 2px;
        }
        @keyframes junta-email-spin {
            to { transform: rotate(360deg); }
        }
        .junta-email-modal-sending .modal-content { pointer-events: none; }
        .junta-email-modal-sending .junta-email-send-overlay { pointer-events: all; }

        .tenant-admin-section {
            padding: 1.25rem 0;
            border-bottom: 1px solid #e2e8f0;
        }
        .tenant-admin-section:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        .tenant-admin-section:first-child {
            padding-top: 0;
        }
        .tenant-admin-section-title {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.75rem;
        }
        .tenant-admin-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.625rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            background: #f1f5f9;
            color: #475569;
        }
        .tenant-admin-card-btn {
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .tenant-admin-card-btn:hover {
            border-color: rgba(249, 115, 22, 0.45);
            box-shadow: var(--md-elevation-2);
        }
    </style>
</head>
<body class="bg-slate-50">
    <div id="admin-mobile-overlay" class="admin-mobile-overlay fixed inset-0 bg-black/50 z-30 lg:hidden" onclick="toggleAdminMobileSidebar()"></div>
    <div class="h-screen flex overflow-hidden">
        <!-- Navigation Rail / Sidebar -->
        <aside id="sidebar" class="nav-rail expanded fixed h-full z-40 flex flex-col">
            <!-- Logo Section -->
            <div class="px-5 pl-6 py-4 flex items-center gap-4 h-16">
                <button id="menu-toggle" class="hidden lg:flex w-12 h-12 items-center justify-center rounded-full hover:bg-gray-100 transition">
                    <span class="material-symbols-rounded text-slate-700">menu</span>
                </button>
                <button onclick="toggleAdminMobileSidebar()" class="lg:hidden flex w-12 h-12 items-center justify-center rounded-full hover:bg-gray-100 transition">
                    <span class="material-symbols-rounded text-slate-700">close</span>
                </button>
                <div class="flex items-center gap-3 flex-1 min-w-0">
                    <img src="/assets/images/isotipo-naranja.svg" alt="" class="h-10 w-10 flex-shrink-0" style="object-fit: contain;">
                    <div class="whitespace-nowrap flex-shrink-0">
                        <h1 class="font-bold text-slate-900 text-lg leading-tight tracking-tight">Condominio360</h1>
                        <p class="text-xs text-slate-500">Super Admin</p>
                    </div>
                </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-gray-200 mx-4"></div>

            <%- include('../partials/superadmin-sidebar', { activePage: 'tenants' }) %>

            <!-- Bottom Actions -->
            <div class="p-4 border-t border-gray-200">
                <div class="nav-item text-red-600 hover:bg-red-50" onclick="logout()">
                    <span class="icon material-symbols-rounded">logout</span>
                    <span class="label">Cerrar sesión</span>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main id="main-content" class="flex-1 min-h-0 transition-all duration-300 flex flex-col overflow-hidden">
            <!-- Header -->
            <header class="bg-white shadow-sm sticky top-0 z-10 flex-shrink-0">
                <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <button onclick="toggleAdminMobileSidebar()" class="mobile-hamburger-btn w-10 h-10 rounded-full hover:bg-slate-100 flex items-center justify-center transition" aria-label="Abrir menú">
                            <span class="material-symbols-rounded text-slate-600">menu</span>
                        </button>
                        <a href="/admin" class="p-2 hover:bg-gray-100 rounded-full inline-flex">
                            <span class="material-symbols-rounded">arrow_back</span>
                        </a>
                        <div>
                            <h1 class="text-2xl font-bold text-gray-900"><%= tenant.name %></h1>
                            <p class="text-sm text-gray-500">Slug: <%= tenant.slug %></p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <button onclick="switchToTenantAdmin('<%= tenant.id %>')" class="md-button md-button-filled">
                            <span class="material-symbols-rounded">open_in_new</span>
                            Ver panel de junta
                        </button>
                        <button onclick="editTenant('<%= tenant.id %>')" class="md-button md-button-tonal">
                            <span class="material-symbols-rounded">edit</span>
                            Editar
                        </button>
                        <button onclick="toggleTenantStatus('<%= tenant.id %>', <%= tenant.active === false ? 'false' : 'true' %>)" 
                            class="md-button <%= tenant.active === false ? 'md-button-filled' : 'bg-red-100 text-red-600 hover:bg-red-200' %>">
                            <span class="material-symbols-rounded"><%= tenant.active === false ? 'check_circle' : 'pause_circle' %></span>
                            <%= tenant.active === false ? 'Activar' : 'Suspender' %>
                        </button>
                    </div>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto">
            <div class="p-6 max-w-7xl mx-auto">
                <!-- Stats Grid -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
                    <div class="md-card p-6 border border-slate-100 hover:border-orange-200/60 hover:shadow-md transition">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center">
                                <span class="material-symbols-rounded text-orange-600">home</span>
                            </div>
                            <span class="text-sm text-slate-500">Unidades</span>
                        </div>
                        <p class="text-3xl font-bold text-slate-900"><%= stats.properties %></p>
                    </div>
                    <div class="md-card p-6 border border-slate-100 hover:border-orange-200/60 hover:shadow-md transition">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                                <span class="material-symbols-rounded text-emerald-600">people</span>
                            </div>
                            <span class="text-sm text-slate-500">Propietarios</span>
                        </div>
                        <p class="text-3xl font-bold text-slate-900"><%= stats.owners %></p>
                    </div>
                    <div class="md-card p-6 border border-slate-100 hover:border-orange-200/60 hover:shadow-md transition">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                                <span class="material-symbols-rounded text-amber-600">admin_panel_settings</span>
                            </div>
                            <span class="text-sm text-slate-500">Admins</span>
                        </div>
                        <p class="text-3xl font-bold text-slate-900"><%= admins.length %></p>
                    </div>
                    <div class="md-card p-6 border border-slate-100 hover:border-orange-200/60 hover:shadow-md transition">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center">
                                <span class="material-symbols-rounded text-orange-600">receipt</span>
                            </div>
                            <span class="text-sm text-slate-500">Facturación</span>
                        </div>
                        <p class="text-lg font-bold text-slate-900"><%= tenant.billing_type === 'ALICUOTA' ? 'Por Alícuota' : 'Cuota Fija' %></p>
                        <p class="text-xs mt-1 <%= tenant.billing_mode === 'FULL' ? 'text-emerald-600' : 'text-amber-600' %> font-medium">
                            <%= tenant.billing_mode === 'FULL' ? '● Modo Completo' : '● Modo Apoyo' %>
                        </p>
                    </div>
                </div>

                <!-- Administración del condominio (resumen) -->
                <button type="button" onclick="openTenantAdminModal()" class="tenant-admin-card-btn md-card p-5 sm:p-6 border border-slate-100 shadow-sm mb-6">
                    <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-rounded text-2xl text-slate-600">tune</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h2 class="text-lg font-bold text-slate-900">Administración del condominio</h2>
                            <p class="text-sm text-slate-500 mt-0.5">Logo en recibos, tarifa SaaS, WhatsApp y módulos de portería</p>
                            <div class="flex flex-wrap gap-2 mt-3">
                                <span class="tenant-admin-chip" id="admin-card-logo-status">
                                    <span class="material-symbols-rounded text-[14px]">image</span>
                                    <%= tenant.logo_path ? 'Logo configurado' : 'Sin logo' %>
                                </span>
                                <span class="tenant-admin-chip" id="admin-card-saas-status">
                                    <span class="material-symbols-rounded text-[14px]">payments</span>
                                    <% const saasDisplay = tenant.saas_unit_price_usd != null && tenant.saas_unit_price_usd !== '' ? '$' + parseFloat(tenant.saas_unit_price_usd).toFixed(2) + '/und.' : '$0.50/und. (default)' %>
                                    <%= saasDisplay %>
                                </span>
                                <span class="tenant-admin-chip" id="admin-card-whatsapp-status">WhatsApp…</span>
                                <span class="tenant-admin-chip" id="admin-card-portal-status">Portería…</span>
                            </div>
                        </div>
                        <span class="material-symbols-rounded text-slate-400 text-3xl flex-shrink-0 hidden sm:block">chevron_right</span>
                    </div>
                </button>

                <!-- Grid: Info | Acciones | Edificios | Admins -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    
                    <!-- Información General -->
                    <div class="md-card p-6 border border-slate-100 shadow-sm overflow-hidden flex flex-col min-h-0">
                        <h2 class="text-lg font-bold text-slate-900 mb-5">Información General</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-50/80 border border-slate-100">
                                <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-rounded text-orange-600">apartment</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Tipo de Conjunto</p>
                                    <p class="font-semibold text-slate-900 mt-0.5"><%= tenant.building_type === 'MULTIPLE' ? 'Múltiples Edificios/Calles' : 'Edificio/Calle único' %></p>
                                    <span class="inline-block mt-2 px-2.5 py-1 rounded-lg text-xs font-semibold <%= tenant.building_type === 'MULTIPLE' ? 'bg-orange-100 text-orange-700' : 'bg-emerald-100 text-emerald-700' %>">
                                        <%= tenant.building_type === 'MULTIPLE' ? 'MULTI-EDIFICIO/CALLE' : 'MONO-EDIFICIO/CALLE' %>
                                    </span>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-50/80 border border-slate-100">
                                <div class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-rounded text-orange-600">receipt</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Facturación</p>
                                    <p class="font-semibold text-slate-900 mt-0.5"><%= tenant.billing_type === 'ALICUOTA' ? 'Por Alícuota' : 'Cuota Fija' %></p>
                                    <p class="text-xs mt-1 font-medium <%= tenant.billing_mode === 'FULL' ? 'text-emerald-600' : 'text-amber-600' %>">
                                        <%= tenant.billing_mode === 'FULL' ? '● Modo Completo' : '● Modo Apoyo' %>
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-50/80 border border-slate-100 sm:col-span-2">
                                <div class="w-10 h-10 rounded-xl <%= tenant.active !== false ? 'bg-emerald-100' : 'bg-red-100' %> flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-rounded <%= tenant.active !== false ? 'text-emerald-600' : 'text-red-600' %>">check_circle</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Estado</p>
                                    <p class="font-semibold <%= tenant.active !== false ? 'text-emerald-700' : 'text-red-700' %>"><%= tenant.active !== false ? 'Activo' : 'Suspendido' %></p>
                                </div>
                            </div>
                        </div>
                        <div class="flex-1 flex items-center justify-center pt-6 mt-6 border-t border-slate-100">
