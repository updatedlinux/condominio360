                            <span class="material-symbols-rounded text-lg">edit</span>
                        </button>
                        <button onclick="deleteBuilding('${b.id}')" class="inline-flex p-2 rounded-lg text-red-600 hover:bg-red-50 transition">
                            <span class="material-symbols-rounded text-lg">delete</span>
                        </button>
                    </td>
                </tr>
            `).join('');
        }

