        function portalFeaturesSummaryText(data) {
            const v = data.visits_announcements_enabled ? 'Visitas ✓' : 'Visitas ✗';
            const d = data.deliveries_announcements_enabled ? 'Deliveries ✓' : 'Deliveries ✗';
            const veh = data.vehicle_access_enabled ? 'Vehicular ✓' : 'Vehicular ✗';
            const areas = data.common_areas_enabled ? 'Áreas ✓' : 'Áreas ✗';
            return `${v} · ${d} · ${veh} · ${areas}`;
        }

        function whatsAppSummaryText(data) {
            if (!data?.enabled) return 'WhatsApp inactivo';
            return data.hasSessionId ? 'WhatsApp activo (OpenWA)' : 'WhatsApp (sin sesión)';
        }

        function updateAdminCardLogoStatus(hasLogo) {
            const el = document.getElementById('admin-card-logo-status');
