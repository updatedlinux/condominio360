            if (!countEl) return;
            const n = buildings.length;
            countEl.textContent = n === 0 ? '(ninguno)' : `(${n} edificio/calle${n !== 1 ? 's' : ''})`;
        }

        function toggleBuildingsList() {
            buildingsListExpanded = !buildingsListExpanded;
            const content = document.getElementById('buildings-list-content');
            const chevron = document.getElementById('buildings-chevron');
            if (content) content.classList.toggle('hidden', !buildingsListExpanded);
            if (chevron) chevron.textContent = buildingsListExpanded ? 'expand_less' : 'expand_more';
        }

        function renderBuildingsTable() {
            const tbody = document.getElementById('buildings-table-body');
            updateBuildingsCount();
            if (buildings.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-8 text-center text-slate-400">
                            No hay edificios/calles registrados
                            ${currentBuildingType === 'MULTIPLE' ? '<br><button onclick="addBuilding()" class="text-orange-600 font-semibold hover:underline mt-2">Agregar el primer edificio/calle</button>' : ''}
                        </td>
                    </tr>
                `;
                document.getElementById('buildings-list-content')?.classList.remove('hidden');
                return;
            }
            buildingsListExpanded = buildings.length <= 6;
            document.getElementById('buildings-list-content')?.classList.toggle('hidden', !buildingsListExpanded);
            document.getElementById('buildings-chevron').textContent = buildingsListExpanded ? 'expand_less' : 'expand_more';

            tbody.innerHTML = buildings.map(b => `
                <tr class="hover:bg-slate-50/50 transition">
                    <td class="py-3 px-4 font-medium text-slate-900">${b.name}</td>
                    <td class="py-3 px-4 text-slate-600">${b.code || '-'}</td>
                    <td class="py-3 px-4 text-slate-600">${b.floors || '-'}</td>
                    <td class="py-3 px-4">
