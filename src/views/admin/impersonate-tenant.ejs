<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abriendo panel de junta...</title>
    <style>
        * { font-family: system-ui, sans-serif; }
        body { display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; background: #fafafa; }
        .box { text-align: center; padding: 2rem; }
        .spinner { width: 48px; height: 48px; border: 4px solid #e5e7eb; border-top-color: #f97316; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 1rem; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .error { color: #dc2626; margin-top: 1rem; }
    </style>
    <script src="/js/session-expired.js"></script>
</head>
<body>
    <div class="box">
        <div id="spinner" class="spinner"></div>
        <p id="msg">Abriendo panel de junta...</p>
        <p id="err" class="error hidden"></p>
    </div>
    <script>
        (async function() {
            const tenantId = '<%= tenantId %>';
            const token = localStorage.getItem('token');
            if (!token || !tenantId) {
                document.getElementById('spinner').style.display = 'none';
                document.getElementById('msg').textContent = '';
                document.getElementById('err').textContent = 'Sesión inválida o parámetros faltantes.';
                document.getElementById('err').classList.remove('hidden');
                return;
            }
            try {
                const res = await fetch('/api/auth/select-tenant', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ tenantId })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Error');
                // Guardar en sessionStorage (solo esta pestaña) - NO tocar localStorage para mantener sesión superadmin en pestaña original
                sessionStorage.setItem('token', data.token);
                if (data.user) sessionStorage.setItem('user', JSON.stringify(data.user));
                if (data.tenant) sessionStorage.setItem('tenant', JSON.stringify(data.tenant));
                sessionStorage.setItem('impersonating', '1');
                window.location.replace('/tenant-admin');
            } catch (e) {
                document.getElementById('spinner').style.display = 'none';
                document.getElementById('msg').textContent = '';
                document.getElementById('err').textContent = e.message || 'Error al cargar el panel.';
                document.getElementById('err').classList.remove('hidden');
            }
        })();
    </script>
</body>
</html>
