<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin | Condominio360</title>
    <link href="/css/output.css" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/assets/images/isotipo-naranja.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
        :root {
            --md-sys-color-primary: #f97316;
            --md-sys-color-on-primary: #ffffff;
            --md-sys-color-primary-container: #fff7ed;
            --md-sys-color-on-primary-container: #9a3412;
            --md-sys-color-secondary: #50606e;
            --md-sys-color-on-secondary: #ffffff;
            --md-sys-color-secondary-container: #d3e5f5;
            --md-sys-color-on-secondary-container: #0c1d29;
            --md-sys-color-surface: #fdfcff;
            --md-sys-color-surface-variant: #dfe2eb;
            --md-sys-color-on-surface: #1a1c1e;
            --md-sys-color-on-surface-variant: #43474e;
            --md-sys-color-outline: #73777f;
            --md-sys-color-error: #ba1a1a;
            --md-sys-color-error-container: #ffdad6;
            --md-elevation-1: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.14);
            --md-elevation-2: 0 3px 6px rgba(0,0,0,0.15), 0 2px 4px rgba(0,0,0,0.12);
            --md-elevation-3: 0 10px 20px rgba(0,0,0,0.15), 0 3px 6px rgba(0,0,0,0.10);
            --md-radius-small: 8px;
            --md-radius-medium: 12px;
            --md-radius-large: 16px;
            --md-radius-extra-large: 28px;
        }
        
        .material-symbols-rounded {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        
        /* Material Ripple Effect */
        .md-ripple {
            position: relative;
            overflow: hidden;
        }
        .md-ripple::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255,255,255,0.3);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.3s, height 0.3s;
        }
        .md-ripple:active::after {
            width: 200%;
            height: 200%;
        }
        
        /* Navigation Rail / Sidebar */
        .nav-rail {
            background: var(--md-sys-color-surface);
            border-right: 1px solid var(--md-sys-color-surface-variant);
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s ease;
        }
        
        .nav-rail.collapsed {
            width: 80px;
        }
        
        .nav-rail.expanded {
            width: 300px;
        }
        
        .mobile-hamburger-btn { display: none; }
        /* Mobile: sidebar oculto por defecto, se desliza al abrir */
        @media (max-width: 1023px) {
            .nav-rail {
                transform: translateX(-100%);
                width: 280px !important;
            }
            .nav-rail.mobile-open {
                transform: translateX(0);
            }
            #main-content {
                margin-left: 0 !important;
            }
            .admin-mobile-overlay {
                display: none;
            }
            .admin-mobile-overlay.active {
                display: block;
            }
            .mobile-hamburger-btn {
                display: flex !important;
            }
        }
        
        /* Desktop: margen del main para que no quede bajo el sidebar fijo */
        @media (min-width: 1024px) {
            main#main-content {
                margin-left: 300px;
                transition: margin-left 0.3s;
            }
            aside.nav-rail.collapsed ~ main#main-content {
                margin-left: 80px;
            }
        }
        
        /* Navigation Items */
        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 24px;
            margin: 4px 12px;
            border-radius: var(--md-radius-large);
            color: var(--md-sys-color-on-surface-variant);
            transition: all 0.2s;
            cursor: pointer;
            position: relative;
        }
        
        .nav-item:hover {
            background: rgba(249, 115, 22, 0.08);
        }
        
        .nav-item.active {
            background: var(--md-sys-color-primary-container);
            color: var(--md-sys-color-on-primary-container);
        }
        
        .nav-item .icon {
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .nav-item .label {
            font-size: 14px;
            font-weight: 500;
            white-space: nowrap;
            opacity: 1;
            transition: opacity 0.2s;
        }
        
        .nav-rail.collapsed .nav-item .label {
            opacity: 0;
            width: 0;
        }
        
        /* FAB (Floating Action Button) */
        .md-fab {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 16px 24px;
            background: var(--md-sys-color-primary-container);
            color: var(--md-sys-color-on-primary-container);
            border-radius: var(--md-radius-extra-large);
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            box-shadow: var(--md-elevation-3);
            transition: all 0.2s;
            cursor: pointer;
            border: none;
        }
        
        .md-fab:hover {
            box-shadow: 0 14px 28px rgba(0,0,0,0.15), 0 10px 10px rgba(0,0,0,0.12);
            transform: translateY(-2px);
        }
        
        /* Cards Material */
        .md-card {
            background: var(--md-sys-color-surface);
            border-radius: var(--md-radius-large);
            box-shadow: var(--md-elevation-1);
            transition: all 0.2s;
        }
        
        .md-card:hover {
            box-shadow: var(--md-elevation-2);
        }
        
        .md-card-filled {
            background: var(--md-sys-color-surface-variant);
            border-radius: var(--md-radius-large);
        }
        
        /* Modal Material */
        .md-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
            z-index: 100;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
        }
        
        .md-modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        .md-modal {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            background: var(--md-sys-color-surface);
            border-radius: var(--md-radius-extra-large);
            box-shadow: var(--md-elevation-3);
            z-index: 101;
            max-width: 560px;
            width: 90%;
            max-height: 90vh;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }
        
        .md-modal.active {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }
        
        /* Text Fields Material */
        .md-text-field {
            position: relative;
            margin-bottom: 16px;
        }
        
        .md-text-field input,
        .md-text-field textarea {
            width: 100%;
            padding: 16px;
            border: 1px solid var(--md-sys-color-outline);
            border-radius: var(--md-radius-small);
            background: transparent;
            font-size: 16px;
            color: var(--md-sys-color-on-surface);
            transition: all 0.2s;
        }
        
        .md-text-field input:focus,
        .md-text-field textarea:focus {
            outline: none;
            border-color: var(--md-sys-color-primary);
            border-width: 2px;
        }
        
        .md-text-field label {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: var(--md-sys-color-surface);
            padding: 0 4px;
            color: var(--md-sys-color-on-surface-variant);
            font-size: 16px;
            transition: all 0.2s;
            pointer-events: none;
        }
        
        .md-text-field input:focus + label,
        .md-text-field input:not(:placeholder-shown) + label,
        .md-text-field textarea:focus + label,
        .md-text-field textarea:not(:placeholder-shown) + label {
            top: 0;
            font-size: 12px;
            color: var(--md-sys-color-primary);
        }
        
        /* Buttons Material */
        .md-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: var(--md-radius-extra-large);
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
        }
        
        .md-button-filled {
            background: var(--md-sys-color-primary);
            color: var(--md-sys-color-on-primary);
        }
        
        .md-button-filled:hover {
            box-shadow: var(--md-elevation-1);
        }
        
        .md-button-filled:disabled {
            background: #9ca3af;
            color: white;
            cursor: not-allowed;
            box-shadow: none;
            opacity: 0.9;
        }

        #wizard-steps-container::-webkit-scrollbar { display: none; }
        #wizard-steps-container { -ms-overflow-style: none; scrollbar-width: none; }
        
        .md-button-tonal {
            background: var(--md-sys-color-secondary-container);
            color: var(--md-sys-color-on-secondary-container);
        }
        
        .md-button-outlined {
            background: transparent;
            color: var(--md-sys-color-primary);
            border: 1px solid var(--md-sys-color-outline);
        }
        
        .md-button-text {
            background: transparent;
            color: var(--md-sys-color-primary);
            padding: 10px 12px;
        }
        
        /* Progress Indicator */
        .md-linear-progress {
            height: 4px;
            background: var(--md-sys-color-surface-variant);
            border-radius: 2px;
            overflow: hidden;
        }
        
        .md-linear-progress-bar {
            height: 100%;
            background: var(--md-sys-color-primary);
            transition: width 0.3s;
        }
        
        /* Segmented Button */
        .md-segmented-button {
            display: flex;
            background: var(--md-sys-color-surface-variant);
            border-radius: var(--md-radius-extra-large);
            padding: 4px;
            gap: 4px;
        }
        
        .md-segment {
            flex: 1;
            padding: 8px 16px;
            border-radius: var(--md-radius-extra-large);
            text-align: center;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            color: var(--md-sys-color-on-surface);
        }
        
        .md-segment.active {
            background: var(--md-sys-color-secondary-container);
            color: var(--md-sys-color-on-secondary-container);
        }
        
        /* Snackbar */
        .md-snackbar {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: var(--md-sys-color-on-surface);
            color: var(--md-sys-color-surface);
            padding: 14px 24px;
            border-radius: var(--md-radius-small);
            font-size: 14px;
            box-shadow: var(--md-elevation-3);
            z-index: 200;
            opacity: 0;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 24px;
        }
        
        .md-snackbar.active {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        /* Modal picker de condominios debe quedar encima del modal Resumen (z-50) */
        #saas-tenant-picker-modal {
            z-index: 9999;
        }
        
        /* Animations */
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .animate-slide-in {
            animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        /* Table Material */
        .md-table-container {
            overflow-x: auto;
            border-radius: var(--md-radius-large);
        }
        
        .md-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .md-table th {
            text-align: left;
            padding: 16px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--md-sys-color-on-surface-variant);
            border-bottom: 1px solid var(--md-sys-color-surface-variant);
        }
        
        .md-table td {
            padding: 16px;
            border-bottom: 1px solid var(--md-sys-color-surface-variant);
            color: var(--md-sys-color-on-surface);
        }
        
        .md-table tr:hover td {
            background: rgba(249, 115, 22, 0.04);
        }
        
        /* Chips */
        .md-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: var(--md-radius-small);
            font-size: 14px;
            font-weight: 500;
        }
        
        .md-chip-filled {
            background: var(--md-sys-color-primary-container);
            color: var(--md-sys-color-on-primary-container);
        }
        
        /* Stats Cards */
        .stat-card {
            padding: 24px;
            border-radius: var(--md-radius-large);
            position: relative;
            overflow: hidden;
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
        }
        
        .stat-card.primary::before { background: var(--md-sys-color-primary); }
        .stat-card.secondary::before { background: var(--md-sys-color-secondary); }
        .stat-card.tertiary::before { background: #6b5b4f; }
        .stat-card.error::before { background: var(--md-sys-color-error); }
        
        /* App Top Bar */
        .app-top-bar {
            background: var(--md-sys-color-surface);
            height: 64px;
            display: flex;
            align-items: center;
            padding: 0 16px;
            gap: 16px;
            box-shadow: var(--md-elevation-1);
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Overlay móvil (ocultar al hacer clic fuera del sidebar) -->
    <div id="admin-mobile-overlay" class="admin-mobile-overlay fixed inset-0 bg-black/50 z-30 lg:hidden" onclick="toggleAdminMobileSidebar()"></div>
    
    <div class="h-screen flex overflow-hidden">
        <!-- Navigation Rail / Sidebar -->
        <aside id="sidebar" class="nav-rail expanded fixed h-full z-40 flex flex-col">
            <!-- Logo Section -->
            <div class="px-5 pl-6 py-4 flex items-center gap-4 h-16">
                <!-- Hamburger/Close: desktop=collapse, mobile=close -->
                <button id="menu-toggle" class="hidden lg:flex w-12 h-12 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                    <span class="material-symbols-rounded text-gray-700">menu</span>
                </button>
                <button onclick="toggleAdminMobileSidebar()" class="lg:hidden flex w-12 h-12 items-center justify-center rounded-full hover:bg-gray-100 transition">
                    <span class="material-symbols-rounded text-gray-700">close</span>
                </button>
                <div class="flex items-center gap-3 flex-1 min-w-0">
                    <img src="/assets/images/isotipo-naranja.svg" alt="" class="h-10 w-10 flex-shrink-0" style="object-fit: contain;">
                    <div class="whitespace-nowrap flex-shrink-0">
                        <h1 class="font-bold text-slate-900 text-lg leading-tight tracking-tight">Condominio360</h1>
                        <p class="text-xs text-gray-500">Super Admin</p>
                    </div>
                </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-gray-200 mx-4"></div>

            <!-- Navigation Items -->
            <nav class="flex-1 py-4 overflow-y-auto">
                <div class="nav-item active" onclick="showSection('dashboard', this)">
                    <span class="icon material-symbols-rounded">space_dashboard</span>
                    <span class="label">Dashboard</span>
                </div>
                <div class="nav-item" onclick="showSection('tenants', this)">
                    <span class="icon material-symbols-rounded">apartment</span>
                    <span class="label">Condominios</span>
                </div>
                <div class="nav-item" onclick="showSection('users', this)">
                    <span class="icon material-symbols-rounded">group</span>
                    <span class="label">Usuarios</span>
                </div>
                <div class="nav-item pl-4 text-sm" onclick="showSection('data-updates', this)">
                    <span class="icon material-symbols-rounded text-lg">edit_note</span>
                    <span class="label">Actualización de Datos</span>
                </div>
                <div class="nav-item" onclick="showSection('audit', this)">
                    <span class="icon material-symbols-rounded">receipt_long</span>
                    <span class="label">Auditoría</span>
                </div>
                <div class="nav-item" onclick="showSection('saas-billing', this)">
                    <span class="icon material-symbols-rounded">payments</span>
                    <span class="label">Facturación C360</span>
                </div>
                <div class="nav-item" onclick="showSection('balance-financiero', this)">
                    <span class="icon material-symbols-rounded">account_balance</span>
                    <span class="label">Balance Financiero</span>
                </div>
                <div class="nav-item" onclick="showSection('settings', this)">
                    <span class="icon material-symbols-rounded">settings</span>
                    <span class="label">Configuración</span>
                </div>
            </nav>

            <!-- Bottom Actions -->
            <div class="p-4 border-t border-gray-200">
                <div class="nav-item text-red-600 hover:bg-red-50" onclick="logout()">
                    <span class="icon material-symbols-rounded">logout</span>
                    <span class="label">Cerrar sesión</span>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main id="main-content" class="flex-1 min-h-0 transition-all duration-300 flex flex-col overflow-hidden">
            <!-- Top App Bar -->
            <header class="app-top-bar sticky top-0 z-30 flex-shrink-0">
                <!-- Hamburger móvil -->
                <button onclick="toggleAdminMobileSidebar()" class="mobile-hamburger-btn w-10 h-10 flex items-center justify-center rounded-lg hover:bg-gray-100 mr-2" aria-label="Abrir menú">
                    <span class="material-symbols-rounded text-gray-700">menu</span>
                </button>
                <h2 id="page-title" class="text-xl font-medium text-gray-900 flex-1">Dashboard</h2>
                <div class="flex items-center gap-4">
                    <span id="admin-name" class="text-sm text-gray-600 hidden sm:block">Admin</span>
                    <div class="w-10 h-10 bg-[var(--md-sys-color-primary-container)] rounded-full flex items-center justify-center">
                        <span id="admin-initial" class="text-[var(--md-sys-color-on-primary-container)] font-medium">A</span>
                    </div>
                </div>
            </header>

            <!-- Content Area (scrollable) -->
            <div class="flex-1 overflow-y-auto">
            <div class="p-6 max-w-7xl mx-auto">
                <!-- Dashboard Section -->
                <section id="section-dashboard" class="space-y-6">
                    <!-- Stats Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <!-- Stat Card 1 -->
                        <div class="stat-card primary md-card animate-slide-in" style="animation-delay: 0ms;">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="text-sm text-gray-500 font-medium">Condominios</p>
                                    <h3 id="stat-tenants" class="text-4xl font-light text-gray-900 mt-2">0</h3>
                                    <p class="text-sm text-emerald-600 mt-1 flex items-center gap-1">
                                        <span class="material-symbols-rounded text-sm">trending_up</span>
                                        <span id="stat-tenants-active">0</span> activos
                                    </p>
                                </div>
                                <div class="w-12 h-12 bg-blue-100 rounded-2xl flex items-center justify-center">
                                    <span class="material-symbols-rounded text-blue-600 text-2xl">apartment</span>
                                </div>
                            </div>
                        </div>

                        <!-- Stat Card 2 -->
                        <div class="stat-card secondary md-card animate-slide-in" style="animation-delay: 50ms;">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="text-sm text-gray-500 font-medium">Usuarios Totales</p>
                                    <h3 id="stat-users" class="text-4xl font-light text-gray-900 mt-2">0</h3>
                                    <p id="stat-users-subtitle" class="text-sm text-gray-500 mt-1">
                                        0 propietarios de 0 cuentas
                                    </p>
                                </div>
                                <div class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center">
                                    <span class="material-symbols-rounded text-emerald-600 text-2xl">group</span>
                                </div>
                            </div>
                        </div>

                        <!-- Stat Card 3 -->
                        <div class="stat-card tertiary md-card animate-slide-in" style="animation-delay: 100ms;">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="text-sm text-gray-500 font-medium">Unidades</p>
                                    <h3 id="stat-properties" class="text-4xl font-light text-gray-900 mt-2">0</h3>
                                    <p class="text-sm text-gray-500 mt-1">Inmobiliarias</p>
                                </div>
                                <div class="w-12 h-12 bg-amber-100 rounded-2xl flex items-center justify-center">
                                    <span class="material-symbols-rounded text-amber-600 text-2xl">home_work</span>
                                </div>
                            </div>
                        </div>

                        <!-- Stat Card 4 -->
                        <div class="stat-card error md-card animate-slide-in" style="animation-delay: 150ms;">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="text-sm text-gray-500 font-medium">Ingresos Mensuales</p>
                                    <h3 id="stat-revenue" class="text-4xl font-light text-gray-900 mt-2">$0</h3>
                                    <p class="text-sm text-emerald-600 mt-1">Ingresos confirmados (USD)</p>
                                </div>
                                <div class="w-12 h-12 bg-purple-100 rounded-2xl flex items-center justify-center">
                                    <span class="material-symbols-rounded text-purple-600 text-2xl">payments</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="md-card p-6 animate-slide-in" style="animation-delay: 200ms;">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-lg font-medium text-gray-900">Actividad Reciente</h3>
                            <button class="md-button-text" onclick="loadAuditLogs()">Ver todo</button>
                        </div>
                        <div id="activity-list" class="space-y-3">
                            <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-gray-50 transition">
                                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                    <span class="material-symbols-rounded text-blue-600">sync</span>
                                </div>
                                <div class="flex-1">
                                    <p class="text-gray-900">Cargando actividad...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

