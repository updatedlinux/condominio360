        async function submitSaaSEditPaid(invoiceId) {
            const totalUsd = parseFloat(document.getElementById('saas-edit-total-usd').value);
            const periodMonth = parseInt(document.getElementById('saas-edit-period-month').value, 10);
            const periodYear = parseInt(document.getElementById('saas-edit-period-year').value, 10);
            const banco = document.getElementById('saas-edit-banco').value.trim();
            const ref = document.getElementById('saas-edit-ref').value.trim();
            const fecha = document.getElementById('saas-edit-fecha').value.trim();
            const monto = parseFloat(document.getElementById('saas-edit-monto').value);
            const comentario = document.getElementById('saas-edit-comentario').value.trim();

            const body = {};
            if (Number.isFinite(totalUsd) && totalUsd >= 0) body.total_usd = totalUsd;
            if (Number.isInteger(periodMonth) && periodMonth >= 1 && periodMonth <= 12) body.period_month = periodMonth;
            if (Number.isInteger(periodYear) && periodYear >= 2000 && periodYear <= 2100) body.period_year = periodYear;
            const pr = {};
            if (banco) pr.banco_emisor = banco;
            if (ref) pr.ref_transferencia = ref;
            if (fecha) pr.fecha_transferencia = fecha;
            if (Number.isFinite(monto) && monto >= 0) pr.monto_abonado_ves = monto;
            pr.comentario = comentario;
            if (Object.keys(pr).length > 0) body.payment_report = pr;

            try {
                const res = await fetch(`/api/admin/saas-billing/invoices/${invoiceId}/paid-details`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(body)
                });
                const json = await res.json();
                if (res.ok) {
                    showSnackbar(json.message || 'Recibo actualizado', 'success');
                    await openSaaSInvoiceDetail(invoiceId);
                    loadSaaSBilling();
                } else {
                    showSnackbar(json.error || 'Error al actualizar el recibo', 'error');
                }
            } catch (e) {
                showSnackbar('Error de conexión', 'error');
            }
        }
        async function downloadSaasInvoicePdfAdmin(invoiceId) {
            try {
                showSnackbar('Generando comprobante PDF...', 'info');
                const res = await fetch(`/api/admin/saas-billing/invoices/${invoiceId}/payment-pdf`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (!res.ok) {
                    let msg = 'No se pudo generar el comprobante';
                    try { const data = await res.json(); if (data?.error) msg = data.error; } catch (_) {}
                    showSnackbar(msg, 'error');
                    return;
                }
                const blob = await res.blob();
                const disposition = res.headers.get('Content-Disposition') || '';
                const match = disposition.match(/filename="?([^";]+)"?/i);
                const filename = (match && match[1]) || `Comprobante-Condominio360-${invoiceId.slice(0, 8)}.pdf`;
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                setTimeout(() => URL.revokeObjectURL(url), 1500);
                showSnackbar('Comprobante descargado', 'success');
            } catch (e) {
                showSnackbar('Error al descargar el comprobante', 'error');
            }
        }
