        function formatDateTimeVenezuela(dateStr) {
            if (!dateStr) return '-';
            const d = new Date(dateStr);
            const v = new Date(d.getTime() + (4 * 60 * 60 * 1000));
            return v.toLocaleString('es-VE', { timeZone: 'America/Caracas' });
        }

        async function exportDataUpdateRequestsExcel() {
            const status = document.getElementById('dur-status-filter')?.value || '';
            try {
                let url = '/api/admin/data-update-requests/export';
                if (status) url += `?status=${encodeURIComponent(status)}`;
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showSnackbar(err.error || 'Error al exportar', 'error');
                    return;
                }
                const blob = await res.blob();
                const cd = res.headers.get('Content-Disposition');
                let filename = 'solicitudes-actualizacion-datos.xlsx';
                if (cd && cd.includes('filename=')) {
                    const m = cd.match(/filename="?([^";]+)"?/);
                    if (m) filename = decodeURIComponent(m[1]);
                }
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = filename;
                a.click();
                URL.revokeObjectURL(a.href);
                showSnackbar('Excel descargado', 'success');
            } catch (e) {
                console.error(e);
                showSnackbar('Error al descargar Excel', 'error');
            }
        }

        async function loadDataUpdateRequests() {
            const status = document.getElementById('dur-status-filter')?.value || '';
            try {
                let url = `/api/admin/data-update-requests?page=${durPage}&limit=20`;
                if (status) url += `&status=${status}`;
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (!data.success) throw new Error(data.error);
                renderDataUpdateRequests(data.data, data.pagination);
            } catch (error) {
                document.getElementById('data-update-requests-tbody').innerHTML = '<tr><td colspan="5" class="text-center py-8 text-red-500">Error al cargar</td></tr>';
            }
        }

        function renderDataUpdateRequests(rows, pagination) {
            const tbody = document.getElementById('data-update-requests-tbody');
            if (!rows || rows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-gray-500">No hay solicitudes</td></tr>';
            } else {
                tbody.innerHTML = rows.map(r => {
                    const statusClass = r.status === 'PENDING' ? 'bg-amber-100 text-amber-800' : r.status === 'APPROVED' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800';
                    const statusLabel = r.status === 'PENDING' ? 'Pendiente' : r.status === 'APPROVED' ? 'Aprobada' : 'Rechazada';
                    const dateStr = formatDateTimeVenezuela(r.requested_at);
                    return `<tr>
                        <td>${(r.first_name || '')} ${(r.last_name || '')}</td>
                        <td>${r.email || '-'}</td>
                        <td><span class="px-2 py-1 rounded text-xs font-medium ${statusClass}">${statusLabel}</span></td>
                        <td>${dateStr}</td>
                        <td>${r.status === 'PENDING' ? `<button onclick="openDurModal('${r.id}')" class="text-[var(--md-sys-color-primary)] hover:underline text-sm">Ver</button>` : `<button onclick="openDurModal('${r.id}')" class="text-gray-500 hover:underline text-sm">Ver</button>`}</td>
                    </tr>`;
                }).join('');
            }
            const pagEl = document.getElementById('dur-pagination');
            if (pagination && pagination.pages > 1) {
                pagEl.innerHTML = `<div class="text-sm text-gray-500">Página ${pagination.page} de ${pagination.pages} (${pagination.total} total)</div>
                    <div class="flex gap-2">
                        <button onclick="durPage=${pagination.page-1}; loadDataUpdateRequests();" ${pagination.page <= 1 ? 'disabled' : ''} class="px-3 py-1 border rounded text-sm disabled:opacity-50">Anterior</button>
                        <button onclick="durPage=${pagination.page+1}; loadDataUpdateRequests();" ${pagination.page >= pagination.pages ? 'disabled' : ''} class="px-3 py-1 border rounded text-sm disabled:opacity-50">Siguiente</button>
                    </div>`;
            } else {
                pagEl.innerHTML = pagination ? `<div class="text-sm text-gray-500">${pagination.total} solicitudes</div>` : '';
            }
        }

        async function openDurModal(id) {
            document.getElementById('dur-modal-overlay').classList.add('active');
            document.getElementById('dur-modal').classList.add('active');
            document.getElementById('dur-modal-loading').classList.remove('hidden');
            document.getElementById('dur-modal-content').classList.add('hidden');
            document.getElementById('dur-modal-actions').classList.add('hidden');
            const copyBtn = document.getElementById('dur-copy-btn');
            if (copyBtn) copyBtn.classList.add('hidden');
            const commentEl = document.getElementById('dur-owner-comment');
            if (commentEl) commentEl.value = '';
            const readWrap = document.getElementById('dur-admin-comment-readonly');
            const readText = document.getElementById('dur-admin-comment-readonly-text');
            const readKind = document.getElementById('dur-admin-comment-kind');
            if (readWrap) readWrap.classList.add('hidden');
            if (readText) readText.textContent = '';
            if (readKind) readKind.textContent = '';
            try {
                const res = await fetch(`/api/admin/data-update-requests/${id}`, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (!data.success) throw new Error(data.error);
                durCurrentDetail = data;
                const req = data.request;
                const oldData = req.old_data || {};
                const newData = req.new_data || {};
                document.getElementById('dur-tenants').innerHTML = (data.tenants || []).map(t => `<li>${t.name}</li>`).join('') || '<li class="text-gray-400">-</li>';
                document.getElementById('dur-properties').innerHTML = (data.properties || []).map(p => `<li>${p.tenant_name} - ${p.name || p.building_name}</li>`).join('') || '<li class="text-gray-400">-</li>';
                document.getElementById('dur-old-data').innerHTML = `
                    <div>Nombre: ${oldData.first_name || '-'}</div>
                    <div>Apellido: ${oldData.last_name || '-'}</div>
                    <div>Cédula: ${oldData.dni || '-'}</div>
                    <div>Correo: ${oldData.email || '-'}</div>
                    <div>Teléfono: ${oldData.phone || '-'}</div>
                `;
                document.getElementById('dur-new-data-form').innerHTML = `
                    <div><label class="block text-xs text-gray-500 mb-1">Nombre</label><input type="text" id="dur-edit-first_name" value="${(newData.first_name || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                    <div><label class="block text-xs text-gray-500 mb-1">Apellido</label><input type="text" id="dur-edit-last_name" value="${(newData.last_name || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                    <div><label class="block text-xs text-gray-500 mb-1">Cédula</label><input type="text" id="dur-edit-dni" value="${(newData.dni || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                    <div><label class="block text-xs text-gray-500 mb-1">Correo</label><input type="email" id="dur-edit-email" value="${(newData.email || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                    <div><label class="block text-xs text-gray-500 mb-1">Teléfono</label><input type="text" id="dur-edit-phone" value="${(newData.phone || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                `;
                document.getElementById('dur-requested-at').textContent = formatDateTimeVenezuela(req.requested_at);
                document.getElementById('dur-modal-loading').classList.add('hidden');
                document.getElementById('dur-modal-content').classList.remove('hidden');
                if (copyBtn) copyBtn.classList.remove('hidden');

                document.querySelectorAll('#dur-new-data-form input').forEach((el) => {
                    el.disabled = req.status !== 'PENDING';
                });

                const rw = document.getElementById('dur-admin-comment-readonly');
                const rt = document.getElementById('dur-admin-comment-readonly-text');
                const rk = document.getElementById('dur-admin-comment-kind');
                if (req.status !== 'PENDING' && rw && rt) {
                    const isRej = req.status === 'REJECTED';
                    const msg = isRej ? (req.rejection_reason || '') : (req.approval_comment || '');
                    const trimmed = msg && String(msg).trim();
                    if (trimmed) {
                        rw.classList.remove('hidden');
                        rt.textContent = trimmed;
                        if (rk) rk.textContent = isRej ? '(rechazo)' : '(aprobación)';
                    } else {
                        rw.classList.add('hidden');
                        rt.textContent = '';
                        if (rk) rk.textContent = '';
                    }
                } else if (rw) {
                    rw.classList.add('hidden');
                }

                if (req.status === 'PENDING') {
                    document.getElementById('dur-modal-actions').classList.remove('hidden');
                }
            } catch (e) {
                document.getElementById('dur-modal-loading').textContent = 'Error al cargar';
            }
        }

