        async function submitSuperAdmin() {
            const firstName = document.getElementById('sa-first-name').value.trim();
            const lastName = document.getElementById('sa-last-name').value.trim();
            const email = document.getElementById('sa-email').value.trim().toLowerCase();
            const password = document.getElementById('sa-password').value;
            const passwordConfirm = document.getElementById('sa-password-confirm').value;
            const phone = document.getElementById('sa-phone').value.trim() || null;

            if (!firstName || !lastName || !email || !password) {
                showSnackbar('Complete todos los campos obligatorios', 'error');
                return;
