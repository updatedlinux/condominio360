        async function generateSaaSInvoices(overrideTenantId) {
            const tenantId = overrideTenantId ?? saasOverviewSelectedTenantId;
            if (!tenantId) {
                showSnackbar('Selecciona un condominio', 'error');
                return;
            }
            const month = parseInt(document.getElementById('saas-period-month').value);
            const year = parseInt(document.getElementById('saas-period-year').value);
            const paymentMethod = document.getElementById('saas-payment-method').value?.trim() || null;
            const docType = document.querySelector('input[name="saas-billing-doc"]:checked')?.value || 'VOUCHER';
            const fiscalFile = document.getElementById('saas-fiscal-file');
            if (docType === 'FISCAL' && (!fiscalFile || !fiscalFile.files || !fiscalFile.files[0])) {
                showSnackbar('Adjunte el PDF o imagen de la factura fiscal', 'error');
                return;
            }
            const fd = new FormData();
            fd.append('billing_document_type', docType);
            fd.append('period_month', String(month));
            fd.append('period_year', String(year));
            if (paymentMethod) fd.append('payment_method', paymentMethod);
            fd.append('tenant_id', tenantId);
            fd.append('extra_items', JSON.stringify(saasExtraItems));
            if (docType === 'FISCAL' && fiscalFile.files[0]) {
                fd.append('fiscal_attachment', fiscalFile.files[0], fiscalFile.files[0].name);
            }
            try {
                const res = await fetch('/api/admin/saas-billing/invoices', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` },
                    body: fd
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Error');
                closeSaaSOverviewModal();
                showSnackbar(`Generadas ${data.created} factura(s)`, 'success');
                if (data.skipped > 0) showSnackbar(`${data.skipped} condominio(s) ya facturados`, 'info');
                loadSaaSBilling();
            } catch (e) {
                showSnackbar(e.message || 'Error al generar facturas', 'error');
            }
        }
        async function recalculateSaaSInvoice(id) {
