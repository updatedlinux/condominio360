        function renderSaaSOverviewExtras() {
            const el = document.getElementById('saas-overview-extra-list');
            el.innerHTML = saasExtraItems.map((it, i) => `
                <div class="flex gap-2 items-center">
                    <input type="text" placeholder="Descripción" value="${(it.description||'').replace(/"/g,'&quot;')}" onchange="saasExtraItems[${i}].description=this.value; updateSaaSOverviewTotalsFromData()" class="flex-1 border border-gray-200 rounded px-2 py-1.5 text-sm">
                    <input type="number" step="0.01" placeholder="USD" value="${it.amount_usd||0}" onchange="saasExtraItems[${i}].amount_usd=parseFloat(this.value)||0; updateSaaSOverviewTotalsFromData()" class="w-24 border border-gray-200 rounded px-2 py-1.5 text-sm">
                    <button type="button" onclick="saasExtraItems.splice(${i},1); renderSaaSOverviewExtras(); updateSaaSOverviewTotalsFromData();" class="text-red-500 hover:bg-red-50 rounded p-1">×</button>
                </div>
            `).join('');
        }
        let saasOverviewTenantsCache = [];
        let saasOverviewRate = 0;
        let saasOverviewRateDate = null;
        function toggleSaaSFiscalFields() {
            const fiscal = document.querySelector('input[name="saas-billing-doc"]:checked')?.value === 'FISCAL';
            const help = document.getElementById('saas-fiscal-help');
            const wrap = document.getElementById('saas-fiscal-file-wrap');
            if (help) help.classList.toggle('hidden', !fiscal);
            if (wrap) wrap.classList.toggle('hidden', !fiscal);
        }
        function updateSaaSOverviewTotals(tenants) {
            saasOverviewTenantsCache = tenants || saasOverviewTenantsCache;
            const totalUnits = (tenants || saasOverviewTenantsCache).reduce((s,t) => s + (t.property_count||0), 0);
            const baseUsd = (tenants || saasOverviewTenantsCache).reduce(
                (s, t) => s + (t.property_count || 0) * saasUnitPriceForTenant(t), 0
            );
            const extraUsd = saasExtraItems.reduce((s,it) => s + (parseFloat(it.amount_usd)||0), 0);
            const subtotalUsd = baseUsd + extraUsd;
            const docType = document.querySelector('input[name="saas-billing-doc"]:checked')?.value || 'VOUCHER';
            let ivaUsd = 0;
            let totalUsd = subtotalUsd;
            const fiscalLinesEl = document.getElementById('saas-overview-fiscal-lines');
            if (docType === 'FISCAL') {
                ivaUsd = subtotalUsd * 0.16;
                totalUsd = subtotalUsd + ivaUsd + 10;
                if (fiscalLinesEl) {
                    fiscalLinesEl.classList.remove('hidden');
                    fiscalLinesEl.innerHTML = `+ IVA 16%: <span class="font-medium">$${ivaUsd.toFixed(2)}</span> USD · Envío factura fiscal: <span class="font-medium">$10.00</span> USD`;
                }
            } else if (fiscalLinesEl) {
                fiscalLinesEl.classList.add('hidden');
                fiscalLinesEl.textContent = '';
            }
            document.getElementById('saas-overview-base').textContent = '$' + baseUsd.toFixed(2);
            document.getElementById('saas-overview-extra').textContent = '$' + extraUsd.toFixed(2);
            document.getElementById('saas-overview-total').textContent = '$' + totalUsd.toFixed(2);
            const vesEl = document.getElementById('saas-overview-ves');
            if (saasOverviewRate > 0) {
                let totalVes = totalUsd * saasOverviewRate;
                if (docType === 'FISCAL') {
                    const subVes = subtotalUsd * saasOverviewRate;
                    const ivaVes = subVes * 0.16;
                    const shipVes = 10 * saasOverviewRate;
                    totalVes = subVes + ivaVes + shipVes;
                }
                const rateDateStr = saasOverviewRateDate ? (() => {
                    const raw = String(saasOverviewRateDate).split('T')[0];
                    const [y, m, d2] = raw.split('-');
                    return y && m && d2 ? new Date(parseInt(y), parseInt(m) - 1, parseInt(d2)).toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
                })() : '';
                vesEl.textContent = rateDateStr ? `(Bs. ${totalVes.toLocaleString('es-VE')} — tasa del ${rateDateStr})` : `(Bs. ${totalVes.toLocaleString('es-VE')})`;
            } else {
                vesEl.textContent = '';
            }
        }
        function updateSaaSOverviewTotalsFromData() {
            const tenantId = saasOverviewSelectedTenantId;
            const toBill = tenantId ? saasOverviewTenantsList.filter(t => t.id === tenantId && saasTenantEligible(t)) : [];
            updateSaaSOverviewTotals(toBill);
        }
        let saasGenerateInProgress = false;
        function setSaaSGenerateLoading(loading) {
            const btn = document.getElementById('saas-generate-btn');
            const cancelBtn = document.getElementById('saas-overview-cancel-btn');
            const icon = document.getElementById('saas-generate-icon');
            const text = document.getElementById('saas-generate-text');
            const spinner = document.getElementById('saas-generate-spinner');
            if (!btn) return;
            saasGenerateInProgress = loading;
            btn.disabled = loading;
            if (cancelBtn) cancelBtn.disabled = loading;
            if (icon) icon.classList.toggle('hidden', loading);
            if (text) text.textContent = loading ? 'Generando...' : 'Generar factura';
            if (spinner) spinner.classList.toggle('hidden', !loading);
        }
        async function confirmGenerateSaaSInvoices() {
            if (saasGenerateInProgress) return;
            const tenantId = saasOverviewSelectedTenantId;
            if (!tenantId) return;
            setSaaSGenerateLoading(true);
            await generateSaaSInvoices(tenantId);
            setSaaSGenerateLoading(false);
