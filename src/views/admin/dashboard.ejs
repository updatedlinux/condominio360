                        });
                        const json = await res.json();
                        if (res.ok) {
                            tenantsData = tenantsData.filter(t => t.id !== id);
                            filterTenants();
                            showSnackbar('Condominio eliminado correctamente', 'success');
                        } else {
                            showSnackbar(json.error || 'Error al eliminar', 'error');
                        }
                    } catch (e) {
                        showSnackbar('Error de conexión', 'error');
                    }
                }
            );
        }

