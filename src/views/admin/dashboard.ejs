                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-gray-900 text-sm font-medium truncate">${item.description}</p>
                        <p class="text-gray-500 text-xs">${item.tenant_name || 'Sistema'} • ${timeAgo(item.created_at)}</p>
                    </div>
                </div>
            `).join('');
        }

        function renderTenants(tenants) {
            const tbody = document.getElementById('tenants-table-body');
            
            if (tenants.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-500">No hay condominios registrados</td></tr>';
                return;
            }

            tbody.innerHTML = tenants.map(t => `
                <tr>
                    <td>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl flex items-center justify-center text-white font-bold">
                                ${t.name.charAt(0)}
                            </div>
                            <div>
                                <div class="font-medium text-gray-900">${t.name}</div>
                                <div class="text-sm text-gray-500">${t.slug}</div>
                            </div>
                        </div>
                    </td>
                    <td class="font-medium">${t.property_count || 0}</td>
                    <td class="font-medium">${t.user_count || 0}</td>
                    <td>
                        <span class="md-chip ${t.active ? 'md-chip-filled' : 'bg-gray-100 text-gray-600'}">
                            ${t.active ? 'Activo' : 'Inactivo'}
                        </span>
                    </td>
                    <td class="text-gray-500">${new Date(t.created_at).toLocaleDateString('es-VE')}</td>
                    <td>
                        <div class="flex items-center justify-end gap-1">
                            <a href="/admin/tenants/${t.id}" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition" title="Ver detalle">
                                <span class="material-symbols-rounded text-gray-500">visibility</span>
                            </a>
                            <button onclick="deleteTenant('${t.id}', '${t.name.replace(/'/g, "\\'")}', ${t.property_count || 0}, ${t.user_count || 0})" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-red-50 text-red-600 transition" title="Eliminar condominio">
                                <span class="material-symbols-rounded">delete</span>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function deleteTenant(id, name, propertyCount, ownerCount) {
            if (propertyCount > 0 || ownerCount > 0) {
                showSnackbar('No se puede eliminar: el condominio tiene inmuebles o propietarios asociados. Elimine todos primero.', 'error');
                return;
            }
            openConfirmModal(
                'Eliminar condominio',
                '¿Eliminar el condominio "' + name + '"? Esta acción no se puede deshacer.',
                async () => {
                    try {
                        const res = await fetch('/api/admin/tenants/' + id, {
                            method: 'DELETE',
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        const json = await res.json();
                        if (res.ok) {
                            tenantsData = tenantsData.filter(t => t.id !== id);
                            filterTenants();
                            showSnackbar('Condominio eliminado correctamente', 'success');
                        } else {
                            showSnackbar(json.error || 'Error al eliminar', 'error');
                        }
                    } catch (e) {
                        showSnackbar('Error de conexión', 'error');
                    }
                }
            );
        }

        function renderAuditLogs(logs) {
            const container = document.getElementById('audit-logs-container');
            if (!logs || logs.length === 0) {
                container.innerHTML = '<p class="text-gray-500 text-center py-8">Sin registros</p>';
                return;
            }

            container.innerHTML = logs.map(log => `
                <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                    <span class="text-xs font-mono text-gray-400">${new Date(log.created_at).toLocaleTimeString('es-VE')}</span>
                    <span class="px-3 py-1 rounded-lg text-xs font-medium ${getActionBadgeClass(log.action)}">${log.action}</span>
                    <span class="text-sm text-gray-700 flex-1">${log.description}</span>
                    <span class="text-xs text-gray-500">${log.user_name || 'Sistema'}</span>
                </div>
            `).join('');
        }

        // Filter Functions
        function setFilter(filter, element) {
            currentFilter = filter;
            document.querySelectorAll('.md-segment').forEach(s => s.classList.remove('active'));
            element.classList.add('active');
            filterTenants();
        }

        function filterTenants() {
            const search = document.getElementById('tenant-search').value.toLowerCase();
            
            let filtered = tenantsData.filter(t => 
                t.name.toLowerCase().includes(search) || 
                t.slug.toLowerCase().includes(search)
            );

            if (currentFilter === 'active') filtered = filtered.filter(t => t.active);
            if (currentFilter === 'inactive') filtered = filtered.filter(t => !t.active);

            renderTenants(filtered);
        }

        // Wizard Functions
        function openNewTenantModal() {
            document.getElementById('modal-overlay').classList.add('active');
            document.getElementById('new-tenant-modal').classList.add('active');
            resetWizard();
        }

        function closeNewTenantModal() {
            document.getElementById('modal-overlay').classList.remove('active');
            document.getElementById('new-tenant-modal').classList.remove('active');
        }

        function resetWizard() {
            currentStep = 1;
            document.getElementById('new-tenant-form').reset();
            updateWizardUI();
            validateAllFields(); // Reset button state
        }

        // Validación en tiempo real de todos los campos del wizard
        function validateAllFields() {
            // Campos requeridos del paso 1
            const tenantName = document.getElementById('tenant-name')?.value.trim();
            const tenantSlug = document.getElementById('tenant-slug')?.value.trim();
            
            // Campos requeridos del paso 4 (admin)
            const adminDisplayName = document.getElementById('admin-display-name')?.value.trim();
            const adminEmail = document.getElementById('admin-email')?.value.trim();
            const adminPassword = document.getElementById('admin-password')?.value.trim();
            
            // Paso 3: si MULTIPLE, al menos un edificio con nombre
            const buildingType = document.getElementById('building-type')?.value;
            let buildingsValid = true;
            if (buildingType === 'MULTIPLE') {
                buildingsValid = buildings.some(b => (b.name || '').trim());
            }
            
            // Verificar que todos estén completos
            const isValid = tenantName && tenantSlug && adminDisplayName && adminEmail && adminPassword && buildingsValid;
            
            // Actualizar estado del botón submit (también respetar idempotencia)
            const submitBtn = document.getElementById('btn-submit');
            if (submitBtn) {
                submitBtn.disabled = !isValid || !!window.submitTenantInProgress;
            }
            
            return isValid;
        }

        // Agregar event listeners para validación en tiempo real
        function setupValidationListeners() {
            const fields = ['tenant-name', 'tenant-slug', 'admin-display-name', 'admin-email', 'admin-password'];
            fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('input', validateAllFields);
                    field.addEventListener('change', validateAllFields);
                }
            });
        }

        // Billing Type Functions
        function updateBillingType(value) {
            const info = document.getElementById('alicuota-info');
            if (value === 'ALICUOTA') {
                info.classList.remove('hidden');
            } else {
                info.classList.add('hidden');
            }
        }

        // Building Type Functions
        let buildings = [];
        
        function setBuildingType(type) {
            document.getElementById('building-type').value = type;
            document.getElementById('segment-single').classList.toggle('active', type === 'SINGLE');
            document.getElementById('segment-multiple').classList.toggle('active', type === 'MULTIPLE');
            
            if (type === 'SINGLE') {
                document.getElementById('single-building-info').classList.remove('hidden');
                document.getElementById('multiple-buildings-container').classList.add('hidden');
            } else {
                document.getElementById('single-building-info').classList.add('hidden');
                document.getElementById('multiple-buildings-container').classList.remove('hidden');
                if (buildings.length === 0) {
                    addBuilding();
                }
            }
            validateAllFields();
        }
        
        function addBuilding() {
            const id = Date.now();
            buildings.push({ id, name: '', code: '' });
            renderBuildings();
            validateAllFields();
        }
        
        function removeBuilding(id) {
            buildings = buildings.filter(b => b.id !== id);
            renderBuildings();
            validateAllFields();
        }
        
        function updateBuilding(id, field, value) {
            const building = buildings.find(b => b.id === id);
            if (building) {
                building[field] = value;
            }
            validateAllFields();
        }
        
        function renderBuildings() {
            const container = document.getElementById('buildings-list');
            container.innerHTML = buildings.map(b => `
                <div class="flex gap-2 items-start">
                    <div class="flex-1 grid grid-cols-2 gap-2">
                        <input type="text" placeholder="Nombre del edificio *" 
                            class="px-3 py-2 border border-gray-200 rounded-lg text-sm"
                            value="${b.name}" 
                            onchange="updateBuilding(${b.id}, 'name', this.value)">
                        <input type="text" placeholder="Código (ej: A, Torre-1)" 
                            class="px-3 py-2 border border-gray-200 rounded-lg text-sm"
                            value="${b.code}" 
                            onchange="updateBuilding(${b.id}, 'code', this.value)">
                    </div>
                    <button type="button" onclick="removeBuilding(${b.id})" 
                        class="p-2 text-red-500 hover:bg-red-50 rounded-lg">
                        <span class="material-symbols-rounded text-sm">delete</span>
                    </button>
                </div>
            `).join('');
        }

        function updateWizardUI() {
            // Hide all steps
            for (let i = 1; i <= 5; i++) {
                document.getElementById(`step-${i}`).classList.add('hidden');
            }
            
            // Show current
            document.getElementById(`step-${currentStep}`).classList.remove('hidden');

            // Update progress
            const progress = (currentStep / 5) * 100;
            document.getElementById('progress-bar').style.width = progress + '%';

            // Update step indicators
            for (let i = 1; i <= 5; i++) {
                const indicator = document.getElementById(`step-indicator-${i}`).querySelector('div');
                const label = document.getElementById(`step-indicator-${i}`).querySelector('span');
                
                if (i <= currentStep) {
                    indicator.className = 'w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-sm font-medium';
                    if (label) {
                        label.classList.remove('text-gray-500');
                        label.classList.add('text-gray-900');
                    }
                } else {
                    indicator.className = 'w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium';
                    if (label) {
                        label.classList.remove('text-gray-900');
                        label.classList.add('text-gray-500');
                    }
                }
            }

            // Scroll dinámico: centrar el paso actual para que no quede recortado
            const activeIndicator = document.getElementById(`step-indicator-${currentStep}`);
            const container = document.getElementById('wizard-steps-container');
            if (activeIndicator && container) {
                requestAnimationFrame(() => {
                    const rect = activeIndicator.getBoundingClientRect();
                    const containerRect = container.getBoundingClientRect();
                    const scrollTarget = container.scrollLeft + (rect.left - containerRect.left) - (containerRect.width / 2) + (rect.width / 2);
                    container.scrollTo({ left: Math.max(0, scrollTarget), behavior: 'smooth' });
                });
            }

            // Update buttons
            document.getElementById('btn-prev').classList.toggle('hidden', currentStep === 1);
            document.getElementById('btn-next').classList.toggle('hidden', currentStep === 5);
            document.getElementById('btn-submit').classList.toggle('hidden', currentStep !== 5);

            if (currentStep === 5) {
                updateReviewData();
                validateAllFields(); // Check if submit button should be enabled
            }
        }

        function updateReviewData() {
            // Tenant info
            document.getElementById('review-name').textContent = document.getElementById('tenant-name').value;
            document.getElementById('review-slug').textContent = document.getElementById('tenant-slug').value;
            document.getElementById('review-address').textContent = document.getElementById('tenant-address').value || 'No especificada';
            
            // Billing type
            const billingType = document.querySelector('input[name="billing_type"]:checked')?.value;
            document.getElementById('review-billing-type').textContent = billingType === 'ALICUOTA' ? 'Por Alícuota' : 'Cuota Fija';
            
            // Building type
            const buildingType = document.getElementById('building-type').value;
            document.getElementById('review-building-type').textContent = buildingType === 'MULTIPLE' ? 'Múltiples Edificios' : 'Único Edificio';
            
            // Buildings list
            const buildingsList = document.getElementById('review-buildings-list');
            if (buildingType === 'MULTIPLE' && buildings.length > 0) {
                buildingsList.innerHTML = '<ul class="list-disc list-inside mt-2">' + 
                    buildings.filter(b => b.name).map(b => `<li class="text-gray-700">${b.name} ${b.code ? '(' + b.code + ')' : ''}</li>`).join('') + 
                    '</ul>';
            } else {
                buildingsList.innerHTML = '<p class="text-gray-500 mt-2">Edificio Principal</p>';
            }
            
            // Admin info
            document.getElementById('review-admin-name').textContent = document.getElementById('admin-display-name').value;
            document.getElementById('review-admin-email').textContent = document.getElementById('admin-email').value;
        }

        function nextStep() {
            if (validateStep(currentStep)) {
                if (currentStep < 5) {
                    currentStep++;
                    updateWizardUI();
                    // Si llegamos al paso 5, validar campos para habilitar/deshabilitar botón
                    if (currentStep === 5) {
                        validateAllFields();
                    }
                }
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                updateWizardUI();
            }
        }

        function validateStep(step) {
            // Validación paso 1: Info del condominio
            if (step === 1) {
                const ids = ['tenant-name', 'tenant-slug'];
                for (const id of ids) {
                    const el = document.getElementById(id);
                    if (!el.value.trim()) {
                        el.focus();
                        el.parentElement.classList.add('animate-pulse');
                        setTimeout(() => el.parentElement.classList.remove('animate-pulse'), 500);
                        showSnackbar('Completa todos los campos requeridos');
                        return false;
                    }
                }
                return true;
            }
            
            // Validación paso 2: Billing type (siempre válido, tiene default)
            if (step === 2) return true;
            
            // Validación paso 3: Buildings
            if (step === 3) {
                const buildingType = document.getElementById('building-type').value;
                if (buildingType === 'MULTIPLE') {
                    // Validar que haya al menos un edificio con nombre
                    const validBuildings = buildings.filter(b => b.name.trim());
                    if (validBuildings.length === 0) {
                        showSnackbar('Agrega al menos un edificio con nombre');
                        return false;
                    }
                }
                return true;
            }
            
            // Validación paso 4: Admin info
            if (step === 4) {
                const ids = ['admin-display-name', 'admin-email', 'admin-password'];
                for (const id of ids) {
                    const el = document.getElementById(id);
                    if (!el.value.trim()) {
                        el.focus();
                        el.parentElement.classList.add('animate-pulse');
                        setTimeout(() => el.parentElement.classList.remove('animate-pulse'), 500);
                        showSnackbar('Completa todos los campos requeridos');
                        return false;
                    }
                }
                return true;
            }
            
            // Paso 5: Review (siempre válido)
            return true;
        }

        async function submitTenant() {
            if (window.submitTenantInProgress) return;
            window.submitTenantInProgress = true;

            const submitBtn = document.getElementById('btn-submit');
            const originalHtml = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="animate-spin rounded-full h-5 w-5 border-2 border-white border-t-transparent inline-block mr-2"></span> Creando...';
            }

            const buildingType = document.getElementById('building-type').value;
            const billingType = document.querySelector('input[name="billing_type"]:checked')?.value || 'FIXED';
            
            // Preparar edificios
            let buildingData = [];
            if (buildingType === 'MULTIPLE') {
                buildingData = buildings
                    .filter(b => b.name.trim())
                    .map(b => ({
                        name: b.name.trim(),
                        code: b.code.trim() || b.name.trim().substring(0, 20)
                    }));
            }
            
            const data = {
                name: document.getElementById('tenant-name').value,
                slug: document.getElementById('tenant-slug').value,
                address: document.getElementById('tenant-address').value,
                billing_type: billingType,
                building_type: buildingType,
                buildings: buildingData,
                admin: {
                    display_name: document.getElementById('admin-display-name').value,
                    email: document.getElementById('admin-email').value,
                    password: document.getElementById('admin-password').value,
                    phone: document.getElementById('admin-phone').value
                }
            };

            try {
                const res = await fetch('/api/admin/onboarding', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(data)
                });

                if (!res.ok) {
                    const err = await res.json();
                    throw new Error(err.error || 'Error creando condominio');
                }

                closeNewTenantModal();
                showSnackbar('Condominio creado exitosamente', 'success');
                loadTenants();
                loadStats();
            } catch (error) {
                showSnackbar(error.message, 'error');
            } finally {
                window.submitTenantInProgress = false;
                if (submitBtn) {
                    submitBtn.disabled = !validateAllFields();
                    submitBtn.innerHTML = originalHtml || '<span class="material-symbols-rounded">check</span> Crear Condominio';
                }
            }
        }

        // Helpers
        function getActivityColor(action) {
            const colors = {
                'TENANT_CREATED': 'bg-emerald-100 text-emerald-600',
                'USER_LOGIN': 'bg-blue-100 text-blue-600',
                'TENANT_SUSPENDED': 'bg-red-100 text-red-600'
            };
            return colors[action] || 'bg-gray-100 text-gray-600';
        }

        function getActivityIcon(action) {
            const icons = {
                'TENANT_CREATED': 'add_circle',
                'USER_LOGIN': 'login',
                'TENANT_SUSPENDED': 'block'
            };
            return icons[action] || 'info';
        }

        function getActionBadgeClass(action) {
            const classes = {
                'CREATE': 'bg-emerald-100 text-emerald-700',
                'UPDATE': 'bg-blue-100 text-blue-700',
                'DELETE': 'bg-red-100 text-red-700'
            };
            return classes[action] || 'bg-gray-100 text-gray-700';
        }

        function timeAgo(date) {
            const seconds = Math.floor((new Date() - new Date(date)) / 1000);
            if (seconds < 60) return 'ahora';
            const minutes = Math.floor(seconds / 60);
            if (minutes < 60) return `hace ${minutes}m`;
            const hours = Math.floor(minutes / 60);
            if (hours < 24) return `hace ${hours}h`;
            return `hace ${Math.floor(hours / 24)}d`;
        }

        function animateNumber(id, target) {
            const el = document.getElementById(id);
            const duration = 1000;
            const start = 0;
            const increment = target / (duration / 16);
            let current = start;
            
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    el.textContent = target.toLocaleString();
                    clearInterval(timer);
                } else {
                    el.textContent = Math.floor(current).toLocaleString();
                }
            }, 16);
        }

        function viewTenant(id) {
            window.location.href = `/admin/tenants/${id}`;
        }

        // Snackbar
        function showSnackbar(message, type = 'info') {
            const snackbar = document.getElementById('snackbar');
            document.getElementById('snackbar-message').textContent = message;
            
            if (type === 'error') {
                snackbar.style.background = '#ba1a1a';
            } else if (type === 'success') {
                snackbar.style.background = '#006c4c';
            } else {
                snackbar.style.background = 'var(--md-sys-color-on-surface)';
            }
            
            snackbar.classList.add('active');
            setTimeout(hideSnackbar, 5000);
        }

        function hideSnackbar() {
            document.getElementById('snackbar').classList.remove('active');
        }

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = '/';
        }
    </script>
</body>
</html>
