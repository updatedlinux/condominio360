            } else {
                const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
                const hasInvoiced = list.some((t) => !saasTenantEligible(t));
                const hint = hasInvoiced
                    ? '<div class="sticky top-0 z-10 px-4 py-2.5 bg-red-50 border-b border-red-200 text-xs text-red-900 flex items-start gap-2 flex-shrink-0"><span class="material-symbols-rounded text-[18px] text-red-600 flex-shrink-0 mt-0.5">warning</span><span><strong>Atención:</strong> la etiqueta roja <strong>«Ya facturado»</strong> indica que ese conjunto ya tiene facturación SaaS en el mes/año del período. No es seleccionable. Pasa el cursor sobre la fila o la etiqueta para más detalle.</span></div>'
                    : '';
                listEl.innerHTML = hint + list.map(t => {
                    const eligible = saasTenantEligible(t);
                    const icon = eligible ? 'bg-orange-100' : 'bg-gray-100';
                    const iconColor = eligible ? 'text-[#f97316]' : 'text-gray-400';
                    const nameClass = eligible ? 'text-gray-900' : 'text-gray-500';
                    const right = eligible
                        ? '<span class="material-symbols-rounded text-gray-400 flex-shrink-0">chevron_right</span>'
                        : '<span class="text-xs font-semibold text-red-800 bg-red-50 border border-red-200 px-2 py-1 rounded-md flex-shrink-0 shadow-sm" title="Ya existe facturación SaaS para el mes y año del período seleccionado. No se puede generar otra.">Ya facturado</span>';
                    const base = 'w-full flex items-center gap-3 px-4 py-3 text-left border-b border-gray-100 last:border-b-0';
                    const inner = '<span class="w-10 h-10 rounded-full ' + icon + ' flex items-center justify-center flex-shrink-0">' +
                        '<span class="material-symbols-rounded ' + iconColor + ' text-xl">apartment</span></span>' +
                        '<div class="flex-1 min-w-0"><span class="font-medium ' + nameClass + ' block truncate">' + esc(t.name) + '</span>' +
                        '<span class="text-sm text-gray-500">' + (t.property_count || 0) + ' und. × $' + saasUnitPriceForTenant(t).toFixed(2) + '</span></div>' + right;
                    if (eligible) {
                        const idJs = String(t.id).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
                        return '<button type="button" onclick="selectSaaSTenantInModal(\'' + idJs + '\'); closeSaaSTenantPickerModal();" class="' + base + ' hover:bg-gray-50 transition">' + inner + '</button>';
                    }
                    const tip = 'Ya existe facturación SaaS para el mes y año del período seleccionado. No se puede generar otra factura desde aquí.';
                    return '<div class="' + base + ' opacity-80 cursor-not-allowed bg-red-50/40 border-l-4 border-l-red-400" aria-disabled="true" title="' + tip.replace(/"/g, '&quot;') + '">' + inner + '</div>';
                }).join('');
            }
            document.getElementById('saas-tenant-picker-modal').classList.remove('hidden');
        }

        function closeSaaSTenantPickerModal() {
            document.getElementById('saas-tenant-picker-modal').classList.add('hidden');
        }

