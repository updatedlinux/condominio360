        }

        /**
         * Copia al portapapeles condominios, inmuebles, datos actuales y datos nuevos (valores actuales del formulario).
         */
        async function copyDurSummaryToClipboard() {
            if (!durCurrentDetail || !durCurrentDetail.request) {
                showSnackbar('No hay datos cargados para copiar', 'error');
                return;
            }
            const d = durCurrentDetail;
            const req = d.request;
            const oldData = req.old_data || {};
            const newDataFallback = req.new_data || {};

            const tenantsLines = (d.tenants || []).length
                ? (d.tenants || []).map(t => `- ${t.name}`).join('\n')
                : '—';
            const propsLines = (d.properties || []).length
                ? (d.properties || []).map(p => `- ${p.tenant_name} - ${p.name || p.building_name || ''}`).join('\n')
                : '—';

            const getInput = (id) => {
                const el = document.getElementById(id);
                if (el && typeof el.value === 'string') return el.value.trim();
                return null;
            };
            const nf = getInput('dur-edit-first_name');
            const nl = getInput('dur-edit-last_name');
            const nd = getInput('dur-edit-dni');
            const ne = getInput('dur-edit-email');
            const np = getInput('dur-edit-phone');

            const newFirst = nf !== null ? nf : (newDataFallback.first_name || '');
            const newLast = nl !== null ? nl : (newDataFallback.last_name || '');
            const newDni = nd !== null ? nd : (newDataFallback.dni || '');
            const newEmail = ne !== null ? ne : (newDataFallback.email || '');
            const newPhone = np !== null ? np : (newDataFallback.phone || '');

            const statusLabel = req.status === 'PENDING' ? 'Pendiente' : (req.status === 'APPROVED' ? 'Aprobada' : (req.status === 'REJECTED' ? 'Rechazada' : String(req.status || '')));

            const lines = [
                'Solicitud de actualización de datos — Condominio360',
                '',
                'Estado: ' + statusLabel,
                '',
                'Condominios',
                tenantsLines,
                '',
                'Inmuebles',
                propsLines,
                '',
                'Datos actuales',
                'Nombre: ' + (oldData.first_name != null && oldData.first_name !== '' ? oldData.first_name : '—'),
                'Apellido: ' + (oldData.last_name != null && oldData.last_name !== '' ? oldData.last_name : '—'),
                'Cédula: ' + (oldData.dni != null && oldData.dni !== '' ? oldData.dni : '—'),
                'Correo: ' + (oldData.email != null && oldData.email !== '' ? oldData.email : '—'),
                'Teléfono: ' + (oldData.phone != null && oldData.phone !== '' ? oldData.phone : '—'),
                '',
                'Datos nuevos (solicitados / editados en el formulario)',
                'Nombre: ' + (newFirst || '—'),
                'Apellido: ' + (newLast || '—'),
                'Cédula: ' + (newDni || '—'),
                'Correo: ' + (newEmail || '—'),
                'Teléfono: ' + (newPhone || '—'),
                ''
            ];
            const resolvedC = document.getElementById('dur-admin-comment-readonly-text')?.textContent?.trim();
            const draftC = document.getElementById('dur-owner-comment')?.value?.trim();
            const commentForCopy = resolvedC || draftC;
            if (commentForCopy) {
                lines.push('Comentario del administrador');
                lines.push(commentForCopy);
                lines.push('');
            }
            lines.push('Fecha de solicitud: ' + (document.getElementById('dur-requested-at')?.textContent || '—') + ' (GMT-4)');
            const text = lines.join('\n');

            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(text);
                } else {
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    ta.setAttribute('readonly', '');
                    ta.style.position = 'fixed';
                    ta.style.left = '-9999px';
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                }
                showSnackbar('Resumen copiado al portapapeles', 'success');
            } catch (err) {
                console.error('copyDurSummaryToClipboard', err);
                showSnackbar('No se pudo copiar. Intente de nuevo o copie manualmente.', 'error');
            }
        }

        async function approveDurRequest() {
            if (!durCurrentDetail) return;
            const id = durCurrentDetail.request.id;
            const newData = {
                first_name: document.getElementById('dur-edit-first_name').value.trim(),
                last_name: document.getElementById('dur-edit-last_name').value.trim(),
                dni: document.getElementById('dur-edit-dni').value.trim(),
                email: document.getElementById('dur-edit-email').value.trim(),
                phone: document.getElementById('dur-edit-phone').value.trim() || null
            };
            try {
                const ownerComment = document.getElementById('dur-owner-comment')?.value?.trim() || null;
                const res = await fetch(`/api/admin/data-update-requests/${id}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify({ new_data: newData, comment: ownerComment })
                });
