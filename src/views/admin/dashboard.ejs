                <input type="text" id="dur-reject-reason" placeholder="Ej: Datos no verificados" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm">
            </div>
            <div class="flex gap-3 justify-end">
                <button type="button" onclick="rejectDurRequest()" class="px-4 py-2 border border-red-200 text-red-600 rounded-lg hover:bg-red-50 font-medium">
                    Rechazar
                </button>
                <button type="button" onclick="approveDurRequest()" class="px-4 py-2 bg-[var(--md-sys-color-primary)] text-white rounded-lg hover:opacity-90 font-medium">
