        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full max-h-[80vh] flex flex-col" onclick="event.stopPropagation()">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
                <h3 class="text-lg font-medium text-gray-900">Seleccionar Condominio</h3>
                <button onclick="closeSaaSTenantPickerModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                    <span class="material-symbols-rounded text-gray-600">close</span>
                </button>
            </div>
            <div id="saas-tenant-picker-list" class="overflow-y-auto flex-1 divide-y divide-gray-100">
                <p class="p-4 text-sm text-gray-500">Cargando...</p>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Factura SaaS -->
    <div id="saas-invoice-detail-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4" onclick="if(event.target===this)closeSaaSInvoiceDetail()">
        <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full max-h-[90vh] flex flex-col" onclick="event.stopPropagation()">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="text-xl font-medium text-gray-900">Detalle de factura</h3>
                <button onclick="closeSaaSInvoiceDetail()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100">
                    <span class="material-symbols-rounded text-gray-600">close</span>
                </button>
            </div>
            <div id="saas-invoice-detail-content" class="p-6 overflow-y-auto flex-1">
                <p class="text-gray-500">Cargando...</p>
            </div>
        </div>
    </div>

    <!-- Modal Rechazar Reporte SaaS -->
    <div id="saas-reject-modal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4" onclick="if(event.target===this)closeSaaSRejectModal()">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6" onclick="event.stopPropagation()">
            <h3 class="text-lg font-medium text-gray-900 mb-2">Rechazar reporte de pago</h3>
            <p class="text-sm text-gray-500 mb-4">Indica el motivo del rechazo para que la junta pueda corregir y volver a reportar.</p>
            <textarea id="saas-reject-reason" placeholder="Ej: Referencia incorrecta, monto no coincide..." class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm mb-4" rows="3"></textarea>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeSaaSRejectModal()" class="px-4 py-2 border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50">Cancelar</button>
                <button type="button" onclick="submitSaaSReject()" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">Rechazar</button>
            </div>
        </div>
    </div>

    <!-- New Tenant Modal -->
    <div id="modal-overlay" class="md-modal-overlay" onclick="closeNewTenantModal()"></div>
    <div id="new-tenant-modal" class="md-modal">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <div>
                <h3 class="text-xl font-medium text-gray-900">Nuevo Condominio</h3>
                <p class="text-sm text-gray-500">Completa la información para crear un nuevo conjunto residencial</p>
            </div>
            <button onclick="closeNewTenantModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                <span class="material-symbols-rounded text-gray-600">close</span>
            </button>
        </div>

        <!-- Progress Steps -->
        <div class="px-6 py-4 bg-gray-50/50 border-b border-gray-100 overflow-hidden">
            <div id="wizard-steps-container" class="flex items-center overflow-x-auto overflow-y-hidden pb-1 scroll-smooth" style="scroll-behavior: smooth; -webkit-overflow-scrolling: touch;">
                <div id="wizard-steps-track" class="flex items-center flex-nowrap gap-2 sm:gap-3 min-w-max pr-4">
                <div id="step-indicator-1" class="flex items-center gap-2 flex-shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[var(--md-sys-color-primary)] text-white flex items-center justify-center text-sm font-medium">1</div>
                    <span class="text-sm font-medium text-gray-900 whitespace-nowrap hidden sm:inline">Condominio</span>
                </div>
                <div class="w-4 sm:w-6 h-0.5 bg-gray-200 flex-shrink-0"></div>
                <div id="step-indicator-2" class="flex items-center gap-2 flex-shrink-0">
                    <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium">2</div>
                    <span class="text-sm font-medium text-gray-500 whitespace-nowrap hidden sm:inline">Facturación</span>
                </div>
                <div class="w-4 sm:w-6 h-0.5 bg-gray-200 flex-shrink-0"></div>
                <div id="step-indicator-3" class="flex items-center gap-2 flex-shrink-0">
                    <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium">3</div>
                    <span class="text-sm font-medium text-gray-500 whitespace-nowrap hidden sm:inline">Edificios/Calles</span>
                </div>
                <div class="w-4 sm:w-6 h-0.5 bg-gray-200 flex-shrink-0"></div>
                <div id="step-indicator-4" class="flex items-center gap-2 flex-shrink-0">
                    <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium">4</div>
                    <span class="text-sm font-medium text-gray-500 whitespace-nowrap hidden sm:inline">Administrador</span>
                </div>
                <div class="w-4 sm:w-6 h-0.5 bg-gray-200 flex-shrink-0"></div>
                <div id="step-indicator-5" class="flex items-center gap-2 flex-shrink-0">
                    <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium">5</div>
                    <span class="text-sm font-medium text-gray-500 whitespace-nowrap hidden sm:inline">Revisar</span>
                </div>
                </div>
            </div>
            <div class="mt-3 md-linear-progress">
                <div id="progress-bar" class="md-linear-progress-bar" style="width: 20%"></div>
            </div>
        </div>

        <!-- Modal Body -->
        <div class="p-6 overflow-y-auto max-h-[50vh]">
            <form id="new-tenant-form">
                <!-- Step 1: Tenant Info -->
                <div id="step-1" class="space-y-4">
                    <div class="md-text-field">
                        <input type="text" id="tenant-name" name="name" required placeholder=" ">
                        <label for="tenant-name">Nombre del Condominio *</label>
                    </div>
                    <div class="md-text-field">
                        <input type="text" id="tenant-slug" name="slug" required placeholder=" " 
                            pattern="[a-z0-9-]+" oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9-]/g, '')">
                        <label for="tenant-slug">Slug (identificador único) *</label>
                        <p class="text-xs text-gray-500 mt-1 ml-2">Solo minúsculas, números y guiones</p>
                    </div>
                    <div class="md-text-field">
                        <textarea id="tenant-address" name="address" rows="3" placeholder=" "></textarea>
                        <label for="tenant-address">Dirección</label>
                    </div>
                </div>

                <!-- Step 2: Billing Type -->
                <div id="step-2" class="space-y-4 hidden">
                    <div class="bg-blue-50 p-4 rounded-xl mb-4">
                        <p class="text-sm text-blue-700 flex items-center gap-2">
                            <span class="material-symbols-rounded text-blue-600">info</span>
                            Selecciona el tipo de facturación para este condominio. Esto determinará cómo se distribuyen los gastos.
                        </p>
                    </div>
                    
                    <div class="space-y-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tipo de Facturación *</label>
                        
                        <div class="space-y-3">
                            <label class="flex items-start gap-3 p-4 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-[var(--md-sys-color-primary)] transition-colors has-[:checked]:border-[var(--md-sys-color-primary)] has-[:checked]:bg-blue-50/50">
                                <input type="radio" name="billing_type" value="FIXED" class="mt-1" checked onchange="updateBillingType(this.value)">
                                <div>
                                    <div class="font-medium text-gray-900">Cuota Fija</div>
                                    <div class="text-sm text-gray-500">Todos los propietarios pagan el mismo monto fijo mensual</div>
                                </div>
                            </label>
                            
                            <label class="flex items-start gap-3 p-4 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-[var(--md-sys-color-primary)] transition-colors has-[:checked]:border-[var(--md-sys-color-primary)] has-[:checked]:bg-blue-50/50">
                                <input type="radio" name="billing_type" value="ALICUOTA" class="mt-1" onchange="updateBillingType(this.value)">
                                <div>
                                    <div class="font-medium text-gray-900">Por Alícuota</div>
                                    <div class="text-sm text-gray-500">Cada propietario paga según su porcentaje de participación</div>
                                </div>
                            </label>
                        </div>
                    </div>
                    
                    <div id="alicuota-info" class="hidden bg-amber-50 p-4 rounded-xl">
                        <p class="text-sm text-amber-700 flex items-center gap-2">
                            <span class="material-symbols-rounded text-amber-600">warning</span>
                            <strong>Importante:</strong> Deberás crear los inmuebles e indicar su alícuota. La suma de todas las alícuotas debe ser exactamente 100%.
                        </p>
                    </div>
                </div>

                <!-- Step 3: Buildings -->
                <div id="step-3" class="space-y-4 hidden">
                    <div class="bg-blue-50 p-4 rounded-xl mb-4">
                        <p class="text-sm text-blue-700 flex items-center gap-2">
                            <span class="material-symbols-rounded text-blue-600">info</span>
                            Configura los edificios ó calles del conjunto residencial.
                        </p>
                    </div>
                    
                    <div class="space-y-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Configuración de Edificios/Calles *</label>
                        
                        <div class="md-segmented-button">
                            <div class="md-segment active" onclick="setBuildingType('SINGLE')" id="segment-single">
                                <span class="material-symbols-rounded text-sm mr-1">apartment</span>
                                Único Edificio/Calle
                            </div>
                            <div class="md-segment" onclick="setBuildingType('MULTIPLE')" id="segment-multiple">
                                <span class="material-symbols-rounded text-sm mr-1">domain</span>
                                Múltiples Edificios/Calles
                            </div>
                        </div>
                        <input type="hidden" id="building-type" name="building_type" value="SINGLE">
                        
                        <!-- Single Building Info -->
                        <div id="single-building-info" class="mt-4">
                            <div class="md-text-field">
                                <input type="text" id="single-building-name" value="Edificio Principal" readonly placeholder=" ">
                                <label>Edificio/Calle principal</label>
                            </div>
                        </div>
                        
                        <!-- Multiple Buildings List -->
                        <div id="multiple-buildings-container" class="hidden mt-4 space-y-3">
                            <div class="flex items-center justify-between">
                                <label class="text-sm font-medium text-gray-700">Edificios/Calles</label>
                                <button type="button" onclick="addBuilding()" class="text-sm text-[var(--md-sys-color-primary)] hover:underline">
                                    + Agregar Edificio/Calle
                                </button>
                            </div>
                            <div id="buildings-list" class="space-y-3">
                                <!-- Buildings will be added here -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Admin Info -->
                <div id="step-4" class="space-y-4 hidden">
                    <div class="bg-blue-50 p-4 rounded-xl mb-4">
                        <p class="text-sm text-blue-700 flex items-center gap-2">
                            <span class="material-symbols-rounded text-blue-600">info</span>
                            Crea el primer administrador de junta. El SuperAdmin asigna la contraseña inicial.
                        </p>
                    </div>
                    <div class="md-text-field">
                        <input type="text" id="admin-display-name" name="display_name" required placeholder=" ">
                        <label for="admin-display-name">Nombre de Usuario *</label>
                    </div>
                    <div class="md-text-field">
                        <input type="email" id="admin-email" name="email" required placeholder=" ">
                        <label for="admin-email">Email *</label>
                    </div>
                    <div class="md-text-field">
                        <input type="password" id="admin-password" name="password" required placeholder=" " 
                            minlength="6">
                        <label for="admin-password">Contraseña inicial *</label>
                    </div>
                    <div class="md-text-field">
                        <input type="tel" id="admin-phone" name="phone" placeholder=" ">
                        <label for="admin-phone">Teléfono (opcional)</label>
                    </div>
                </div>

                <!-- Step 5: Review -->
                <div id="step-5" class="hidden space-y-4">
                    <div class="bg-gray-50 p-4 rounded-xl">
                        <h4 class="font-medium text-gray-900 mb-3 flex items-center gap-2">
                            <span class="material-symbols-rounded text-gray-500">apartment</span>
                            Datos del Condominio
                        </h4>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Nombre:</span>
                                <span class="text-gray-900 font-medium" id="review-name"></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Slug:</span>
                                <span class="text-gray-900 font-medium" id="review-slug"></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Dirección:</span>
                                <span class="text-gray-900" id="review-address"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-gray-50 p-4 rounded-xl">
                        <h4 class="font-medium text-gray-900 mb-3 flex items-center gap-2">
                            <span class="material-symbols-rounded text-gray-500">payments</span>
                            Configuración de Facturación
                        </h4>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Tipo:</span>
                                <span class="text-gray-900 font-medium" id="review-billing-type"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-gray-50 p-4 rounded-xl">
                        <h4 class="font-medium text-gray-900 mb-3 flex items-center gap-2">
                            <span class="material-symbols-rounded text-gray-500">domain</span>
                            Edificios/Calles
                        </h4>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Tipo:</span>
                                <span class="text-gray-900 font-medium" id="review-building-type"></span>
                            </div>
                            <div id="review-buildings-list" class="mt-2"></div>
                        </div>
                    </div>
                    
                    <div class="bg-gray-50 p-4 rounded-xl">
                        <h4 class="font-medium text-gray-900 mb-3 flex items-center gap-2">
                            <span class="material-symbols-rounded text-gray-500">person</span>
                            Administrador Principal
                        </h4>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-500">Nombre:</span>
                                <span class="text-gray-900 font-medium" id="review-admin-name"></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-500">Email:</span>
                                <span class="text-gray-900" id="review-admin-email"></span>
                            </div>
                        </div>
                    </div>
                    <div class="bg-amber-50 p-4 rounded-xl flex items-start gap-3">
                        <span class="material-symbols-rounded text-amber-600">mail</span>
                        <p class="text-sm text-amber-700">Al confirmar, se enviará un email de bienvenida con las credenciales de acceso al administrador.</p>
                    </div>
                </div>
            </form>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 border-t border-gray-100 flex justify-between bg-gray-50/50">
            <button type="button" id="btn-prev" class="md-button md-button-text hidden" onclick="prevStep()">
                <span class="material-symbols-rounded">arrow_back</span>
                Anterior
            </button>
            <div class="flex-1"></div>
            <button type="button" id="btn-next" class="md-button md-button-filled" onclick="nextStep()">
                Siguiente
                <span class="material-symbols-rounded">arrow_forward</span>
            </button>
            <button type="button" id="btn-submit" class="md-button md-button-filled hidden" onclick="submitTenant()" disabled>
                <span class="material-symbols-rounded">check</span>
                Crear Condominio
            </button>
        </div>
    </div>

    <!-- Modal: Crear Superadmin -->
    <div id="superadmin-modal-overlay" class="md-modal-overlay" onclick="closeSuperAdminModal()"></div>
    <div id="superadmin-modal" class="md-modal">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <div>
                <h3 class="text-xl font-medium text-gray-900">Nuevo Superadministrador</h3>
                <p class="text-sm text-gray-500">Complete los datos para crear un usuario con acceso total al panel</p>
            </div>
            <button onclick="closeSuperAdminModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                <span class="material-symbols-rounded text-gray-600">close</span>
            </button>
        </div>
        <form id="superadmin-form" class="p-6 space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div class="md-text-field">
                    <input type="text" id="sa-first-name" required placeholder=" " maxlength="100">
                    <label for="sa-first-name">Nombre *</label>
                </div>
                <div class="md-text-field">
                    <input type="text" id="sa-last-name" required placeholder=" " maxlength="100">
                    <label for="sa-last-name">Apellido *</label>
                </div>
            </div>
            <div class="md-text-field">
                <input type="email" id="sa-email" required placeholder=" ">
                <label for="sa-email">Email *</label>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="md-text-field">
                    <input type="password" id="sa-password" required placeholder=" " minlength="6" autocomplete="new-password">
                    <label for="sa-password">Contraseña *</label>
                </div>
                <div class="md-text-field">
                    <input type="password" id="sa-password-confirm" required placeholder=" " minlength="6" autocomplete="new-password">
                    <label for="sa-password-confirm">Confirmar contraseña *</label>
                </div>
            </div>
            <p class="text-xs text-gray-500">Mínimo 6 caracteres</p>
            <div class="md-text-field">
                <input type="tel" id="sa-phone" placeholder=" " maxlength="20">
                <label for="sa-phone">Teléfono (opcional)</label>
            </div>
        </form>
        <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3 bg-gray-50/50">
            <button type="button" onclick="closeSuperAdminModal()" class="md-button md-button-text">Cancelar</button>
            <button type="button" onclick="submitSuperAdmin()" class="md-button md-button-filled">
                <span class="material-symbols-rounded">person_add</span>
                Crear Superadmin
            </button>
        </div>
    </div>

    <!-- Modal: Confirmar Eliminación -->
    <div id="confirm-modal-overlay" class="md-modal-overlay" onclick="closeConfirmModal()"></div>
    <div id="confirm-modal" class="md-modal max-w-md">
        <div class="p-6 text-center">
            <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-rounded text-4xl text-red-600">warning</span>
            </div>
            <h3 id="confirm-modal-title" class="text-xl font-semibold text-gray-900 mb-2">Confirmar eliminación</h3>
            <p id="confirm-modal-message" class="text-gray-600 mb-6">Esta acción no se puede deshacer.</p>
            <div class="flex gap-3 justify-center">
                <button type="button" onclick="closeConfirmModal()" class="px-6 py-3 border border-gray-200 rounded-xl text-gray-600 font-medium hover:bg-gray-50 transition">
                    Cancelar
                </button>
                <button type="button" id="confirm-modal-btn" onclick="executeConfirmAction()" class="px-6 py-3 bg-red-500 text-white rounded-xl font-medium hover:bg-red-600 transition flex items-center gap-2">
                    <span class="material-symbols-rounded">delete</span>
                    Eliminar
                </button>
            </div>
        </div>
    </div>

    <!-- Modal: Solicitud Actualización de Datos -->
    <div id="dur-modal-overlay" class="md-modal-overlay" onclick="closeDurModal()"></div>
    <div id="dur-modal" class="md-modal max-w-2xl max-h-[90vh] overflow-hidden flex flex-col">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between gap-3 bg-gray-50/50 flex-shrink-0">
            <h3 class="text-xl font-medium text-gray-900 min-w-0">Solicitud de Actualización de Datos</h3>
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" id="dur-copy-btn" onclick="copyDurSummaryToClipboard()" class="hidden md-button md-button-outlined normal-case text-sm px-3 py-2 font-medium tracking-normal hover:bg-gray-50/80" title="Copiar resumen para pegar en correo u otro mensaje">
                    <span class="material-symbols-rounded text-lg">content_copy</span>
                    Copiar
                </button>
                <button type="button" onclick="closeDurModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition" aria-label="Cerrar">
                    <span class="material-symbols-rounded text-gray-600">close</span>
                </button>
            </div>
        </div>
        <div class="p-6 overflow-y-auto flex-1 space-y-6">
            <div id="dur-modal-loading" class="text-center py-8 text-gray-500">Cargando...</div>
            <div id="dur-modal-content" class="hidden space-y-6">
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-sm text-amber-800">
                    <strong>Importante:</strong> Los cambios afectarán la información del usuario en todos los inmuebles y condominios asociados.
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <h4 class="font-medium text-gray-700 mb-2">Condominios</h4>
                        <ul id="dur-tenants" class="text-sm text-gray-600 space-y-1"></ul>
                    </div>
                    <div>
                        <h4 class="font-medium text-gray-700 mb-2">Inmuebles</h4>
                        <ul id="dur-properties" class="text-sm text-gray-600 space-y-1"></ul>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <h4 class="font-medium text-gray-700 mb-2">Datos actuales</h4>
                        <div id="dur-old-data" class="space-y-2 text-sm bg-gray-50 p-4 rounded-lg"></div>
                    </div>
                    <div>
                        <h4 class="font-medium text-gray-700 mb-2">Datos nuevos (editables)</h4>
                        <div id="dur-new-data-form" class="space-y-4"></div>
                    </div>
                </div>
                <div id="dur-admin-comment-readonly" class="hidden rounded-xl border border-gray-200 bg-gray-50 p-4 text-sm">
                    <p class="text-xs font-medium text-gray-500 mb-1">Comentario del administrador <span id="dur-admin-comment-kind" class="text-gray-400 font-normal"></span></p>
                    <p id="dur-admin-comment-readonly-text" class="text-gray-800 whitespace-pre-wrap"></p>
                </div>
                <div class="text-sm text-gray-500">
                    <span id="dur-requested-at"></span> (GMT-4)
                </div>
            </div>
        </div>
        <div id="dur-modal-actions" class="px-6 py-4 border-t border-gray-100 space-y-3 bg-gray-50/50 flex-shrink-0 hidden">
            <div>
                <label class="block text-xs text-gray-500 mb-1">Comentario para el propietario (opcional)</label>
                <p class="text-xs text-gray-400 mb-1">Se enviará por correo al aprobar o al rechazar (mensaje informativo o motivo del rechazo).</p>
                <input type="text" id="dur-owner-comment" placeholder="Ej: Datos verificados con documentación / Motivo del rechazo" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm">
            </div>
            <div class="flex gap-3 justify-end">
                <button type="button" onclick="rejectDurRequest()" class="px-4 py-2 border border-red-200 text-red-600 rounded-lg hover:bg-red-50 font-medium">
                    Rechazar
                </button>
                <button type="button" onclick="approveDurRequest()" class="px-4 py-2 bg-[var(--md-sys-color-primary)] text-white rounded-lg hover:opacity-90 font-medium">
                    Aprobar
                </button>
            </div>
        </div>
    </div>

    <!-- Modal detalle job correo -->
    <div id="email-job-modal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-4xl w-full max-h-[90vh] flex flex-col">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
                <h3 class="text-lg font-medium text-gray-900" id="email-job-modal-title">Detalle de envío</h3>
                <button type="button" onclick="closeEmailJobModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100">
                    <span class="material-symbols-rounded text-gray-600">close</span>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-1 text-sm" id="email-job-modal-body">
                <p class="text-gray-500">Cargando…</p>
            </div>
        </div>
    </div>

    <div id="email-logs-modal" class="fixed inset-0 z-[70] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4" onclick="if(event.target===this)closeEmailLogsModal()">
        <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full max-h-[85vh] flex flex-col" onclick="event.stopPropagation()">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
                <h3 class="text-lg font-medium text-gray-900">Logs del envío</h3>
                <button type="button" onclick="closeEmailLogsModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100" aria-label="Cerrar">
                    <span class="material-symbols-rounded text-gray-600">close</span>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-1">
                <pre id="email-logs-modal-body" class="text-xs text-gray-700 whitespace-pre-wrap font-mono leading-relaxed"></pre>
            </div>
            <div class="px-6 py-3 border-t border-gray-100 flex justify-end flex-shrink-0">
                <button type="button" onclick="closeEmailLogsModal()" class="px-4 py-2 rounded-lg bg-[var(--md-sys-color-primary)] text-white text-sm font-medium hover:opacity-90">Cerrar</button>
            </div>
        </div>
    </div>

    <%- include('../partials/page-notifications') %>
    <script src="/js/page-notifications.js?v=2"></script>

    <script>
        // Global State
        let currentStep = 1;
        let tenantsData = [];
        let currentFilter = 'all';
        let token = localStorage.getItem('token');
        let user = JSON.parse(localStorage.getItem('user') || '{}');
        let pendingConfirmAction = null;
        let emailJobsPage = 1;
        let waDeliveriesPage = 1;
        let waDeliveriesTotalPages = 1;
        let waWebhookPage = 1;
        let waWebhookTotalPages = 1;
        let outgoingQueuesPollId = null;

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            if (!token || !user.isSuperAdmin) {
                window.location.href = '/login';
                return;
            }

            // Set user info
            document.getElementById('admin-name').textContent = (user.firstName || '') + ' ' + (user.lastName || '');
            document.getElementById('admin-initial').textContent = (user.firstName || 'A')[0];

            // Load data
            loadDashboard();
            startOutgoingQueuesPolling();
            initOutgoingQueuesCollapseState();
            applySectionFromQuery();

            // Setup sidebar toggle
            document.getElementById('menu-toggle').addEventListener('click', toggleSidebar);

            // Setup validation listeners for wizard
            setupValidationListeners();
        });

        // Sidebar Toggle (desktop: expand/collapse)
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('main-content');
            const icon = document.querySelector('#menu-toggle .material-symbols-rounded');
            if (!icon) return;
            if (sidebar.classList.contains('expanded')) {
                sidebar.classList.remove('expanded');
                sidebar.classList.add('collapsed');
                mainContent.style.marginLeft = '80px';
                icon.textContent = 'menu_open';
            } else {
                sidebar.classList.remove('collapsed');
                sidebar.classList.add('expanded');
                mainContent.style.marginLeft = '300px';
                icon.textContent = 'menu';
            }
        }

        // Mobile Sidebar Toggle (abrir/cerrar menú en móvil)
        function toggleAdminMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('admin-mobile-overlay');
            sidebar.classList.toggle('mobile-open');
            overlay.classList.toggle('active');
        }

        /** Si la URL es /admin?section=auditoría|email|..., abrir esa sección del SPA y limpiar query */
        function applySectionFromQuery() {
            const allowed = new Set([
                'dashboard', 'tenants', 'users', 'data-updates', 'audit', 'email',
                'mass-whatsapp', 'saas-billing', 'balance-financiero', 'reconciliation-banks', 'settings'
            ]);
            const params = new URLSearchParams(window.location.search);
            const section = params.get('section');
            if (!section || !allowed.has(section)) return;
            const el = document.querySelector('[data-nav-section="' + section.replace(/"/g, '') + '"]');
            if (el && typeof showSection === 'function') {
                showSection(section, el);
                if (window.history && window.history.replaceState) {
                    window.history.replaceState({}, '', '/admin');
                }
            }
        }

        // Section Navigation
        function showSection(sectionName, navEl) {
            // En móvil, cerrar sidebar al seleccionar
            if (window.innerWidth < 1024) {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('admin-mobile-overlay');
                if (sidebar && overlay && sidebar.classList.contains('mobile-open')) {
                    sidebar.classList.remove('mobile-open');
                    overlay.classList.remove('active');
                }
            }
            // Hide all sections (selector: sections dentro de main)
            document.querySelectorAll('#main-content section[id^="section-"]').forEach(s => s.classList.add('hidden'));
            
            // Show selected
            const target = document.getElementById(`section-${sectionName}`);
            if (target) target.classList.remove('hidden');
            
            // Update nav items
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            if (navEl) navEl.classList.add('active');
            
            // Update page title
            const titles = {
                'dashboard': 'Dashboard',
                'tenants': 'Condominios',
                'users': 'Superadministradores',
                'data-updates': 'Actualización de Datos',
                'audit': 'Auditoría',
                'saas-billing': 'Facturación Condominio360',
                'balance-financiero': 'Balance Financiero',
                'reconciliation-banks': 'Conciliación bancaria',
                'email': 'Correo saliente',
                'mass-whatsapp': 'Mensajería masiva',
                'settings': 'Configuración'
            };
            document.getElementById('page-title').textContent = titles[sectionName];

            // Load section data if needed
            if (sectionName === 'tenants' && tenantsData.length === 0) {
                loadTenants();
            } else if (sectionName === 'users') {
                loadSuperAdmins();
            } else if (sectionName === 'data-updates') {
                loadDataUpdateRequests();
            } else if (sectionName === 'audit') {
                loadAuditLogs();
            } else if (sectionName === 'saas-billing') {
                loadSaaSBilling();
            } else if (sectionName === 'balance-financiero') {
                loadBalanceFinanciero();
            } else if (sectionName === 'reconciliation-banks') {
                loadReconciliationBanks();
            } else if (sectionName === 'email') {
                loadEmailPanel();
            } else if (sectionName === 'mass-whatsapp') {
                loadMassWhatsAppPanel();
            } else if (sectionName === 'dashboard') {
                loadBcvSettings();
                loadOutgoingQueuesSummary();
            }
        }

        // Data Loading
        async function loadDashboard() {
            await Promise.all([
                loadStats(),
                loadActivity(),
                loadBcvSettings(),
                loadOutgoingQueuesSummary()
            ]);
        }

        function formatOutgoingQueuesTime(iso) {
            if (!iso) return '—';
            try {
                return new Date(iso).toLocaleString('es-VE', { timeZone: 'America/Caracas' });
            } catch (e) {
                return '—';
            }
        }

        function renderOutgoingQueuesHtml(d) {
            const c = d.communiques || {};
            const mq = d.mailgun_jobs || {};
            const nq = d.notification_queue || {};
            const bw = d.bulk_owner_welcome || {};
            const active = d.has_activity === true;
            const rows = [];
            rows.push('<div class="rounded-lg border border-gray-100 divide-y divide-gray-100 overflow-hidden">');
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5 bg-gray-50/80"><span class="text-gray-600">Comunicados (juntas) — lotes pendientes / en proceso</span><strong class="text-gray-900">${c.pending_batches ?? 0} / ${c.processing_batches ?? 0}</strong></div>`);
            const pNoQ = c.pending_emails_without_active_queue ?? 0;
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5"><span class="text-gray-600">Comunicados — destinatarios “pending” en base de datos (aún no marcados como enviados)</span><strong class="text-gray-900">${c.pending_emails ?? 0}</strong></div>`);
            if ((c.pending_emails ?? 0) > 0 && pNoQ > 0) {
                rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5 bg-slate-50"><span class="text-gray-600">De esos, sin ningún lote pendiente en la cola del worker (el cron ya no los procesa)</span><strong class="text-slate-800">${pNoQ}</strong></div>`);
            }
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5 bg-gray-50/80"><span class="text-gray-600">Condominios con cola de comunicados activa</span><strong class="text-gray-900">${c.tenants_with_queue ?? 0}</strong></div>`);
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5"><span class="text-gray-600">Mailgun — destinatarios en cola (pending / retry / processing)</span><strong class="text-gray-900">${mq.recipients_pending ?? 0}</strong></div>`);
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5 bg-gray-50/80"><span class="text-gray-600">Mailgun — jobs con destinatarios pendientes</span><strong class="text-gray-900">${mq.jobs_open ?? 0}</strong></div>`);
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5"><span class="text-gray-600">Cola interna (p. ej. facturación)</span><strong class="text-gray-900">${nq.pending ?? 0}</strong></div>`);
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5 bg-gray-50/80"><span class="text-gray-600">Bienvenida masiva propietarios — lotes activos</span><strong class="text-gray-900">${bw.active_batches ?? 0}</strong></div>`);
            const wa = d.whatsapp_mass || {};
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5"><span class="text-gray-600">WhatsApp (mensajes in-app) — destinatarios pendientes en cola interna</span><strong class="text-gray-900">${wa.pending_in_queue ?? 0}</strong></div>`);
            rows.push(`<div class="flex flex-wrap justify-between gap-2 px-3 py-2.5 bg-gray-50/80"><span class="text-gray-600">WhatsApp — uso de cupo global en ventana 2 min (máx. ${wa.rate_max_per_window ?? 30})</span><strong class="text-gray-900">${wa.sends_in_rate_window ?? 0} / ${wa.rate_max_per_window ?? 30}</strong></div>`);
            rows.push('</div>');
            rows.push('<p class="mt-3 text-xs text-gray-500 leading-relaxed">Los webhooks de Mailgun guardan entregas y rebotes en el historial; <strong>no</strong> actualizan el estado del job. Este panel se basa en destinatarios y lotes pendientes en base de datos.</p>');
            if (pNoQ > 0 && (c.active_batches ?? 0) === 0) {
                rows.push('<p class="mt-2 text-sm text-slate-700 border-l-4 border-slate-300 pl-3">El log “no hay comunicados pendientes en la cola” se refiere a <strong>CommuniqueEmailQueue</strong> (lotes). Si aún ves destinatarios pending sin cola activa, no se reenviarán solos: hay que <strong>reencolar lotes</strong> (p. ej. script <code class="text-xs bg-slate-100 px-1 rounded">requeue-communique-batches</code>) o corregir datos.</p>');
            }
            if (!active) {
                rows.push('<p class="mt-3 text-emerald-700 text-sm flex items-center gap-2"><span class="material-symbols-rounded text-lg">check_circle</span> No hay trabajo pendiente en estas colas. Puedes operar con normalidad.</p>');
            } else {
                rows.push('<p class="mt-3 text-amber-800 text-sm flex items-center gap-2"><span class="material-symbols-rounded text-lg">warning</span> Hay envíos en curso o pendientes. Conviene esperar a que las cifras bajen antes de cambios delicados.</p>');
            }
            const br = c.breakdown;
            if (Array.isArray(br) && br.length > 0) {
                rows.push('<p class="mt-4 font-medium text-gray-800">Comunicados con lotes pendientes (detalle)</p>');
                rows.push('<ul class="mt-2 space-y-1.5 text-gray-600 text-sm list-disc pl-5 max-h-48 overflow-y-auto">');
                br.forEach((b) => {
                    const tn = escapeHtml(b.tenant_name || '');
                    const tt = escapeHtml(b.communique_title || '');
                    rows.push(`<li><span class="text-gray-500">${tn}</span> — ${tt} <span class="text-gray-400">(${b.batches_left ?? 0} lotes)</span></li>`);
                });
                rows.push('</ul>');
            }
            return rows.join('');
        }

        function styleOutgoingQueueWraps(hasActivity) {
            const dash = document.getElementById('outgoing-queues-dashboard-wrap');
            const em = document.getElementById('outgoing-queues-email-wrap');
            const wa = document.getElementById('outgoing-queues-wa-wrap');
            [dash, em, wa].forEach((el) => {
                if (!el) return;
                el.classList.remove('border-amber-200', 'bg-amber-50/40', 'border-gray-100', 'bg-white');
                if (hasActivity) {
                    el.classList.add('border-amber-200', 'bg-amber-50/40');
                } else {
                    el.classList.add('border-gray-100');
                }
            });
        }

        async function loadOutgoingQueuesSummary() {
            try {
                const res = await fetch('/api/admin/outgoing-queues-summary', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const json = await res.json();
                const dashBody = document.getElementById('outgoing-queues-dashboard-body');
                const emailBody = document.getElementById('outgoing-queues-email-body');
                const tDash = document.getElementById('outgoing-queues-updated-dash');
                const tEmail = document.getElementById('outgoing-queues-updated-email');
                const waBodyEarly = document.getElementById('outgoing-queues-wa-body');
                if (!json.success || !json.data) {
                    const err = '<p class="text-red-600">No se pudo cargar el resumen de colas.</p>';
                    if (dashBody) dashBody.innerHTML = err;
                    if (emailBody) emailBody.innerHTML = err;
                    if (waBodyEarly) waBodyEarly.innerHTML = err;
                    return;
                }
                const d = json.data;
                const html = renderOutgoingQueuesHtml(d);
                const ts = formatOutgoingQueuesTime(d.updated_at);
                if (dashBody) dashBody.innerHTML = html;
                if (emailBody) emailBody.innerHTML = html;
                if (tDash) tDash.textContent = 'Última lectura: ' + ts;
                if (tEmail) tEmail.textContent = 'Última lectura: ' + ts;
                const waBody = document.getElementById('outgoing-queues-wa-body');
                const tWa = document.getElementById('outgoing-queues-updated-wa');
                if (waBody) waBody.innerHTML = html;
                if (tWa) tWa.textContent = 'Última lectura: ' + ts;
                styleOutgoingQueueWraps(d.has_activity === true);
            } catch (e) {
                console.error('loadOutgoingQueuesSummary', e);
                const err = '<p class="text-red-600">Error de red al leer colas.</p>';
                const dashBody = document.getElementById('outgoing-queues-dashboard-body');
                const emailBody = document.getElementById('outgoing-queues-email-body');
                const waBody = document.getElementById('outgoing-queues-wa-body');
                if (dashBody) dashBody.innerHTML = err;
                if (emailBody) emailBody.innerHTML = err;
                if (waBody) waBody.innerHTML = err;
            }
        }

        function startOutgoingQueuesPolling() {
            if (outgoingQueuesPollId) clearInterval(outgoingQueuesPollId);
            outgoingQueuesPollId = setInterval(() => {
                if (document.visibilityState !== 'visible') return;
                loadOutgoingQueuesSummary();
                const waSec = document.getElementById('section-mass-whatsapp');
                if (waSec && !waSec.classList.contains('hidden')) {
                    loadWhatsAppDeliveries();
                    loadWhatsAppWebhookEvents();
                }
            }, 15000);
        }

        const OUTGOING_QUEUE_PANEL_IDS = {
            dash: ['outgoing-queues-dashboard-collapse', 'outgoing-queues-dash-chevron', 'outgoing-queues-dash-toggle'],
            email: ['outgoing-queues-email-collapse', 'outgoing-queues-email-chevron', 'outgoing-queues-email-toggle'],
            wa: ['outgoing-queues-wa-collapse', 'outgoing-queues-wa-chevron', 'outgoing-queues-wa-toggle']
        };

        function toggleOutgoingQueuesPanel(key) {
            const cfg = OUTGOING_QUEUE_PANEL_IDS[key];
            if (!cfg) return;
            const collapse = document.getElementById(cfg[0]);
            const chev = document.getElementById(cfg[1]);
            const btn = document.getElementById(cfg[2]);
            if (!collapse) return;
            const hidden = collapse.classList.toggle('hidden');
            if (chev) chev.textContent = hidden ? 'expand_more' : 'expand_less';
            if (btn) btn.setAttribute('aria-expanded', hidden ? 'false' : 'true');
            try {
                localStorage.setItem('outgoingQueuesCollapsed_' + key, hidden ? '1' : '0');
            } catch (e) { /* ignore */ }
        }

        function initOutgoingQueuesCollapseState() {
            for (const key of ['dash', 'email', 'wa']) {
                try {
                    if (localStorage.getItem('outgoingQueuesCollapsed_' + key) !== '1') continue;
                    const cfg = OUTGOING_QUEUE_PANEL_IDS[key];
                    if (!cfg) continue;
                    const collapse = document.getElementById(cfg[0]);
                    const chev = document.getElementById(cfg[1]);
                    const btn = document.getElementById(cfg[2]);
                    if (collapse) collapse.classList.add('hidden');
                    if (chev) chev.textContent = 'expand_more';
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                } catch (e) { /* ignore */ }
            }
        }

        async function loadWaTenantFilter() {
            const sel = document.getElementById('wa-filter-tenant');
            if (!sel) return;
            try {
                const res = await fetch('/api/admin/tenants', { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success || !json.data) return;
                const cur = sel.value;
                sel.innerHTML = '<option value="">Todos</option>' +
                    json.data.map((t) => `<option value="${t.id}">${escapeHtml(t.name || t.slug || t.id)}</option>`).join('');
                if (cur) sel.value = cur;
            } catch (e) {
                console.error('loadWaTenantFilter', e);
            }
        }

        async function loadOpenWAWebhookInfo() {
            try {
                const res = await fetch('/api/admin/openwa-webhook-info', { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success || !json.data) return;
                const d = json.data;
                const urlEl = document.getElementById('wa-webhook-url');
                if (urlEl) urlEl.textContent = d.webhookUrl || '—';
                const st = document.getElementById('wa-openwa-platform-status');
                if (st) {
                    st.textContent = d.openwaConfigured
                        ? (d.signatureConfigured ? 'OpenWA configurado en .env · firma webhook activa' : 'OpenWA configurado en .env · sin OPENWA_WEBHOOK_SECRET')
                        : 'Configure OPENWA_BASE_URL y OPENWA_API_KEY en el servidor';
                }
            } catch (e) {
                console.error('loadOpenWAWebhookInfo', e);
            }
        }

        async function loadMassWhatsAppPanel() {
            if (!user.isSuperAdmin) return;
            await loadOutgoingQueuesSummary();
            await loadWaTenantFilter();
            await loadOpenWAWebhookInfo();
            await loadWhatsAppDeliveries();
            await loadWhatsAppWebhookEvents();
        }

        async function loadWhatsAppDeliveries() {
            const tbody = document.getElementById('wa-deliveries-tbody');
            if (!tbody) return;
            const days = document.getElementById('wa-table-days')?.value || 30;
            const st = (document.getElementById('wa-filter-status')?.value || '').trim();
            const tid = (document.getElementById('wa-filter-tenant')?.value || '').trim();
            let url = `/api/admin/whatsapp-deliveries?page=${waDeliveriesPage}&limit=20&days=${encodeURIComponent(days)}`;
            if (st) url += `&status=${encodeURIComponent(st)}`;
            if (tid) url += `&tenantId=${encodeURIComponent(tid)}`;
            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success || !json.data) {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center py-8 text-red-600">${escapeHtml(json.error || 'Error')}</td></tr>`;
                    return;
                }
                const { metrics, rows, pagination, openwa } = json.data;
                waDeliveriesTotalPages = Math.max(1, pagination.pages || 1);
                if (waDeliveriesPage > waDeliveriesTotalPages) {
                    waDeliveriesPage = waDeliveriesTotalPages;
                    return loadWhatsAppDeliveries();
                }
                const m = metrics || {};
                const el = (id, v) => { const n = document.getElementById(id); if (n) n.textContent = v; };
                el('wa-metric-sent', m.sent_last_30d ?? '—');
                el('wa-metric-delivered', m.delivered_last_30d ?? '—');
                el('wa-metric-pending', m.pending_queue ?? '—');
                el('wa-metric-failed', m.failed_last_30d ?? '—');
                el('wa-metric-rate', `${m.sends_in_rate_window ?? 0} / ${m.rate_max_per_window ?? 30}`);
                if (openwa?.webhookUrl) {
                    const urlEl = document.getElementById('wa-webhook-url');
                    if (urlEl && urlEl.textContent === '—') urlEl.textContent = openwa.webhookUrl;
                }
                const pi = document.getElementById('wa-deliveries-page-info');
                if (pi) {
                    pi.textContent = `Página ${pagination.page} de ${pagination.pages} · ${pagination.total} registros`;
                }
                if (!rows || rows.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-500">No hay envíos en este periodo.</td></tr>';
                    return;
                }
                tbody.innerHTML = rows.map((r) => {
                    const owner = [r.first_name, r.last_name].filter(Boolean).join(' ') || '—';
                    const condo = escapeHtml(r.tenant_name || '—');
                    const chatDisp = escapeHtml(r.chat_id || r.phone_national || '—');
                    const msg = escapeHtml((r.message_body || r.notification_message || '').slice(0, 100));
                    const msgMore = (r.message_body || r.notification_message || '').length > 100 ? '…' : '';
                    const typeBadge = r.message_type && r.message_type !== 'TEXT'
                        ? `<span class="text-xs bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded">${escapeHtml(r.message_type)}</span> `
                        : '';
                    const scope = r.target_building ? `<div class="text-xs text-gray-400">${escapeHtml(r.target_building)}</div>` : '';
                    let queueHtml = '';
                    if (r.status === 'SENT') {
                        queueHtml = '<span class="text-emerald-700 font-medium">Cola: enviado</span>';
                    } else if (r.status === 'FAILED') {
                        queueHtml = '<span class="text-red-600 font-medium">Cola: fallido</span>';
                    } else {
                        queueHtml = '<span class="text-amber-700 font-medium">Cola: pendiente</span>';
                    }
                    const del = r.delivery_status
                        ? `<div class="text-xs text-teal-700 mt-1">Webhook: ${escapeHtml(r.delivery_status)}</div>`
                        : '';
                    const err = r.error_message ? `<div class="text-xs text-red-600 mt-1 max-w-xs">${escapeHtml(String(r.error_message).slice(0, 200))}</div>` : '';
                    const dt = r.sent_at || r.created_at;
                    const when = dt ? formatOutgoingQueuesTime(dt) : '—';
                    return `<tr class="border-t border-gray-100">
                        <td class="py-3 px-2 align-top text-sm"><div>${when}</div><div class="text-xs text-gray-500">${escapeHtml(r.status || '')}</div></td>
                        <td class="py-3 px-2 align-top text-sm">${condo}${scope}</td>
                        <td class="py-3 px-2 align-top text-sm"><div>${escapeHtml(owner)}</div><div class="text-xs text-gray-500">${escapeHtml(r.owner_email || '')}</div></td>
                        <td class="py-3 px-2 align-top font-mono text-xs">${chatDisp}</td>
                        <td class="py-3 px-2 align-top text-sm max-w-[220px]">${typeBadge}${msg}${msgMore}</td>
                        <td class="py-3 px-2 align-top text-sm">${queueHtml}${del}${err}</td>
                    </tr>`;
                }).join('');
            } catch (e) {
                console.error('loadWhatsAppDeliveries', e);
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-red-600">Error de red</td></tr>';
            }
        }

        async function loadWhatsAppWebhookEvents() {
            const tbody = document.getElementById('wa-webhook-tbody');
            if (!tbody) return;
            const days = document.getElementById('wa-table-days')?.value || 30;
            const tid = (document.getElementById('wa-filter-tenant')?.value || '').trim();
            const ev = (document.getElementById('wa-webhook-event-filter')?.value || '').trim();
            let url = `/api/admin/whatsapp-webhook-events?page=${waWebhookPage}&limit=20&days=${encodeURIComponent(days)}`;
            if (tid) url += `&tenantId=${encodeURIComponent(tid)}`;
            if (ev) url += `&eventType=${encodeURIComponent(ev)}`;
            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success || !json.data) {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center py-8 text-red-600">${escapeHtml(json.error || 'Error')}</td></tr>`;
                    return;
                }
                const { rows, pagination } = json.data;
                waWebhookTotalPages = Math.max(1, pagination.pages || 1);
                if (waWebhookPage > waWebhookTotalPages) {
                    waWebhookPage = waWebhookTotalPages;
                    return loadWhatsAppWebhookEvents();
                }
                const pi = document.getElementById('wa-webhook-page-info');
                if (pi) pi.textContent = `Página ${pagination.page} de ${pagination.pages} · ${pagination.total} eventos`;
                if (!rows || rows.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-500">Sin eventos webhook en este periodo.</td></tr>';
                    return;
                }
                tbody.innerHTML = rows.map((r) => {
                    const when = r.created_at ? formatOutgoingQueuesTime(r.created_at) : '—';
                    return `<tr class="border-t border-gray-100">
                        <td class="py-2 px-2 text-sm">${when}</td>
                        <td class="py-2 px-2 text-sm font-mono text-xs">${escapeHtml(r.event_type || '')}</td>
                        <td class="py-2 px-2 text-sm font-mono text-xs">${escapeHtml(r.session_id || '—')}</td>
                        <td class="py-2 px-2 text-sm">${escapeHtml(r.tenant_name || '—')}</td>
                        <td class="py-2 px-2 text-xs font-mono max-w-[180px] truncate" title="${escapeHtml(r.openwa_message_id || '')}">${escapeHtml((r.openwa_message_id || '—').slice(0, 28))}</td>
                        <td class="py-2 px-2 text-sm">${escapeHtml(r.queue_delivery_status || r.queue_status || '—')}</td>
                    </tr>`;
                }).join('');
            } catch (e) {
                console.error('loadWhatsAppWebhookEvents', e);
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-red-600">Error de red</td></tr>';
            }
        }

