        let saasOverviewTenantsCache = [];
        let saasOverviewRate = 0;
        let saasOverviewRateDate = null;
        function updateSaaSOverviewTotals(tenants) {
            saasOverviewTenantsCache = tenants || saasOverviewTenantsCache;
            const totalUnits = (tenants || saasOverviewTenantsCache).reduce((s,t) => s + (t.property_count||0), 0);
            const baseUsd = totalUnits * 0.5;
            const extraUsd = saasExtraItems.reduce((s,it) => s + (parseFloat(it.amount_usd)||0), 0);
            const totalUsd = baseUsd + extraUsd;
            document.getElementById('saas-overview-base').textContent = '$' + baseUsd.toFixed(2);
            document.getElementById('saas-overview-extra').textContent = '$' + extraUsd.toFixed(2);
            document.getElementById('saas-overview-total').textContent = '$' + totalUsd.toFixed(2);
            const vesEl = document.getElementById('saas-overview-ves');
            if (saasOverviewRate > 0) {
                const totalVes = totalUsd * saasOverviewRate;
                const rateDateStr = saasOverviewRateDate ? (() => {
                    const raw = String(saasOverviewRateDate).split('T')[0];
                    const [y, m, d2] = raw.split('-');
                    return y && m && d2 ? new Date(parseInt(y), parseInt(m) - 1, parseInt(d2)).toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
                })() : '';
                vesEl.textContent = rateDateStr ? `(Bs. ${totalVes.toLocaleString('es-VE')} — tasa del ${rateDateStr})` : `(Bs. ${totalVes.toLocaleString('es-VE')})`;
            } else {
                vesEl.textContent = '';
            }
        }
        function updateSaaSOverviewTotalsFromData() {
            const tenantId = saasOverviewSelectedTenantId;
            const toBill = tenantId ? saasOverviewTenantsList.filter(t => t.id === tenantId && t.has_invoice === 0) : [];
            updateSaaSOverviewTotals(toBill);
        }
