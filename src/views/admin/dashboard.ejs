        function formatBcvMoneyVes(amount) {
            return new Intl.NumberFormat('es-VE', {
                style: 'currency',
                currency: 'VES',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }).format(amount);
        }

        function formatBcvRateDate(dateStr) {
            if (!dateStr) return '—';
            const [y, m, day] = String(dateStr).split('T')[0].split('-');
            const months = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
            return `${day} ${months[parseInt(m, 10) - 1]}. ${y}`;
        }

        async function loadBcvSettings() {
            const emptyEl = document.getElementById('bcv-superadmin-empty');
            const cardsEl = document.getElementById('bcv-superadmin-cards');
            const metaEl = document.getElementById('bcv-card-meta');
            try {
                const res = await fetch('/api/admin/bcv-settings', { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (!data.success) return;
                const d = data.data;
                if (!d.hasRates) {
                    if (emptyEl) {
                        emptyEl.textContent = d.message || 'Sin tasas aún.';
                        emptyEl.classList.remove('hidden');
                    }
                    if (cardsEl) cardsEl.classList.add('hidden');
                    if (metaEl) metaEl.textContent = '—';
                    return;
                }
                if (emptyEl) emptyEl.classList.add('hidden');
                if (cardsEl) cardsEl.classList.remove('hidden');

                document.getElementById('bcv-card-usd-amount').textContent = formatBcvMoneyVes(d.usd);
                document.getElementById('bcv-card-eur-amount').textContent = formatBcvMoneyVes(d.eur);

                const ch = (pct, id) => {
                    const el = document.getElementById(id);
                    if (!el) return;
                    const v = Number(pct) || 0;
                    const arrow = v >= 0 ? '↑' : '↓';
                    const cls = v >= 0 ? 'text-emerald-600' : 'text-red-600';
                    el.className = 'text-sm mt-1 tabular-nums ' + cls;
                    el.textContent = `${arrow} ${Math.abs(v).toFixed(2)}% vs día anterior`;
                };
                ch(d.changeUsd, 'bcv-card-usd-change');
                ch(d.changeEur, 'bcv-card-eur-change');

                const dateStr = formatBcvRateDate(d.date);
                const upd = d.updatedAt
                    ? new Date(d.updatedAt).toLocaleString('es-VE', { timeZone: 'America/Caracas' })
                    : '—';
                const lastCheck = d.apiMeta?.lastApiCheckAtUtc
                    ? new Date(d.apiMeta.lastApiCheckAtUtc).toLocaleString('es-VE', { timeZone: 'America/Caracas' })
                    : '—';
                const lastOk = d.apiMeta?.lastApiOkAtUtc
                    ? new Date(d.apiMeta.lastApiOkAtUtc).toLocaleString('es-VE', { timeZone: 'America/Caracas' })
                    : '—';
                const apiStatus = d.apiMeta?.lastApiStatus || '—';
                const apiErr = d.apiMeta?.lastApiError ? ` (${d.apiMeta.lastApiError})` : '';
                const src = d.sourceLabel || 've.dolarapi.com';
                if (metaEl) {
                    metaEl.textContent =
                        `Fecha de la tasa: ${dateStr}. ` +
                        `Última verificación API: ${lastCheck} (${apiStatus}${apiErr}). ` +
                        `Última tasa obtenida de API: ${lastOk}. ` +
                        `Última actualización en BD: ${upd}. Fuente: ${src}.`;
                }
            } catch (e) {
                console.error('loadBcvSettings', e);
            }
        }

