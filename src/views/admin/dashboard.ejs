        async function searchOwner() {
            const dni = document.getElementById('owner-search-dni')?.value?.trim() || '';
            const email = document.getElementById('owner-search-email')?.value?.trim() || '';
            if (!dni && !email) {
                showSnackbar('Ingrese DNI o correo para buscar', 'error');
                return;
            }
            const resultEl = document.getElementById('owner-search-result');
            const contentEl = document.getElementById('owner-search-result-content');
            resultEl.classList.remove('hidden');
            contentEl.innerHTML = '<p class="text-gray-500">Buscando...</p>';
            try {
                const params = new URLSearchParams();
                if (dni) params.set('dni', dni);
                if (email) params.set('email', email);
                const res = await fetch('/api/admin/owners/search?' + params.toString(), {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const json = await res.json();
                if (!res.ok) throw new Error(json.error || 'Error');
                const { user, tenants } = json.data || {};
                if (!user) {
                    contentEl.innerHTML = '<p class="text-gray-600">No se encontró ningún propietario con ese DNI o correo.</p>';
                    return;
                }
                contentEl.innerHTML = `
                    <div class="space-y-2">
                        <div class="font-medium text-gray-900">${user.first_name} ${user.last_name}</div>
                        <div class="text-sm text-gray-600">DNI: ${user.dni || '-'} | Email: ${user.email || '-'} | Tel: ${user.phone || '-'}</div>
                        <div class="mt-3">
                            <span class="text-sm font-medium text-gray-700">Condominios:</span>
                            ${tenants && tenants.length > 0 
                                ? '<ul class="mt-1 list-disc list-inside text-sm text-gray-600">' + tenants.map(t => 
                                    `<li><a href="/admin/tenants/${t.id}" class="text-[var(--md-sys-color-primary)] hover:underline">${t.name}</a></li>`
                                  ).join('') + '</ul>'
                                : '<p class="text-sm text-gray-500 mt-1">No está asociado a ningún condominio activo.</p>'}
                        </div>
                    </div>
                `;
            } catch (e) {
                contentEl.innerHTML = '<p class="text-red-500">' + (e.message || 'Error al buscar') + '</p>';
            }
        }

