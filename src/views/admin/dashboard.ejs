        function filterTenants() {
            const search = document.getElementById('tenant-search').value.toLowerCase();
            
            let filtered = tenantsData.filter(t => 
                t.name.toLowerCase().includes(search) || 
                t.slug.toLowerCase().includes(search)
            );

            if (currentFilter === 'active') filtered = filtered.filter(t => t.active);
            if (currentFilter === 'inactive') filtered = filtered.filter(t => !t.active);

            renderTenants(filtered);
        }

        // Wizard Functions
        function openNewTenantModal() {
            document.getElementById('modal-overlay').classList.add('active');
            document.getElementById('new-tenant-modal').classList.add('active');
            resetWizard();
        }

        function closeNewTenantModal() {
            document.getElementById('modal-overlay').classList.remove('active');
            document.getElementById('new-tenant-modal').classList.remove('active');
        }

        function resetWizard() {
            currentStep = 1;
            document.getElementById('new-tenant-form').reset();
            updateWizardUI();
            validateAllFields(); // Reset button state
        }

        // Validación en tiempo real de todos los campos del wizard
        function validateAllFields() {
            // Campos requeridos del paso 1
            const tenantName = document.getElementById('tenant-name')?.value.trim();
            const tenantSlug = document.getElementById('tenant-slug')?.value.trim();
            
            // Campos requeridos del paso 4 (admin)
            const adminDisplayName = document.getElementById('admin-display-name')?.value.trim();
            const adminEmail = document.getElementById('admin-email')?.value.trim();
            const adminPassword = document.getElementById('admin-password')?.value.trim();
            
            // Paso 3: si MULTIPLE, al menos un edificio con nombre
            const buildingType = document.getElementById('building-type')?.value;
            let buildingsValid = true;
            if (buildingType === 'MULTIPLE') {
                buildingsValid = buildings.some(b => (b.name || '').trim());
            }
            
            // Verificar que todos estén completos
            const isValid = tenantName && tenantSlug && adminDisplayName && adminEmail && adminPassword && buildingsValid;
            
            // Actualizar estado del botón submit (también respetar idempotencia)
            const submitBtn = document.getElementById('btn-submit');
            if (submitBtn) {
                submitBtn.disabled = !isValid || !!window.submitTenantInProgress;
            }
            
            return isValid;
        }

        // Agregar event listeners para validación en tiempo real
        function setupValidationListeners() {
            const fields = ['tenant-name', 'tenant-slug', 'admin-display-name', 'admin-email', 'admin-password'];
            fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('input', validateAllFields);
                    field.addEventListener('change', validateAllFields);
                }
            });
        }

        // Billing Type Functions
        function updateBillingType(value) {
            const info = document.getElementById('alicuota-info');
            if (value === 'ALICUOTA') {
                info.classList.remove('hidden');
            } else {
                info.classList.add('hidden');
            }
        }

        // Building Type Functions
        let buildings = [];
        
        function setBuildingType(type) {
            document.getElementById('building-type').value = type;
            document.getElementById('segment-single').classList.toggle('active', type === 'SINGLE');
            document.getElementById('segment-multiple').classList.toggle('active', type === 'MULTIPLE');
            
            if (type === 'SINGLE') {
                document.getElementById('single-building-info').classList.remove('hidden');
                document.getElementById('multiple-buildings-container').classList.add('hidden');
            } else {
                document.getElementById('single-building-info').classList.add('hidden');
                document.getElementById('multiple-buildings-container').classList.remove('hidden');
                if (buildings.length === 0) {
                    addBuilding();
                }
            }
            validateAllFields();
        }
        
        function addBuilding() {
            const id = Date.now();
            buildings.push({ id, name: '', code: '' });
            renderBuildings();
            validateAllFields();
        }
        
        function removeBuilding(id) {
            buildings = buildings.filter(b => b.id !== id);
            renderBuildings();
            validateAllFields();
        }
        
        function updateBuilding(id, field, value) {
            const building = buildings.find(b => b.id === id);
            if (building) {
                building[field] = value;
            }
            validateAllFields();
        }
        
        function renderBuildings() {
            const container = document.getElementById('buildings-list');
            container.innerHTML = buildings.map(b => `
                <div class="flex gap-2 items-start">
                    <div class="flex-1 grid grid-cols-2 gap-2">
                        <input type="text" placeholder="Nombre del edificio/calle *" 
                            class="px-3 py-2 border border-gray-200 rounded-lg text-sm"
                            value="${b.name}" 
                            onchange="updateBuilding(${b.id}, 'name', this.value)">
                        <input type="text" placeholder="Código (ej: A, Torre-1)" 
                            class="px-3 py-2 border border-gray-200 rounded-lg text-sm"
                            value="${b.code}" 
                            onchange="updateBuilding(${b.id}, 'code', this.value)">
                    </div>
                    <button type="button" onclick="removeBuilding(${b.id})" 
                        class="p-2 text-red-500 hover:bg-red-50 rounded-lg">
                        <span class="material-symbols-rounded text-sm">delete</span>
                    </button>
                </div>
            `).join('');
        }

        function updateWizardUI() {
            // Hide all steps
            for (let i = 1; i <= 5; i++) {
                document.getElementById(`step-${i}`).classList.add('hidden');
            }
            
            // Show current
            document.getElementById(`step-${currentStep}`).classList.remove('hidden');

            // Update progress
            const progress = (currentStep / 5) * 100;
            document.getElementById('progress-bar').style.width = progress + '%';

            // Update step indicators
            for (let i = 1; i <= 5; i++) {
                const indicator = document.getElementById(`step-indicator-${i}`).querySelector('div');
                const label = document.getElementById(`step-indicator-${i}`).querySelector('span');
                
                if (i <= currentStep) {
                    indicator.className = 'w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-sm font-medium';
                    if (label) {
                        label.classList.remove('text-gray-500');
                        label.classList.add('text-gray-900');
                    }
                } else {
                    indicator.className = 'w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium';
                    if (label) {
                        label.classList.remove('text-gray-900');
                        label.classList.add('text-gray-500');
                    }
                }
            }

            // Scroll dinámico: centrar el paso actual para que no quede recortado
            const activeIndicator = document.getElementById(`step-indicator-${currentStep}`);
            const container = document.getElementById('wizard-steps-container');
            if (activeIndicator && container) {
                requestAnimationFrame(() => {
                    const rect = activeIndicator.getBoundingClientRect();
                    const containerRect = container.getBoundingClientRect();
                    const scrollTarget = container.scrollLeft + (rect.left - containerRect.left) - (containerRect.width / 2) + (rect.width / 2);
                    container.scrollTo({ left: Math.max(0, scrollTarget), behavior: 'smooth' });
                });
            }

            // Update buttons
            document.getElementById('btn-prev').classList.toggle('hidden', currentStep === 1);
            document.getElementById('btn-next').classList.toggle('hidden', currentStep === 5);
            document.getElementById('btn-submit').classList.toggle('hidden', currentStep !== 5);

            if (currentStep === 5) {
                updateReviewData();
                validateAllFields(); // Check if submit button should be enabled
            }
        }

        function updateReviewData() {
            // Tenant info
            document.getElementById('review-name').textContent = document.getElementById('tenant-name').value;
            document.getElementById('review-slug').textContent = document.getElementById('tenant-slug').value;
            document.getElementById('review-address').textContent = document.getElementById('tenant-address').value || 'No especificada';
            
            // Billing type
            const billingType = document.querySelector('input[name="billing_type"]:checked')?.value;
            document.getElementById('review-billing-type').textContent = billingType === 'ALICUOTA' ? 'Por Alícuota' : 'Cuota Fija';
            
            // Building type
            const buildingType = document.getElementById('building-type').value;
            document.getElementById('review-building-type').textContent = buildingType === 'MULTIPLE' ? 'Múltiples Edificios/Calles' : 'Único Edificio/Calle';
            
            // Buildings list
            const buildingsList = document.getElementById('review-buildings-list');
            if (buildingType === 'MULTIPLE' && buildings.length > 0) {
                buildingsList.innerHTML = '<ul class="list-disc list-inside mt-2">' + 
                    buildings.filter(b => b.name).map(b => `<li class="text-gray-700">${b.name} ${b.code ? '(' + b.code + ')' : ''}</li>`).join('') + 
                    '</ul>';
            } else {
                buildingsList.innerHTML = '<p class="text-gray-500 mt-2">Edificio/Calle principal</p>';
            }
            
            // Admin info
            document.getElementById('review-admin-name').textContent = document.getElementById('admin-display-name').value;
            document.getElementById('review-admin-email').textContent = document.getElementById('admin-email').value;
        }

        function nextStep() {
            if (validateStep(currentStep)) {
                if (currentStep < 5) {
                    currentStep++;
                    updateWizardUI();
                    // Si llegamos al paso 5, validar campos para habilitar/deshabilitar botón
                    if (currentStep === 5) {
                        validateAllFields();
                    }
                }
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                updateWizardUI();
            }
        }

        function validateStep(step) {
            // Validación paso 1: Info del condominio
            if (step === 1) {
                const ids = ['tenant-name', 'tenant-slug'];
                for (const id of ids) {
                    const el = document.getElementById(id);
                    if (!el.value.trim()) {
                        el.focus();
                        el.parentElement.classList.add('animate-pulse');
                        setTimeout(() => el.parentElement.classList.remove('animate-pulse'), 500);
                        showSnackbar('Completa todos los campos requeridos');
                        return false;
                    }
                }
                return true;
            }
            
            // Validación paso 2: Billing type (siempre válido, tiene default)
            if (step === 2) return true;
            
            // Validación paso 3: Buildings
            if (step === 3) {
                const buildingType = document.getElementById('building-type').value;
                if (buildingType === 'MULTIPLE') {
                    // Validar que haya al menos un edificio con nombre
                    const validBuildings = buildings.filter(b => b.name.trim());
                    if (validBuildings.length === 0) {
                        showSnackbar('Agrega al menos un edificio/calle con nombre');
                        return false;
                    }
                }
                return true;
            }
            
            // Validación paso 4: Admin info
            if (step === 4) {
                const ids = ['admin-display-name', 'admin-email', 'admin-password'];
                for (const id of ids) {
                    const el = document.getElementById(id);
                    if (!el.value.trim()) {
                        el.focus();
                        el.parentElement.classList.add('animate-pulse');
                        setTimeout(() => el.parentElement.classList.remove('animate-pulse'), 500);
                        showSnackbar('Completa todos los campos requeridos');
                        return false;
                    }
                }
                return true;
            }
            
            // Paso 5: Review (siempre válido)
            return true;
        }

        async function submitTenant() {
            if (window.submitTenantInProgress) return;
            window.submitTenantInProgress = true;

            const submitBtn = document.getElementById('btn-submit');
            const originalHtml = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="animate-spin rounded-full h-5 w-5 border-2 border-white border-t-transparent inline-block mr-2"></span> Creando...';
            }

            const buildingType = document.getElementById('building-type').value;
            const billingType = document.querySelector('input[name="billing_type"]:checked')?.value || 'FIXED';
            
            // Preparar edificios
            let buildingData = [];
            if (buildingType === 'MULTIPLE') {
                buildingData = buildings
                    .filter(b => b.name.trim())
                    .map(b => ({
                        name: b.name.trim(),
                        code: b.code.trim() || b.name.trim().substring(0, 20)
                    }));
            }
            
            const data = {
                name: document.getElementById('tenant-name').value,
                slug: document.getElementById('tenant-slug').value,
                address: document.getElementById('tenant-address').value,
                billing_type: billingType,
                building_type: buildingType,
                buildings: buildingData,
                admin: {
                    display_name: document.getElementById('admin-display-name').value,
                    email: document.getElementById('admin-email').value,
                    password: document.getElementById('admin-password').value,
                    phone: document.getElementById('admin-phone').value
                }
            };

            try {
                const res = await fetch('/api/admin/onboarding', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(data)
                });

                if (!res.ok) {
                    const err = await res.json();
                    throw new Error(err.error || 'Error creando condominio');
                }

                closeNewTenantModal();
                showSnackbar('Condominio creado exitosamente', 'success');
                loadTenants();
                loadStats();
            } catch (error) {
                showSnackbar(error.message, 'error');
            } finally {
                window.submitTenantInProgress = false;
                if (submitBtn) {
                    submitBtn.disabled = !validateAllFields();
                    submitBtn.innerHTML = originalHtml || '<span class="material-symbols-rounded">check</span> Crear Condominio';
                }
            }
        }

        // Helpers
        function getActivityColor(action) {
            const colors = {
                'TENANT_CREATED': 'bg-emerald-100 text-emerald-600',
                'USER_LOGIN': 'bg-blue-100 text-blue-600',
                'TENANT_SUSPENDED': 'bg-red-100 text-red-600'
            };
            return colors[action] || 'bg-gray-100 text-gray-600';
        }

        function getActivityIcon(action) {
            const icons = {
                'TENANT_CREATED': 'add_circle',
                'USER_LOGIN': 'login',
                'TENANT_SUSPENDED': 'block'
            };
            return icons[action] || 'info';
        }

        function getActionBadgeClass(action) {
            const classes = {
                'CREATE': 'bg-emerald-100 text-emerald-700',
                'UPDATE': 'bg-blue-100 text-blue-700',
                'DELETE': 'bg-red-100 text-red-700'
            };
            return classes[action] || 'bg-gray-100 text-gray-700';
        }

        function timeAgo(date) {
            const seconds = Math.floor((new Date() - new Date(date)) / 1000);
            if (seconds < 60) return 'ahora';
            const minutes = Math.floor(seconds / 60);
            if (minutes < 60) return `hace ${minutes}m`;
            const hours = Math.floor(minutes / 60);
            if (hours < 24) return `hace ${hours}h`;
            return `hace ${Math.floor(hours / 24)}d`;
        }

        function animateNumber(id, target) {
            const el = document.getElementById(id);
            const duration = 1000;
            const start = 0;
            const increment = target / (duration / 16);
            let current = start;
            
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    el.textContent = target.toLocaleString();
                    clearInterval(timer);
                } else {
                    el.textContent = Math.floor(current).toLocaleString();
                }
            }, 16);
        }

        function viewTenant(id) {
            window.location.href = `/admin/tenants/${id}`;
        }

        function showSnackbar(message, type) {
            const variant = type === 'error' ? 'error' : type === 'success' ? 'success' : 'info';
            if (typeof window.showPageToast === 'function') {
                window.showPageToast(message, variant);
            } else {
                console.warn('[toast]', message);
            }
        }

        function escapeHtml(s) {
            if (s == null) return '';
            return String(s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        /**
         * DATETIME2 desde SQL: la BD guarda hora Venezuela pero el driver la expone como UTC.
         * Se añade -04:00 al ISO para formatear en Caracas sin aplicar dos veces el offset (misma lógica que EmailService.formatDateVenezuela).
         */
        function formatEmailSqlDatetimeVenezuela(val) {
            if (!val) return '—';
            const d = val instanceof Date ? val : new Date(val);
            if (isNaN(d.getTime())) return '—';
            const iso = d.toISOString();
            const isoVenezuela = iso.slice(0, 19) + '-04:00';
            return new Date(isoVenezuela).toLocaleString('es-VE', { timeZone: 'America/Caracas' });
        }

        async function loadEmailTenantOptions() {
            if (!user.isSuperAdmin) return;
            const wrap = document.getElementById('email-tenant-filter-wrap');
            const sel = document.getElementById('email-filter-tenant');
            if (!wrap || !sel) return;
            wrap.classList.remove('hidden');
            try {
                const res = await fetch('/api/admin/tenants', { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success || !json.data) return;
                const cur = sel.value;
                sel.innerHTML = '<option value="">Todos</option>' +
                    json.data.map((t) => `<option value="${t.id}">${escapeHtml(t.name || t.slug || t.id)}</option>`).join('');
                if (cur) sel.value = cur;
            } catch (e) {
                console.error('loadEmailTenantOptions', e);
            }
        }

        async function loadEmailMetrics() {
            const days = document.getElementById('email-filter-days')?.value || 30;
            let url = `/api/admin/email-metrics?days=${days}`;
            if (user.isSuperAdmin) {
                const tid = document.getElementById('email-filter-tenant')?.value;
                if (tid) url += `&tenantId=${encodeURIComponent(tid)}`;
            }
            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success) return;
                const d = json.data;
                const r = d.recipientsByStatus || {};
                const sent = (r.sent || 0);
                const pend = (r.pending || 0) + (r.processing || 0) + (r.retry || 0);
                const fail = (r.failed || 0) + (r.bounced || 0) + (r.complained || 0);
                document.getElementById('email-metric-sent').textContent = sent;
                document.getElementById('email-metric-pending').textContent = pend;
                document.getElementById('email-metric-failed').textContent = fail;
                document.getElementById('email-metric-webhook').textContent = d.webhookEvents ?? 0;
            } catch (e) {
                console.error('loadEmailMetrics', e);
            }
        }

        async function loadEmailJobs() {
            const days = document.getElementById('email-table-days')?.value || 90;
            const pipe = document.getElementById('email-filter-pipeline')?.value || '';
            const st = document.getElementById('email-filter-status')?.value || '';
            let url = `/api/admin/email-jobs?page=${emailJobsPage}&limit=15&days=${days}`;
            if (pipe) url += `&pipeline=${encodeURIComponent(pipe)}`;
            if (st) url += `&status=${encodeURIComponent(st)}`;
            if (user.isSuperAdmin) {
                const tid = document.getElementById('email-filter-tenant')?.value;
                if (tid) url += `&tenantId=${encodeURIComponent(tid)}`;
            }
            const tbody = document.getElementById('email-jobs-tbody');
            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-8 text-red-500">Error al cargar</td></tr>';
                    return;
                }
                const rows = json.data || [];
                const p = json.pagination || {};
                document.getElementById('email-jobs-page-info').textContent =
                    `Página ${p.page || 1} de ${p.pages || 1} (${p.total || 0} jobs)`;
                if (!rows.length) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-8 text-gray-500">Sin registros</td></tr>';
                    return;
                }
                tbody.innerHTML = rows.map((j) => {
                    const dt = formatEmailSqlDatetimeVenezuela(j.created_at);
                    const tenant = j.tenant_name || (j.tenant_id ? '(sin nombre)' : '—');
                    return `<tr class="hover:bg-gray-50 cursor-pointer" onclick="openEmailJobModal('${j.id}')">
                        <td class="whitespace-nowrap">${dt}</td>
                        <td>${escapeHtml(String(tenant))}</td>
                        <td>${escapeHtml(j.message_type || '')}</td>
                        <td>${escapeHtml(j.pipeline || '')}</td>
                        <td><span class="px-2 py-0.5 rounded text-xs bg-gray-100">${escapeHtml(j.status || '')}</span></td>
                        <td>${j.sent_count ?? 0} / ${j.failed_count ?? 0}</td>
                        <td><span class="material-symbols-rounded text-gray-400 text-lg">chevron_right</span></td>
                    </tr>`;
                }).join('');
            } catch (e) {
                console.error('loadEmailJobs', e);
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-8 text-red-500">Error</td></tr>';
            }
        }

        async function loadEmailPanel() {
            if (user.isSuperAdmin) await loadOutgoingQueuesSummary();
            if (user.isSuperAdmin) await loadEmailTenantOptions();
            await loadEmailMetrics();
            await loadEmailJobs();
        }

        function emailJobsPagePrev() {
            if (emailJobsPage > 1) {
                emailJobsPage--;
                loadEmailJobs();
            }
        }

        function emailJobsPageNext() {
            emailJobsPage++;
            loadEmailJobs();
        }

        async function openEmailJobModal(jobId) {
            document.getElementById('email-job-modal').classList.remove('hidden');
            const body = document.getElementById('email-job-modal-body');
            body.innerHTML = '<p class="text-gray-500">Cargando…</p>';
            let url = `/api/admin/email-jobs/${jobId}`;
            if (user.isSuperAdmin) {
                const tid = document.getElementById('email-filter-tenant')?.value;
                if (tid) url += `?tenantId=${encodeURIComponent(tid)}`;
            }
            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success) {
                    body.innerHTML = `<p class="text-red-600">${escapeHtml(json.error || 'Error')}</p>`;
                    return;
                }
                const { job, recipients } = json.data;
                document.getElementById('email-job-modal-title').textContent =
                    `Job · ${job.message_type || ''} · ${job.pipeline || ''}`;
                let html = '<div class="space-y-2 mb-4 text-gray-700"><p><strong>Estado:</strong> ' + escapeHtml(job.status) +
                    ' · <strong>Job ID:</strong> <code class="text-xs">' + job.id + '</code></p>';
                if (job.tenant_name) html += '<p><strong>Condominio:</strong> ' + escapeHtml(job.tenant_name) + '</p>';
                html += '</div>';
                html += '<table class="w-full text-xs border-collapse"><thead><tr class="border-b text-left text-gray-500">' +
                    '<th class="py-2 pr-2">Destinatario</th><th class="py-2 pr-2">Estado</th><th class="py-2 pr-2">Intentos</th><th class="py-2">Acciones</th></tr></thead><tbody>';
                for (const r of recipients) {
                    const err = r.error_message
                        ? '<div class="text-red-600 mt-1 max-w-xs truncate" title="' + escapeHtml(r.error_message) + '">' +
                          escapeHtml(r.error_message) + '</div>'
                        : '';
                    const canRetry = (r.status === 'failed' || r.status === 'retry');
                    const btn = canRetry
                        ? '<button type="button" class="text-[var(--md-sys-color-primary)] font-medium" onclick="retryEmailRecipient(\'' +
                          r.id + '\', event)">Reintentar</button>'
                        : '';
                    html += '<tr class="border-b border-gray-100 align-top"><td class="py-2 pr-2">' + escapeHtml(r.recipient_email) + err + '</td>' +
                        '<td class="py-2 pr-2">' + escapeHtml(r.status) + '</td><td class="py-2 pr-2">' + (r.attempt_count ?? 0) + '</td>' +
                        '<td class="py-2"><button type="button" class="text-gray-600 underline mr-2" onclick="showEmailLogs(\'' +
                        r.id + '\', event)">Logs</button>' + btn + '</td></tr>';
                }
                html += '</tbody></table>';
                body.innerHTML = html;
            } catch (e) {
                console.error('openEmailJobModal', e);
                body.innerHTML = '<p class="text-red-600">Error al cargar detalle</p>';
            }
        }

        function closeEmailJobModal() {
            document.getElementById('email-job-modal').classList.add('hidden');
        }

        function closeEmailLogsModal() {
            document.getElementById('email-logs-modal').classList.add('hidden');
        }

        async function showEmailLogs(recipientId, ev) {
            if (ev) ev.stopPropagation();
            let url = `/api/admin/email-recipients/${recipientId}/logs`;
            if (user.isSuperAdmin) {
                const tid = document.getElementById('email-filter-tenant')?.value;
                if (tid) url += `?tenantId=${encodeURIComponent(tid)}`;
            }
            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success) {
                    showSnackbar('No se pudieron cargar los logs', 'error');
                    return;
                }
                const logs = json.data || [];
                const body = document.getElementById('email-logs-modal-body');
                body.textContent = logs.length
                    ? logs.map((l) => {
                        const t = formatEmailSqlDatetimeVenezuela(l.created_at);
                        return `${t} · ${l.event_type || ''}`;
                    }).join('\n')
                    : 'Sin entradas en el período de retención configurado.';
                document.getElementById('email-logs-modal').classList.remove('hidden');
            } catch (e) {
                showSnackbar('Error al cargar logs', 'error');
            }
        }

        async function retryEmailRecipient(recipientId, ev) {
            if (ev) ev.stopPropagation();
            let url = `/api/admin/email-recipients/${recipientId}/retry`;
            if (user.isSuperAdmin) {
                const tid = document.getElementById('email-filter-tenant')?.value;
                if (tid) url += `?tenantId=${encodeURIComponent(tid)}`;
            }
            try {
                const res = await fetch(url, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` } });
                const json = await res.json();
                if (!json.success) {
                    showSnackbar(json.error || 'No se pudo reintentar', 'error');
                    return;
                }
                showSnackbar(json.data && json.data.mode === 'queued' ? 'Encolado para envío' : 'Correo enviado', 'success');
                loadEmailMetrics();
                loadEmailJobs();
            } catch (e) {
                showSnackbar('Error de red', 'error');
            }
        }

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = '/';
        }
    </script>
</body>
</html>
