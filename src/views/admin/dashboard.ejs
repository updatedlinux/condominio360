                            </div>
                            <div class="flex-1">
                                <label class="block text-xs text-gray-500 mb-1">Correo electrónico</label>
                                <input type="text" id="owner-search-email" placeholder="Ej: propietario@email.com" 
                                    class="w-full border border-gray-200 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-[var(--md-sys-color-primary)]">
                            </div>
                            <div class="flex items-end">
                                <button type="button" onclick="searchOwner()" class="px-4 py-2 bg-[var(--md-sys-color-primary)] text-white rounded-lg hover:opacity-90 text-sm flex items-center gap-2">
                                    <span class="material-symbols-rounded text-lg">search</span>
                                    Buscar
                                </button>
                            </div>
                        </div>
                        <div id="owner-search-result" class="mt-4 hidden">
                            <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
                                <div id="owner-search-result-content"></div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Actualización de Datos Section -->
                <section id="section-data-updates" class="hidden space-y-6">
                    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex gap-3">
                        <span class="material-symbols-rounded text-amber-600 text-2xl flex-shrink-0">info</span>
                        <div>
                            <h3 class="font-medium text-amber-900">Importante</h3>
                            <p class="text-sm text-amber-800 mt-1">Los cambios que apruebes afectarán la información del usuario en <strong>todos los inmuebles y condominios</strong> asociados a él.</p>
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-2xl font-medium text-gray-900">Solicitudes de Actualización de Datos</h3>
