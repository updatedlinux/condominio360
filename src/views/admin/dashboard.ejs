            document.getElementById('saas-overview-rate-info').textContent = 'Cargando tasa BCV...';
            document.getElementById('saas-overview-ves').textContent = '';
            const month = parseInt(document.getElementById('saas-period-month').value);
            const year = parseInt(document.getElementById('saas-period-year').value);
            try {
                const [tenantsRes, rateRes] = await Promise.all([
                    fetch(`/api/admin/saas-billing/tenants-available?period_month=${month}&period_year=${year}`, { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch('/api/admin/saas-billing/rate', { headers: { 'Authorization': `Bearer ${token}` } })
                ]);
                const { data: tenants } = await tenantsRes.json();
                const rateData = (await rateRes.json()).data || {};
                saasOverviewRate = parseFloat(rateData.usd_to_ves) || 0;
                saasOverviewRateDate = rateData.rate_date;
                saasOverviewTenantsList = tenants || [];
                const rateDateStr = rateData.rate_date ? (() => {
                    const d = rateData.rate_date;
                    const [y, m, d2] = (d.split?.('T')[0] || d).split('-');
