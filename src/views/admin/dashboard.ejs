                            <select id="dur-status-filter" onchange="loadDataUpdateRequests()" class="border border-gray-200 rounded-lg px-3 py-2 text-sm">
                                <option value="">Todas</option>
                                <option value="PENDING">Pendientes</option>
                                <option value="APPROVED">Aprobadas</option>
                                <option value="REJECTED">Rechazadas</option>
                            </select>
                        </div>
                    </div>
                    <div class="md-card overflow-hidden">
                        <div class="md-table-container">
                            <table class="md-table">
                                <thead>
                                    <tr>
                                        <th>Propietario</th>
                                        <th>Email</th>
                                        <th>Estado</th>
                                        <th>Fecha</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="data-update-requests-tbody">
                                    <tr><td colspan="5" class="text-center py-8 text-gray-500">Cargando...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div id="dur-pagination" class="px-6 py-4 border-t border-gray-100 flex items-center justify-between"></div>
                    </div>
                </section>

                <!-- Audit Section -->
                <section id="section-audit" class="hidden space-y-6">
                    <div>
                        <h3 class="text-2xl font-medium text-gray-900">Auditoría Global</h3>
                        <p class="text-gray-500 mt-1">Registro de actividad del sistema</p>
                    </div>
                    <div class="md-card p-6">
                        <div id="audit-logs-container" class="space-y-2 max-h-[600px] overflow-y-auto">
                            <div class="text-center text-gray-500 py-8">Cargando logs...</div>
                        </div>
                    </div>
                </section>

                <!-- Facturación SaaS (Condominio360 → Condominios) -->
                <section id="section-saas-billing" class="hidden space-y-6">
                    <!-- Método de pago para cobros Condominio360 -->
                    <div class="md-card p-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-2">Método de pago para Cobros Condominio360</h3>
                        <p class="text-sm text-gray-500 mb-4">Configura los datos que verán las juntas para realizar transferencias o pagos móviles al cobrar Condominio360.</p>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4" id="saas-payment-config-form">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Cuenta bancaria / transferencia</label>
                                <input type="text" id="saas-payment-bank" placeholder="Ej: Banco de Venezuela, C.I. 12345678, cuenta 0102-0123-45678901234" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Pago móvil</label>
                                <input type="text" id="saas-payment-mobile" placeholder="Ej: 0414-1234567, C.I. 12345678" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm">
                            </div>
                        </div>
                        <button type="button" onclick="saveSaaSPaymentConfig()" class="px-4 py-2 bg-[var(--md-sys-color-primary)] text-white rounded-lg hover:opacity-90 text-sm">Guardar método de pago</button>
                    </div>
                    <div class="md-card p-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Facturación Condominio360</h3>
                        <p class="text-sm text-gray-500 mb-4">Genera facturas mensuales a los condominios ($0.50 USD por unidad + ítems extraordinarios). Tasa BCV: días 1-5 del mes usa tasa del 1ro; día 6+ usa tasa diaria.</p>
                        <div class="flex flex-wrap gap-4 mb-6">
                            <div>
                                <label class="block text-xs text-gray-500 mb-1">Período</label>
                                <div class="flex gap-2">
                                    <select id="saas-period-month" class="border border-gray-200 rounded-lg px-3 py-2 text-sm">
                                        <% for(let m=1; m<=12; m++) { %>
                                        <option value="<%= m %>" <%= (new Date().getMonth()+1) === m ? 'selected' : '' %>><%= ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][m-1] %></option>
                                        <% } %>
                                    </select>
                                    <select id="saas-period-year" class="border border-gray-200 rounded-lg px-3 py-2 text-sm">
                                        <% const y = new Date().getFullYear(); for(let i=-1; i<=1; i++) { %>
                                        <option value="<%= y+i %>" <%= i===0 ? 'selected' : '' %>><%= y+i %></option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 mb-1">Método de pago</label>
                                <input type="text" id="saas-payment-method" placeholder="Ej: Transferencia, Pago Móvil" class="border border-gray-200 rounded-lg px-3 py-2 text-sm">
                            </div>
                        </div>
                        <div class="flex gap-3">
                            <button type="button" onclick="openSaaSOverviewModal()" class="px-4 py-2 bg-[var(--md-sys-color-primary)] text-white rounded-lg hover:opacity-90 flex items-center gap-2">
                                <span class="material-symbols-rounded text-lg">add_circle</span>
                                Preparar facturas
                            </button>
                        </div>
                    </div>
                    <div class="md-card p-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Facturas generadas</h3>
                        <div id="saas-invoices-list" class="space-y-2">
                            <p class="text-gray-500 text-sm">Cargando...</p>
                        </div>
                    </div>
                </section>

                <!-- Balance Financiero -->
                <section id="section-balance-financiero" class="hidden space-y-6">
                    <div class="md-card p-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Tasas BCV Diarias</h3>
                        <p class="text-sm text-gray-500 mb-4">Historial de tasas de cambio registradas (USD y EUR)</p>
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-sm font-medium text-gray-600 mb-2">Dólar (USD) - VES</p>
                                <div class="h-64"><canvas id="chart-usd"></canvas></div>
                            </div>
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-sm font-medium text-gray-600 mb-2">Euro (EUR) - VES</p>
                                <div class="h-64"><canvas id="chart-eur"></canvas></div>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 mt-4" id="balance-rate-info">Cargando última tasa...</p>
                    </div>
                    <div class="md-card p-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Balance por Condominio</h3>
                        <p class="text-sm text-gray-500 mb-4">Cobros según inmuebles, facturas SaaS generadas y por generar</p>
                        <div class="overflow-x-auto">
                            <table class="md-table">
                                <thead>
                                    <tr>
                                        <th>Condominio</th>
                                        <th>Unidades</th>
                                        <th>Cobro Condo (VES)</th>
                                        <th>SaaS Pagado (VES)</th>
                                        <th>SaaS Pendiente (VES)</th>
                                    </tr>
                                </thead>
                                <tbody id="balance-tenant-table"></tbody>
                            </table>
                        </div>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
                            <div class="stat-card primary p-4 rounded-xl">
                                <p class="text-xs text-gray-500 uppercase">Total Cobrado Condo</p>
                                <p class="text-xl font-bold" id="balance-total-condo">-</p>
                            </div>
                            <div class="stat-card tertiary p-4 rounded-xl">
                                <p class="text-xs text-gray-500 uppercase">SaaS Pendiente</p>
                                <p class="text-xl font-bold" id="balance-saas-pending">-</p>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="md-card p-6">
                            <h3 class="text-lg font-medium text-gray-900 mb-4">Comparativa Meses Anteriores</h3>
                            <div class="h-64"><canvas id="chart-comparative"></canvas></div>
                            <div id="balance-comparative-list" class="mt-4 space-y-2 text-sm"></div>
                        </div>
                        <div class="md-card p-6">
                            <h3 class="text-lg font-medium text-gray-900 mb-4">Proyección Próximos Meses</h3>
                            <p class="text-xs text-gray-500 mb-2">Con última tasa BCV para contravalor en VES</p>
                            <div id="balance-projection-list" class="space-y-2"></div>
                        </div>
                    </div>
                </section>

                <!-- Settings Section (Placeholder) -->
                <section id="section-settings" class="hidden">
                    <div class="md-card p-12 text-center">
                        <span class="material-symbols-rounded text-6xl text-gray-300 mb-4">settings</span>
                        <h3 class="text-xl font-medium text-gray-900">Configuración Global</h3>
                        <p class="text-gray-500 mt-2">Configure cada condominio individualmente desde su panel de administración</p>
                        <a href="/admin/tenants" class="inline-flex items-center gap-2 mt-4 text-[var(--md-sys-color-primary)] hover:underline">
                            <span>Ver Condominios</span>
                            <span class="material-symbols-rounded">arrow_forward</span>
                        </a>
                    </div>
                </section>
            </div>
            </div>
            <%- include('../partials/panels-footer') %>
        </main>
    </div>

    <!-- Modal Overview Facturación SaaS -->
    <div id="saas-overview-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] flex flex-col">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="text-xl font-medium text-gray-900">Resumen antes de generar</h3>
                <button onclick="closeSaaSOverviewModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100">
                    <span class="material-symbols-rounded text-gray-600">close</span>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-1">
                <div class="mb-6">
                    <p class="text-sm font-medium text-gray-700 mb-1">Selecciona el condominio</p>
                    <p class="text-xs text-gray-500 mb-3">Elige a qué condominio apunta esta factura. Los ítems extraordinarios aplican solo al condominio seleccionado.</p>
                    <button type="button" id="saas-tenant-selector-trigger" onclick="openSaaSTenantPickerModal()" class="w-full flex items-center gap-3 px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl hover:bg-gray-100 hover:border-gray-300 transition text-left disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:bg-gray-50 disabled:hover:border-gray-200">
                        <span class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-rounded text-[#f97316]">apartment</span>
                        </span>
                        <span id="saas-tenant-selector-text" class="flex-1 text-gray-500">Haz clic para seleccionar condominio...</span>
                        <span class="material-symbols-rounded text-gray-400 flex-shrink-0">expand_more</span>
                    </button>
                </div>
                <div id="saas-overview-selected-summary" class="hidden">
                    <div id="saas-overview-tenants" class="space-y-2 mb-4"></div>
                    <div class="border-t border-gray-100 pt-4 mb-4">
                        <p class="text-sm font-medium text-gray-700 mb-1">Ítems extraordinarios (opcional)</p>
                        <p class="text-xs text-gray-500 mb-2">Los montos deben expresarse en USD</p>
                        <div id="saas-overview-extra-list" class="space-y-2 mb-2"></div>
                        <button type="button" onclick="addSaaSExtraItemInModal()" class="text-sm text-[var(--md-sys-color-primary)] hover:underline">+ Añadir ítem extraordinario</button>
                    </div>
                </div>
                <div id="saas-overview-totals" class="bg-gray-50 rounded-xl p-4 text-sm mt-4">
                    <p class="text-gray-600">Total base estimado: <span id="saas-overview-base">$0</span> USD</p>
                    <p class="text-gray-600 mt-1">Total extraordinarios: <span id="saas-overview-extra">$0</span> USD</p>
                    <p class="font-medium text-gray-900 mt-2">Total: <span id="saas-overview-total">$0</span> USD <span id="saas-overview-ves" class="text-gray-600 font-normal"></span></p>
                    <p class="text-xs text-gray-500 mt-2" id="saas-overview-rate-info">Cargando tasa BCV...</p>
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="closeSaaSOverviewModal()" class="px-4 py-2 border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50">Cancelar</button>
                <button type="button" id="saas-generate-btn" onclick="confirmGenerateSaaSInvoices()" disabled class="px-4 py-2 bg-[var(--md-sys-color-primary)] text-white rounded-lg hover:opacity-90 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    <span class="material-symbols-rounded text-lg">check_circle</span>
                    Generar factura
                </button>
            </div>
        </div>
    </div>

    <!-- Modal: Seleccionar Condominio (dentro del flujo de facturación) - z-index via CSS para quedar encima del modal Resumen -->
    <div id="saas-tenant-picker-modal" class="fixed inset-0 hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4" onclick="if(event.target===this)closeSaaSTenantPickerModal()">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full max-h-[80vh] flex flex-col" onclick="event.stopPropagation()">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
                <h3 class="text-lg font-medium text-gray-900">Seleccionar Condominio</h3>
                <button onclick="closeSaaSTenantPickerModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                    <span class="material-symbols-rounded text-gray-600">close</span>
                </button>
            </div>
            <div id="saas-tenant-picker-list" class="overflow-y-auto flex-1 divide-y divide-gray-100">
                <p class="p-4 text-sm text-gray-500">Cargando...</p>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Factura SaaS -->
    <div id="saas-invoice-detail-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4" onclick="if(event.target===this)closeSaaSInvoiceDetail()">
        <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full max-h-[90vh] flex flex-col" onclick="event.stopPropagation()">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="text-xl font-medium text-gray-900">Detalle de factura</h3>
                <button onclick="closeSaaSInvoiceDetail()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100">
                    <span class="material-symbols-rounded text-gray-600">close</span>
                </button>
            </div>
            <div id="saas-invoice-detail-content" class="p-6 overflow-y-auto flex-1">
                <p class="text-gray-500">Cargando...</p>
            </div>
        </div>
    </div>

    <!-- Modal Rechazar Reporte SaaS -->
    <div id="saas-reject-modal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4" onclick="if(event.target===this)closeSaaSRejectModal()">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6" onclick="event.stopPropagation()">
            <h3 class="text-lg font-medium text-gray-900 mb-2">Rechazar reporte de pago</h3>
            <p class="text-sm text-gray-500 mb-4">Indica el motivo del rechazo para que la junta pueda corregir y volver a reportar.</p>
            <textarea id="saas-reject-reason" placeholder="Ej: Referencia incorrecta, monto no coincide..." class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm mb-4" rows="3"></textarea>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeSaaSRejectModal()" class="px-4 py-2 border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50">Cancelar</button>
                <button type="button" onclick="submitSaaSReject()" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">Rechazar</button>
            </div>
        </div>
    </div>

    <!-- New Tenant Modal -->
    <div id="modal-overlay" class="md-modal-overlay" onclick="closeNewTenantModal()"></div>
    <div id="new-tenant-modal" class="md-modal">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <div>
                <h3 class="text-xl font-medium text-gray-900">Nuevo Condominio</h3>
                <p class="text-sm text-gray-500">Completa la información para crear un nuevo conjunto residencial</p>
            </div>
            <button onclick="closeNewTenantModal()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                <span class="material-symbols-rounded text-gray-600">close</span>
            </button>
