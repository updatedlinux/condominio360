        let durPage = 1;
        let durCurrentDetail = null;

        function formatDateTimeVenezuela(dateStr) {
            if (!dateStr) return '-';
            const d = new Date(dateStr);
            const v = new Date(d.getTime() + (4 * 60 * 60 * 1000));
            return v.toLocaleString('es-VE', { timeZone: 'America/Caracas' });
        }

        async function loadDataUpdateRequests() {
            const status = document.getElementById('dur-status-filter')?.value || '';
            try {
                let url = `/api/admin/data-update-requests?page=${durPage}&limit=20`;
                if (status) url += `&status=${status}`;
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (!data.success) throw new Error(data.error);
                renderDataUpdateRequests(data.data, data.pagination);
            } catch (error) {
                document.getElementById('data-update-requests-tbody').innerHTML = '<tr><td colspan="5" class="text-center py-8 text-red-500">Error al cargar</td></tr>';
            }
        }

        function renderDataUpdateRequests(rows, pagination) {
            const tbody = document.getElementById('data-update-requests-tbody');
            if (!rows || rows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-gray-500">No hay solicitudes</td></tr>';
            } else {
                tbody.innerHTML = rows.map(r => {
                    const statusClass = r.status === 'PENDING' ? 'bg-amber-100 text-amber-800' : r.status === 'APPROVED' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800';
                    const statusLabel = r.status === 'PENDING' ? 'Pendiente' : r.status === 'APPROVED' ? 'Aprobada' : 'Rechazada';
                    const dateStr = formatDateTimeVenezuela(r.requested_at);
                    return `<tr>
                        <td>${(r.first_name || '')} ${(r.last_name || '')}</td>
                        <td>${r.email || '-'}</td>
                        <td><span class="px-2 py-1 rounded text-xs font-medium ${statusClass}">${statusLabel}</span></td>
                        <td>${dateStr}</td>
                        <td>${r.status === 'PENDING' ? `<button onclick="openDurModal('${r.id}')" class="text-[var(--md-sys-color-primary)] hover:underline text-sm">Ver</button>` : `<button onclick="openDurModal('${r.id}')" class="text-gray-500 hover:underline text-sm">Ver</button>`}</td>
                    </tr>`;
                }).join('');
            }
            const pagEl = document.getElementById('dur-pagination');
            if (pagination && pagination.pages > 1) {
                pagEl.innerHTML = `<div class="text-sm text-gray-500">Página ${pagination.page} de ${pagination.pages} (${pagination.total} total)</div>
                    <div class="flex gap-2">
                        <button onclick="durPage=${pagination.page-1}; loadDataUpdateRequests();" ${pagination.page <= 1 ? 'disabled' : ''} class="px-3 py-1 border rounded text-sm disabled:opacity-50">Anterior</button>
                        <button onclick="durPage=${pagination.page+1}; loadDataUpdateRequests();" ${pagination.page >= pagination.pages ? 'disabled' : ''} class="px-3 py-1 border rounded text-sm disabled:opacity-50">Siguiente</button>
                    </div>`;
            } else {
                pagEl.innerHTML = pagination ? `<div class="text-sm text-gray-500">${pagination.total} solicitudes</div>` : '';
            }
        }

        async function openDurModal(id) {
            document.getElementById('dur-modal-overlay').classList.add('active');
            document.getElementById('dur-modal').classList.add('active');
            document.getElementById('dur-modal-loading').classList.remove('hidden');
            document.getElementById('dur-modal-content').classList.add('hidden');
            document.getElementById('dur-modal-actions').classList.add('hidden');
            const reasonEl = document.getElementById('dur-reject-reason');
            if (reasonEl) reasonEl.value = '';
            try {
                const res = await fetch(`/api/admin/data-update-requests/${id}`, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                if (!data.success) throw new Error(data.error);
                durCurrentDetail = data;
                const req = data.request;
                const oldData = req.old_data || {};
                const newData = req.new_data || {};
                document.getElementById('dur-tenants').innerHTML = (data.tenants || []).map(t => `<li>${t.name}</li>`).join('') || '<li class="text-gray-400">-</li>';
                document.getElementById('dur-properties').innerHTML = (data.properties || []).map(p => `<li>${p.tenant_name} - ${p.name || p.building_name}</li>`).join('') || '<li class="text-gray-400">-</li>';
                document.getElementById('dur-old-data').innerHTML = `
                    <div>Nombre: ${oldData.first_name || '-'}</div>
                    <div>Apellido: ${oldData.last_name || '-'}</div>
                    <div>Cédula: ${oldData.dni || '-'}</div>
                    <div>Correo: ${oldData.email || '-'}</div>
                    <div>Teléfono: ${oldData.phone || '-'}</div>
                `;
                document.getElementById('dur-new-data-form').innerHTML = `
                    <div><label class="block text-xs text-gray-500 mb-1">Nombre</label><input type="text" id="dur-edit-first_name" value="${(newData.first_name || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                    <div><label class="block text-xs text-gray-500 mb-1">Apellido</label><input type="text" id="dur-edit-last_name" value="${(newData.last_name || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                    <div><label class="block text-xs text-gray-500 mb-1">Cédula</label><input type="text" id="dur-edit-dni" value="${(newData.dni || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                    <div><label class="block text-xs text-gray-500 mb-1">Correo</label><input type="email" id="dur-edit-email" value="${(newData.email || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                    <div><label class="block text-xs text-gray-500 mb-1">Teléfono</label><input type="text" id="dur-edit-phone" value="${(newData.phone || '').replace(/"/g, '&quot;')}" class="w-full px-3 py-2 border rounded-lg text-sm"></div>
                `;
                document.getElementById('dur-requested-at').textContent = formatDateTimeVenezuela(req.requested_at);
                document.getElementById('dur-modal-loading').classList.add('hidden');
                document.getElementById('dur-modal-content').classList.remove('hidden');
                if (req.status === 'PENDING') {
                    document.getElementById('dur-modal-actions').classList.remove('hidden');
                }
            } catch (e) {
                document.getElementById('dur-modal-loading').textContent = 'Error al cargar';
            }
        }

        function closeDurModal() {
            document.getElementById('dur-modal-overlay').classList.remove('active');
            document.getElementById('dur-modal').classList.remove('active');
        }

        async function approveDurRequest() {
            if (!durCurrentDetail) return;
            const id = durCurrentDetail.request.id;
            const newData = {
                first_name: document.getElementById('dur-edit-first_name').value.trim(),
                last_name: document.getElementById('dur-edit-last_name').value.trim(),
                dni: document.getElementById('dur-edit-dni').value.trim(),
                email: document.getElementById('dur-edit-email').value.trim(),
                phone: document.getElementById('dur-edit-phone').value.trim() || null
            };
            try {
                const res = await fetch(`/api/admin/data-update-requests/${id}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify({ new_data: newData })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Error');
                showSnackbar('Solicitud aprobada. Datos actualizados.', 'success');
                closeDurModal();
                loadDataUpdateRequests();
                loadActivity();
            } catch (e) {
                showSnackbar(e.message || 'Error al aprobar', 'error');
            }
        }

        async function rejectDurRequest() {
            if (!durCurrentDetail) return;
            const reason = document.getElementById('dur-reject-reason')?.value?.trim() || null;
            const id = durCurrentDetail.request.id;
            try {
                const res = await fetch(`/api/admin/data-update-requests/${id}/reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify({ reason })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Error');
                showSnackbar('Solicitud rechazada', 'success');
                closeDurModal();
                loadDataUpdateRequests();
                loadActivity();
            } catch (e) {
                showSnackbar(e.message || 'Error al rechazar', 'error');
            }
        }

        let saasExtraItems = [];
        async function loadSaaSBilling() {
            try {
                const month = document.getElementById('saas-period-month')?.value || new Date().getMonth()+1;
                const year = document.getElementById('saas-period-year')?.value || new Date().getFullYear();
                const [tenantsRes, invoicesRes, configRes] = await Promise.all([
                    fetch(`/api/admin/saas-billing/tenants-available?period_month=${month}&period_year=${year}`, { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch('/api/admin/saas-billing/invoices', { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch('/api/admin/saas-billing/payment-config', { headers: { 'Authorization': `Bearer ${token}` } })
                ]);
                const tenantsData = (await tenantsRes.json()).data || [];
                const invoicesData = (await invoicesRes.json()).data || [];
                const configData = (await configRes.json()).data || {};

                document.getElementById('saas-payment-bank').value = configData.bank_account || '';
                document.getElementById('saas-payment-mobile').value = configData.mobile_payment || '';

                renderSaaSInvoices(invoicesData);
            } catch (e) {
                document.getElementById('saas-invoices-list').innerHTML = '<p class="text-red-500 text-sm">Error al cargar</p>';
            }
        }
        function renderSaaSInvoices(invoices) {
            const el = document.getElementById('saas-invoices-list');
            if (!invoices || invoices.length === 0) {
                el.innerHTML = '<p class="text-gray-500 text-sm">No hay facturas generadas aún.</p>';
                return;
            }
            const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
            el.innerHTML = invoices.map(inv => `
                <div class="flex items-center justify-between p-3 border border-gray-100 rounded-lg hover:bg-gray-50 cursor-pointer" onclick="openSaaSInvoiceDetail('${inv.id}')">
                    <div>
                        <span class="font-medium text-gray-900">${inv.tenant_name}</span>
                        <span class="text-gray-500 text-sm ml-2">${months[inv.period_month-1]} ${inv.period_year}</span>
                        ${inv.payment_report_pending ? '<span class="ml-2 px-2 py-0.5 rounded text-xs bg-blue-100 text-blue-800">Reporte pendiente</span>' : ''}
                    </div>
                    <div class="flex items-center gap-4" onclick="event.stopPropagation()">
                        <span class="text-gray-700">$${parseFloat(inv.total_usd).toFixed(2)} USD</span>
                        <span class="text-gray-600">Bs. ${parseFloat(inv.total_ves).toLocaleString('es-VE')}</span>
                        <span class="px-2 py-1 rounded text-xs ${inv.status === 'PENDING' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}">${inv.status}</span>
                        <button onclick="recalculateSaaSInvoice('${inv.id}')" class="text-xs text-[var(--md-sys-color-primary)] hover:underline" title="Recalcular VES (tasa BCV actual)">Recalcular</button>
                        ${inv.status === 'PENDING' ? `<button onclick="deleteSaaSInvoice('${inv.id}', '${(inv.tenant_name || '').replace(/'/g, "\\'")}')" class="text-xs text-red-600 hover:underline" title="Eliminar factura">Eliminar</button>` : ''}
                    </div>
                </div>
            `).join('');
        }
        async function generateSaaSInvoices(overrideTenantId) {
            const tenantId = overrideTenantId ?? saasOverviewSelectedTenantId;
            if (!tenantId) {
                showSnackbar('Selecciona un condominio', 'error');
                return;
            }
            const month = parseInt(document.getElementById('saas-period-month').value);
            const year = parseInt(document.getElementById('saas-period-year').value);
            const paymentMethod = document.getElementById('saas-payment-method').value?.trim() || null;
            const body = {
                period_month: month,
                period_year: year,
                payment_method: paymentMethod,
                extra_items: saasExtraItems,
                tenant_id: tenantId
            };
            try {
                const res = await fetch('/api/admin/saas-billing/invoices', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(body)
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Error');
                showSnackbar(`Generadas ${data.created} factura(s)`, 'success');
                if (data.skipped > 0) showSnackbar(`${data.skipped} condominio(s) ya facturados`, 'info');
                loadSaaSBilling();
            } catch (e) {
                showSnackbar(e.message || 'Error al generar facturas', 'error');
            }
        }
        async function recalculateSaaSInvoice(id) {
            try {
                const res = await fetch(`/api/admin/saas-billing/invoices/${id}/recalculate`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    showSnackbar('Factura recalculada con tasa BCV actual', 'success');
                    loadSaaSBilling();
                } else {
                    const d = await res.json();
                    throw new Error(d.error);
                }
            } catch (e) {
                showSnackbar(e.message || 'Error al recalcular', 'error');
            }
        }
        let chartUsd = null, chartEur = null, chartComparative = null;
        async function loadBalanceFinanciero() {
            try {
                const [ratesRes, summaryRes] = await Promise.all([
                    fetch('/api/admin/balance/exchange-rates?days=30', { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch('/api/admin/balance/financial-summary', { headers: { 'Authorization': `Bearer ${token}` } })
                ]);
                const ratesData = (await ratesRes.json()).data;
                const summaryData = (await summaryRes.json()).data;
                if (!ratesData || !summaryData) throw new Error('Error al cargar datos');

                const rates = ratesData.rates || [];
                const fmtDate = (d) => {
                    if (!d) return '';
                    const s = (d.split && d.split('T')[0]) || (d.toISOString && d.toISOString().split('T')[0]);
                    if (!s) return '';
                    const [y, m, day] = s.split('-');
                    return `${parseInt(day)}/${parseInt(m)}`;
                };
                const labels = rates.map(r => fmtDate(r.date));
                const usdData = rates.map(r => r.usd);
                const eurData = rates.map(r => r.eur);

                if (chartUsd) chartUsd.destroy();
                if (chartEur) chartEur.destroy();
                Chart.defaults.color = '#6b7280';
                Chart.defaults.borderColor = '#e5e7eb';
                const chartOpts = { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } };
                chartUsd = new Chart(document.getElementById('chart-usd'), {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [{ data: usdData, borderColor: '#f97316', backgroundColor: 'rgba(249,115,22,0.1)', fill: true, tension: 0.3 }]
                    },
                    options: { ...chartOpts, scales: { y: { beginAtZero: false } } }
                });
                chartEur = new Chart(document.getElementById('chart-eur'), {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [{ data: eurData, borderColor: '#50606e', backgroundColor: 'rgba(80,96,110,0.1)', fill: true, tension: 0.3 }]
                    },
                    options: { ...chartOpts, scales: { y: { beginAtZero: false } } }
                });

                const latest = ratesData.latest;
                document.getElementById('balance-rate-info').textContent = latest
                    ? `Última tasa: ${latest.usd?.toLocaleString('es-VE')} VES/USD (${latest.eur?.toLocaleString('es-VE')} EUR) — ${fmtDate(latest.date)}`
                    : 'Sin tasa BCV registrada';

                const byTenant = summaryData.by_tenant || [];
                const fmtVes = (v) => v != null ? `Bs. ${Number(v).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : '-';
                document.getElementById('balance-tenant-table').innerHTML = byTenant.length === 0
                    ? '<tr><td colspan="5" class="text-center text-gray-500 py-4">No hay datos</td></tr>'
                    : byTenant.map(t => `
                        <tr>
                            <td class="font-medium">${t.tenant_name || '-'}</td>
                            <td>${t.properties || 0}</td>
                            <td>${fmtVes(t.condo_collected_ves)}</td>
                            <td>${fmtVes(t.saas_paid_ves)}</td>
                            <td>${fmtVes(t.saas_pending_ves)}</td>
                        </tr>
                    `).join('');

                const totals = summaryData.totals || {};
                document.getElementById('balance-total-condo').textContent = fmtVes(totals.condo_collected);
                document.getElementById('balance-saas-pending').textContent = fmtVes(totals.saas_pending_ves) + ' (' + (totals.saas_pending_usd?.toFixed(2) || '0') + ' USD)';

                const comp = summaryData.comparative || [];
                document.getElementById('balance-comparative-list').innerHTML = comp.map(c => `
                    <div class="flex justify-between py-1 border-b border-gray-100 last:border-0">
                        <span>${c.label}</span>
                        <span class="text-gray-600">SaaS: ${fmtVes(c.saas_paid_ves)} | Condo: ${fmtVes(c.condo_collected_ves)}</span>
                    </div>
                `).join('') || '<p class="text-gray-500 text-sm">Sin datos de meses anteriores</p>';

                if (chartComparative) chartComparative.destroy();
                chartComparative = new Chart(document.getElementById('chart-comparative'), {
                    type: 'bar',
                    data: {
                        labels: comp.map(c => c.label),
                        datasets: [
                            { label: 'SaaS (VES)', data: comp.map(c => c.saas_paid_ves), backgroundColor: 'rgba(249,115,22,0.7)' },
                            { label: 'Condo (VES)', data: comp.map(c => c.condo_collected_ves), backgroundColor: 'rgba(80,96,110,0.7)' }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
                });

                const proj = summaryData.projection || [];
                const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
                document.getElementById('balance-projection-list').innerHTML = proj.map(p => `
                    <div class="flex justify-between items-center py-2 px-3 bg-gray-50 rounded-lg">
                        <span class="font-medium">${months[p.month-1]} ${p.year}</span>
                        <span class="text-gray-600">${p.properties} und. × $0.50 = $${p.total_usd?.toFixed(2)} USD</span>
                        <span class="font-medium">${fmtVes(p.total_ves)}</span>
                    </div>
                `).join('') || '<p class="text-gray-500 text-sm">Sin proyección</p>';
            } catch (e) {
                console.error('Error loadBalanceFinanciero:', e);
                showSnackbar('Error al cargar Balance Financiero', 'error');
            }
        }

        let saasOverviewSelectedTenantId = null;
        let saasOverviewTenantsList = [];

