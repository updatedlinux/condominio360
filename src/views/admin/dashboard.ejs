        async function loadBalanceFinanciero() {
            try {
                const [ratesRes, summaryRes] = await Promise.all([
                    fetch('/api/admin/balance/exchange-rates?days=30', { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch('/api/admin/balance/financial-summary', { headers: { 'Authorization': `Bearer ${token}` } })
                ]);
                const ratesData = (await ratesRes.json()).data;
                const summaryData = (await summaryRes.json()).data;
                if (!ratesData || !summaryData) throw new Error('Error al cargar datos');

                const rates = ratesData.rates || [];
                const fmtDate = (d) => {
                    if (!d) return '';
                    const s = (d.split && d.split('T')[0]) || (d.toISOString && d.toISOString().split('T')[0]);
                    if (!s) return '';
                    const [y, m, day] = s.split('-');
                    return `${parseInt(day)}/${parseInt(m)}`;
                };
                const labels = rates.map(r => fmtDate(r.date));
                const usdData = rates.map(r => r.usd);
                const eurData = rates.map(r => r.eur);

                if (chartUsd) chartUsd.destroy();
                if (chartEur) chartEur.destroy();
                Chart.defaults.color = '#6b7280';
                Chart.defaults.borderColor = '#e5e7eb';
                const chartOpts = { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } };
                chartUsd = new Chart(document.getElementById('chart-usd'), {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [{ data: usdData, borderColor: '#f97316', backgroundColor: 'rgba(249,115,22,0.1)', fill: true, tension: 0.3 }]
                    },
                    options: { ...chartOpts, scales: { y: { beginAtZero: false } } }
                });
                chartEur = new Chart(document.getElementById('chart-eur'), {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [{ data: eurData, borderColor: '#50606e', backgroundColor: 'rgba(80,96,110,0.1)', fill: true, tension: 0.3 }]
                    },
                    options: { ...chartOpts, scales: { y: { beginAtZero: false } } }
                });

                const latest = ratesData.latest;
                document.getElementById('balance-rate-info').textContent = latest
                    ? `Última tasa: ${latest.usd?.toLocaleString('es-VE')} VES/USD (${latest.eur?.toLocaleString('es-VE')} EUR) — ${fmtDate(latest.date)}`
                    : 'Sin tasa BCV registrada';

                const byTenant = summaryData.by_tenant || [];
                const fmtVes = (v) => v != null ? `Bs. ${Number(v).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : '-';
                const fmtUsd = (v) => v != null ? `$${Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : '-';
                const fmtSpread = (v) => {
                    if (v == null || Number.isNaN(v)) return '-';
                    const n = Number(v);
                    const cls = n > 0.005 ? 'text-red-600' : (n < -0.005 ? 'text-emerald-600' : 'text-gray-600');
                    const sign = n > 0 ? '+' : '';
                    return `<span class="${cls} font-medium">${sign}${fmtUsd(n)}</span>`;
                };
                const fmtRate = (v) => v != null && v > 0 ? Number(v).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 4 }) : '-';
                const fmtDateYmd = (d) => {
                    if (!d) return '-';
                    const s = String(d).split('T')[0];
                    const [y, m, day] = s.split('-');
                    return `${parseInt(day, 10)}/${parseInt(m, 10)}/${y}`;
                };
                const monthShort = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

                if (summaryData.freeze_policy?.description) {
                    document.getElementById('balance-fx-policy').textContent = summaryData.freeze_policy.description;
                }

                const totals = summaryData.totals || {};
                document.getElementById('balance-total-usd').textContent = fmtUsd(totals.invoiced_usd);
                document.getElementById('balance-total-ves').textContent = fmtVes(totals.paid_ves);
                document.getElementById('balance-total-usd-equiv').textContent = fmtUsd(totals.paid_usd_equivalent);
                document.getElementById('balance-total-spread').innerHTML = fmtSpread(totals.spread_usd);
                document.getElementById('balance-freeze-spread').innerHTML = fmtSpread(totals.spread_in_freeze_window_usd);
                document.getElementById('balance-saas-pending').textContent =
                    fmtVes(totals.pending_ves) + ' · ' + fmtUsd(totals.pending_usd);

                document.getElementById('balance-tenant-table').innerHTML = byTenant.length === 0
                    ? '<tr><td colspan="8" class="text-center text-gray-500 py-4">No hay datos</td></tr>'
                    : byTenant.map(t => `
                        <tr>
                            <td class="font-medium">${t.tenant_name || '-'}</td>
                            <td>${t.properties || 0}</td>
                            <td>${fmtUsd(t.invoiced_usd)}</td>
                            <td>${fmtVes(t.paid_ves)}</td>
                            <td>${fmtUsd(t.paid_usd_equivalent)}</td>
                            <td>${fmtSpread(t.spread_usd)}</td>
                            <td>${fmtSpread(t.spread_in_freeze_window_usd)}</td>
                            <td>${t.pending_usd > 0 ? fmtUsd(t.pending_usd) + '<br><span class="text-xs text-gray-500">' + fmtVes(t.pending_ves) + '</span>' : '-'}</td>
                        </tr>
                    `).join('');

                const paidInvoices = summaryData.paid_invoices || [];
                document.getElementById('balance-paid-invoices-table').innerHTML = paidInvoices.length === 0
                    ? '<tr><td colspan="9" class="text-center text-gray-500 py-4">Sin pagos confirmados</td></tr>'
                    : paidInvoices.map(inv => {
                        const period = `${monthShort[(inv.period_month || 1) - 1]} ${inv.period_year}`;
                        const freezeBadge = inv.freeze_spread_window
                            ? ' <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800">1-5</span>' : '';
                        const transferHint = inv.transfer_date_warning && inv.transfer_date_raw
                            ? `<br><span class="text-[10px] text-amber-700" title="Fecha del comprobante (${inv.transfer_date_raw}) anterior a la factura; se usa fecha de confirmación">Comp.: ${fmtDateYmd(inv.transfer_date)}</span>`
                            : '';
                        return `
                        <tr>
                            <td>${period}</td>
                            <td class="font-medium">${inv.tenant_name || '-'}</td>
                            <td>${fmtUsd(inv.invoiced_usd)}</td>
                            <td>${fmtVes(inv.paid_ves)}</td>
                            <td class="text-xs">${fmtRate(inv.invoice_rate)}<br><span class="text-gray-400">${fmtDateYmd(inv.invoice_rate_date)}</span></td>
                            <td>${fmtDateYmd(inv.payment_date)}${freezeBadge}${transferHint}</td>
                            <td class="text-xs">${fmtRate(inv.payment_rate)}<br><span class="text-gray-400">${fmtDateYmd(inv.payment_rate_date)}</span></td>
                            <td>${fmtUsd(inv.paid_usd_equivalent)}</td>
                            <td>${fmtSpread(inv.spread_usd)}</td>
                        </tr>`;
                    }).join('');

                const comp = summaryData.comparative || [];
                document.getElementById('balance-comparative-list').innerHTML = comp.map(c => `
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 last:border-0 gap-1">
                        <span class="font-medium">${c.label}</span>
                        <span class="text-gray-600 text-xs sm:text-sm">
                            ${fmtUsd(c.saas_paid_usd)} fact. · ${fmtVes(c.saas_paid_ves)} cobr. · USD cobro ${fmtUsd(c.saas_paid_usd_equivalent)} · Spread ${fmtSpread(c.saas_spread_usd)}
                        </span>
                    </div>
                `).join('') || '<p class="text-gray-500 text-sm">Sin datos de meses anteriores</p>';

                if (chartComparative) chartComparative.destroy();
                chartComparative = new Chart(document.getElementById('chart-comparative'), {
                    type: 'bar',
                    data: {
                        labels: comp.map(c => c.label),
                        datasets: [
                            { label: 'USD facturado', data: comp.map(c => c.saas_paid_usd), backgroundColor: 'rgba(249,115,22,0.7)' },
                            { label: 'USD al cobro', data: comp.map(c => c.saas_paid_usd_equivalent), backgroundColor: 'rgba(34,197,94,0.6)' },
                            { label: 'Spread USD', data: comp.map(c => c.saas_spread_usd), backgroundColor: 'rgba(239,68,68,0.55)' }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
                });

                const proj = summaryData.projection || [];
                const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
                document.getElementById('balance-projection-list').innerHTML = proj.map(p => `
                    <div class="flex justify-between items-center py-2 px-3 bg-gray-50 rounded-lg">
                        <span class="font-medium">${months[p.month-1]} ${p.year}</span>
                        <span class="text-gray-600">${p.properties} und. × $0.50 = $${p.total_usd?.toFixed(2)} USD</span>
                        <span class="font-medium">${fmtVes(p.total_ves)}</span>
                    </div>
                `).join('') || '<p class="text-gray-500 text-sm">Sin proyección</p>';
            } catch (e) {
                console.error('Error loadBalanceFinanciero:', e);
                showSnackbar('Error al cargar Balance Financiero', 'error');
            }
        }

        let saasOverviewSelectedTenantId = null;
