            const month = parseInt(document.getElementById('saas-period-month').value);
            const year = parseInt(document.getElementById('saas-period-year').value);
            try {
                const [tenantsRes, rateRes] = await Promise.all([
                    fetch(`/api/admin/saas-billing/tenants-available?period_month=${month}&period_year=${year}`, { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch('/api/admin/saas-billing/rate', { headers: { 'Authorization': `Bearer ${token}` } })
                ]);
                const { data: tenants } = await tenantsRes.json();
                const rateData = (await rateRes.json()).data || {};
                saasOverviewRate = parseFloat(rateData.usd_to_ves) || 0;
                saasOverviewRateDate = rateData.rate_date;
                saasOverviewTenantsList = tenants || [];
                const rateDateStr = rateData.rate_date ? (() => {
                    const d = rateData.rate_date;
                    const [y, m, d2] = (d.split?.('T')[0] || d).split('-');
                    return new Date(parseInt(y), parseInt(m) - 1, parseInt(d2)).toLocaleDateString('es-VE', { year: 'numeric', month: 'long', day: 'numeric' });
                })() : '';
                document.getElementById('saas-overview-rate-info').textContent = rateDateStr ? `Tasa BCV aplicable (${rateDateStr}): días 1-5 del mes usa tasa del 1ro; día 6+ usa tasa diaria` : 'Tasa BCV se aplicará al generar (días 1-5: tasa del 1ro; día 6+: tasa diaria)';
                const eligibles = (tenants || []).filter(t => saasTenantEligible(t));
                const allTenants = tenants || [];
                document.getElementById('saas-tenant-selector-trigger').disabled = allTenants.length === 0;
                if (allTenants.length === 0) {
                    document.getElementById('saas-tenant-selector-text').textContent = 'No hay condominios activos';
                } else if (eligibles.length === 0) {
                    document.getElementById('saas-tenant-selector-text').textContent = 'Todos ya tienen factura este período — haz clic para ver la lista';
                }
                renderSaaSOverviewExtras();
                toggleSaaSFiscalFields();
                updateSaaSOverviewTotals([]);
            } catch (e) {
                document.getElementById('saas-tenant-selector-text').textContent = 'Error al cargar';
                document.getElementById('saas-tenant-selector-trigger').disabled = true;
            }
