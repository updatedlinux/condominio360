        async function deleteSaaSInvoice(id, name) {
            openConfirmModal('Eliminar factura', '¿Eliminar la factura de ' + name + '? Solo se permite eliminar facturas pendientes.', async () => {
                try {
                    const res = await fetch(`/api/admin/saas-billing/invoices/${id}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const json = await res.json();
                    if (res.ok) {
                        loadSaaSBilling();
                        showSnackbar('Factura eliminada', 'success');
                    } else {
                        showSnackbar(json.error || 'Error al eliminar', 'error');
                    }
                } catch (e) {
                    showSnackbar('Error de conexión', 'error');
                }
            });
        }
        async function saveSaaSPaymentConfig() {
            try {
                const res = await fetch('/api/admin/saas-billing/payment-config', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify({
                        bank_account: document.getElementById('saas-payment-bank').value?.trim() || '',
                        mobile_payment: document.getElementById('saas-payment-mobile').value?.trim() || ''
                    })
                });
                const json = await res.json();
                if (res.ok) {
                    showSnackbar('Método de pago guardado', 'success');
                } else {
                    showSnackbar(json.error || 'Error al guardar', 'error');
                }
            } catch (e) {
                showSnackbar('Error de conexión', 'error');
            }
        }
