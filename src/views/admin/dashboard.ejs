            const contentEl = document.getElementById('owner-search-result-content');
            resultEl.classList.remove('hidden');
            contentEl.innerHTML = '<p class="text-gray-500">Buscando...</p>';
            try {
                const params = new URLSearchParams();
                if (dni) params.set('dni', dni);
                if (email) params.set('email', email);
                const res = await fetch('/api/admin/owners/search?' + params.toString(), {
                    headers: { 'Authorization': `Bearer ${token}` }
