                })() : '';
                document.getElementById('saas-overview-rate-info').textContent = rateDateStr ? `Tasa BCV aplicable (${rateDateStr}): días 1-5 del mes usa tasa del 1ro; día 6+ usa tasa diaria` : 'Tasa BCV se aplicará al generar (días 1-5: tasa del 1ro; día 6+: tasa diaria)';
