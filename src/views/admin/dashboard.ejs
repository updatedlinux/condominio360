                document.getElementById('saas-tenant-selector-trigger').disabled = eligibles.length === 0;
                if (eligibles.length === 0) {
                    document.getElementById('saas-tenant-selector-text').textContent = 'No hay condominios elegibles (todos ya facturados)';
                }
                renderSaaSOverviewExtras();
                updateSaaSOverviewTotals([]);
            } catch (e) {
                document.getElementById('saas-tenant-selector-text').textContent = 'Error al cargar';
                document.getElementById('saas-tenant-selector-trigger').disabled = true;
            }
        }

        function openSaaSTenantPickerModal() {
            if (document.getElementById('saas-tenant-selector-trigger').disabled) return;
            const eligibles = saasOverviewTenantsList.filter(t => t.has_invoice === 0);
            const listEl = document.getElementById('saas-tenant-picker-list');
            if (eligibles.length === 0) {
                listEl.innerHTML = '<p class="p-4 text-sm text-amber-600">No hay condominios elegibles para este período.</p>';
