<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seleccionar Propiedad | Condominio360</title>
    <link href="/css/output.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
        .property-card {
            transition: all 0.2s ease;
        }
        .property-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
        }
        .property-card:active {
            transform: translateY(0);
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto w-full flex-1">
        <div class="text-center mb-8">
            <a href="/" class="inline-flex items-center gap-2">
                <img src="/assets/images/isotipo-naranja.svg" alt="" class="h-12 w-12" style="object-fit: contain;">
                <span class="text-xl text-slate-900 font-extrabold tracking-tight">Condominio360</span>
            </a>
            <h1 class="mt-6 text-2xl sm:text-3xl font-bold text-slate-900">
                Selecciona tu Propiedad
            </h1>
            <p class="mt-2 text-slate-600 text-sm sm:text-base">
                Elige la unidad a la que quieres acceder
            </p>
        </div>

        <div id="propertyList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            <div id="loadingState" class="col-span-full text-center py-12">
                <div class="inline-block animate-spin rounded-full h-10 w-10 border-2 border-orange-500 border-t-transparent"></div>
                <p class="mt-3 text-slate-600">Cargando propiedades...</p>
            </div>
        </div>

        <div class="mt-8 text-center">
            <button onclick="logout()" class="text-sm text-slate-500 hover:text-slate-700 hover:underline transition">
                Cerrar sesión
            </button>
        </div>
    </div>

    <%- include('../partials/page-notifications') %>
    <script src="/js/page-notifications.js"></script>
    <script src="/js/auth.js"></script>
    <script>
        function logout() {
            localStorage.clear();
            window.location.href = '/login';
        }
        document.addEventListener('DOMContentLoaded', loadPropertiesForSelection);
    </script>
</body>
</html>
