<% if (typeof recaptchaSiteKey !== 'undefined' && recaptchaSiteKey) { %>
<script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>"></script>
<% } %>
<div class="min-h-[80vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white p-10 rounded-2xl shadow-xl border border-slate-100">
            <div class="flex flex-col items-center">
                <a href="/" class="flex items-center gap-2 mb-6">
                    <img src="/assets/images/isotipo-naranja.svg" alt="" class="h-12 w-12" style="object-fit: contain;">
                    <span class="text-xl text-slate-900 tracking-tight" style="font-weight: 800;">Condominio360</span>
                </a>
                <h2 class="text-2xl font-extrabold text-slate-900">
                    Iniciar Sesión
                </h2>
                <p class="mt-1 text-sm text-slate-600">
                    Accede a tu condominio
                </p>
                <div class="mt-5 flex justify-center gap-2">
                    <button type="button" onclick="setLoginType('')" id="btn-type-default" 
                        class="login-type-btn px-4 py-2 text-sm rounded-full font-medium transition bg-orange-500 text-white">Propietario - Junta</button>
                    <button type="button" onclick="setLoginType('SECURITY')" id="btn-type-security" 
                        class="login-type-btn px-4 py-2 text-sm rounded-full font-medium transition bg-slate-100 text-slate-600">Vigilancia</button>
                </div>
                <input type="hidden" id="loginType" value="">
            </div>
            <form id="loginForm" class="mt-8 space-y-6" action="#" method="POST">
                <input type="hidden" name="remember" value="true">
                <div class="space-y-4">
                    <div>
                        <label for="identifier" class="sr-only">DNI o Correo Electrónico</label>
                        <input id="identifier" name="identifier" type="text" autocomplete="username" required
                            class="block w-full px-4 py-3 border border-slate-200 rounded-xl placeholder-slate-400 text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition"
                            placeholder="DNI o Correo Electrónico">
                    </div>
                    <div>
                        <label for="password" class="sr-only">Contraseña</label>
                        <input id="password" name="password" type="password" autocomplete="current-password" required
                            class="block w-full px-4 py-3 border border-slate-200 rounded-xl placeholder-slate-400 text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition"
                            placeholder="Contraseña">
                    </div>
                </div>

                <div>
                    <button type="submit" id="loginSubmitBtn"
                        class="group relative w-full flex justify-center py-3 px-4 text-sm font-semibold rounded-xl text-white bg-orange-500 hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 transition shadow-lg shadow-orange-500/25 disabled:opacity-70 disabled:cursor-not-allowed">
                        <span class="absolute left-0 inset-y-0 flex items-center pl-4">
                            <svg class="h-5 w-5 text-orange-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                            </svg>
                        </span>
                        Ingresar
                    </button>
                </div>

                <div id="errorMessage" class="hidden text-red-600 text-sm text-center py-3 bg-red-50 px-4 rounded-xl"></div>
            </form>
        </div>
        <p class="mt-6 text-center">
            <a href="/" class="text-slate-600 hover:text-orange-600 font-medium text-sm transition">← Volver al inicio</a>
        </p>
    </div>
</div>

<script>window.RECAPTCHA_SITE_KEY = '<%= typeof recaptchaSiteKey !== "undefined" ? (recaptchaSiteKey || "") : "" %>';</script>
<script src="/js/auth.js"></script>